function openModal(id){
var d=modalData[id];if(!d)return;
document.getElementById('modalTitle').textContent=d.title;
document.getElementById('modalSub').textContent=d.sub;
var h='';
if(d.images&&d.images.length>0){
h+='<div class="modal-gallery">';
for(var i=0;i<d.images.length;i++){
h+='<img src="'+d.images[i]+'" alt="'+d.title+'" loading="lazy" onclick="openLightbox(this.src)">';
}
h+='</div>';
}
if(d.videos&&d.videos.length>0){
for(var j=0;j<d.videos.length;j++){
h+='<div class="modal-video-label">▶ '+d.videos[j].title+'</div>';
h+='<div class="modal-video"><iframe src="'+d.videos[j].url+'" scrolling="no" frameborder="0" allowfullscreen="true" allow="autoplay; encrypted-media"></iframe></div>';
}
}
// Action buttons (nav/phone/book)
var acts=[];
if(d.nav) acts.push('<a class="m-btn nav" href="https://uri.amap.com/search?keyword='+encodeURIComponent(d.nav)+'" target="_blank">🗺️ 高德地图搜索</a>');
if(d.nav) acts.push('<a class="m-btn nav" href="https://uri.amap.com/navigation?to='+encodeURIComponent(d.nav)+'&mode=car" target="_blank">🧭 导航到这里</a>');
if(d.phone) acts.push('<a class="m-btn call" href="tel:'+d.phone+'">📞 '+d.phone+'</a>');
if(d.book) acts.push('<a class="m-btn '+(d.book_label?'site':'book')+'" href="'+d.book+'" target="_blank">'+(d.book_label?'🔗 '+d.book_label:'🎫 预订')+'</a>');
if(acts.length>0) h+='<div class="modal-actions">'+acts.join('')+'</div>';
h+='<div class="modal-meta">'+d.tags.join('')+'</div>';
h+='<div class="modal-section"><h4>简介</h4><div class="modal-text">'+d.intro+'</div></div>';
h+='<div class="modal-section"><h4>详情</h4><div class="modal-text">'+d.detail+'</div></div>';
if(d.kids) h+='<div class="modal-section"><h4>🧒 小孩怎么玩</h4><div class="modal-text">'+d.kids+'</div></div>';
if(d.water) h+='<div class="mtip blue">'+d.water+'</div>';
if(d.photo) h+='<div class="mtip gold">'+d.photo+'</div>';
if(d.note) h+=d.note;
if(d.food) h+='<div class="modal-section" style="margin-top:1rem"><h4>🍜 美食推荐</h4>'+d.food+'</div>';
document.getElementById('modalBody').innerHTML=h;
document.getElementById('modalOverlay').classList.add('show');
document.getElementById('modalSheet').classList.add('show');
document.body.style.overflow='hidden';
}
function openLightbox(src){
document.getElementById('lightboxImg').src=src;
document.getElementById('lightbox').classList.add('show');
}
function closeLightbox(){
document.getElementById('lightbox').classList.remove('show');
document.getElementById('lightboxImg').src='';
}
function closeModal(){
document.getElementById('modalOverlay').classList.remove('show');
document.getElementById('modalSheet').classList.remove('show');
document.body.style.overflow='';
}

/* ===== Scroll fade ===== */
var fEls=document.querySelectorAll('.fade-in');
function cF(){for(var i=0;i<fEls.length;i++){var r=fEls[i].getBoundingClientRect();if(r.top<window.innerHeight-40)fEls[i].className=fEls[i].className.replace('fade-in','fade-in visible');}}
window.addEventListener('scroll',cF);cF();

/* ===== Auto open D3 ===== */
setTimeout(function(){toggleCard('d3');},600);
</script>
</body>
</html>