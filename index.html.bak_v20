        <div class="spec-value">6000m</div>
      </div>
    </div>

    <!-- V6→V7: 双机飞行规划表（Mini 4 Pro + Air 3S） -->
    <div style="margin-top:32px;">
      <h3 style="text-align:center;font-size:var(--fs-lg);margin-bottom:16px;color:var(--primary);text-shadow:0 1px 4px rgba(0,0,0,0.6);">🚁 双机飞行规划表（Mini 4 Pro + Air 3S）</h3>
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:var(--fs-sm);min-width:800px;background:var(--bg-card);border-radius:12px;overflow:hidden;">
          <thead>
            <tr style="background:rgba(0,212,170,0.12);">
              <th style="padding:12px 10px;text-align:left;border-bottom:2px solid var(--border);color:var(--primary);font-weight:700;text-shadow:0 1px 3px rgba(0,0,0,0.5);">日期</th>
              <th style="padding:12px 10px;text-align:left;border-bottom:2px solid var(--border);color:var(--primary);font-weight:700;text-shadow:0 1px 3px rgba(0,0,0,0.5);">地点</th>
              <th style="padding:12px 10px;text-align:left;border-bottom:2px solid var(--border);color:var(--primary);font-weight:700;text-shadow:0 1px 3px rgba(0,0,0,0.5);">Mini 4 Pro (A机·轻便)</th>
              <th style="padding:12px 10px;text-align:left;border-bottom:2px solid var(--border);color:var(--primary);font-weight:700;text-shadow:0 1px 3px rgba(0,0,0,0.5);">Air 3S (B机·画质)</th>
              <th style="padding:12px 10px;text-align:left;border-bottom:2px solid var(--border);color:var(--primary);font-weight:700;text-shadow:0 1px 3px rgba(0,0,0,0.5);">协同策略</th>
              <th style="padding:12px 10px;text-align:left;border-bottom:2px solid var(--border);color:var(--primary);font-weight:700;text-shadow:0 1px 3px rgba(0,0,0,0.5);">注意事项</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
              <td style="padding:10px;color:var(--primary);font-weight:700;">D1 8.8</td>
              <td style="padding:10px;color:var(--text-sub);">贵阳甲秀楼</td>
              <td style="padding:10px;color:var(--text-sub);">夜景灯光环绕（19:30后）</td>
              <td style="padding:10px;color:var(--text-sub);">70mm长焦压缩城市天际线</td>
              <td style="padding:10px;color:var(--text-sub);">A机环绕拍摄→B机长焦特写</td>
              <td style="padding:10px;color:#ffaa00;font-size:var(--fs-xs);">城区限高120m</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.05);background:rgba(255,255,255,0.02);">
              <td style="padding:10px;color:var(--primary);font-weight:700;">D2 8.9</td>
              <td style="padding:10px;color:var(--text-sub);">花溪湿地</td>
              <td style="padding:10px;color:var(--text-sub);">湿地全景俯瞰</td>
              <td style="padding:10px;color:var(--text-sub);">70mm长焦拍鸟类特写</td>
              <td style="padding:10px;color:var(--text-sub);">A机高空全景→B机低空细节</td>
              <td style="padding:10px;color:#ffaa00;font-size:var(--fs-xs);">注意鸟类保护</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
              <td style="padding:10px;color:var(--primary);font-weight:700;">D3 8.10</td>
              <td style="padding:10px;color:var(--text-sub);">黄果树</td>
              <td style="padding:10px;color:var(--accent);">⚠️ 景区禁飞</td>
              <td style="padding:10px;color:var(--accent);">⚠️ 景区禁飞</td>
              <td style="padding:10px;color:var(--text-sub);">仅可在景区外远处拍摄</td>
              <td style="padding:10px;color:var(--accent);font-size:var(--fs-xs);">外围用Air 3S长焦远距离取景</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.05);background:rgba(255,255,255,0.02);">
              <td style="padding:10px;color:var(--primary);font-weight:700;">D4 8.11</td>
              <td style="padding:10px;color:var(--text-sub);">织金洞</td>
              <td style="padding:10px;color:var(--text-sub);">洞口外观广角</td>
              <td style="padding:10px;color:var(--text-sub);">洞口外观长焦+毕节田野</td>
              <td style="padding:10px;color:var(--text-sub);">洞内绝对禁飞！</td>
              <td style="padding:10px;color:var(--accent);font-size:var(--fs-xs);">A机拍洞口全景，B机拍毕节风光</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
              <td style="padding:10px;color:var(--primary);font-weight:700;">D5 8.12</td>
              <td style="padding:10px;color:var(--text-sub);">六盘水</td>
              <td style="padding:10px;color:var(--text-sub);">梅花山索道跟随拍摄</td>
              <td style="padding:10px;color:var(--text-sub);">70mm长焦拍索道+喀斯特峰林</td>
              <td style="padding:10px;color:var(--text-sub);">A机跟随索道→B机远景构图</td>
              <td style="padding:10px;color:#ffaa00;font-size:var(--fs-xs);">注意风大</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.05);background:rgba(0,212,170,0.06);">
              <td style="padding:10px;color:var(--primary);font-weight:700;">D6 8.13 ★</td>
              <td style="padding:10px;color:var(--text-sub);">乌蒙草原</td>
              <td style="padding:10px;color:var(--primary);">草原全景+风车群环绕</td>
              <td style="padding:10px;color:var(--primary);">云海平流雾+70mm风车特写</td>
              <td style="padding:10px;color:var(--primary);">✅双机协同！A机环绕→B机特写→编队飞行</td>
              <td style="padding:10px;color:var(--primary);font-size:var(--fs-xs);font-weight:600;">✅重点航拍日！两机全开</td>
            </tr>
            <tr style="background:rgba(0,212,170,0.06);">
              <td style="padding:10px;color:var(--primary);font-weight:700;">D7 8.14 ★</td>
              <td style="padding:10px;color:var(--text-sub);">万峰林</td>
              <td style="padding:10px;color:var(--primary);">八卦田正俯拍</td>
              <td style="padding:10px;color:var(--primary);">70mm峰林层次+稻田压缩透视</td>
              <td style="padding:10px;color:var(--primary);">✅双机协同！A机正顶拍→B机侧角长焦</td>
              <td style="padding:10px;color:var(--primary);font-size:var(--fs-xs);font-weight:600;">✅可飞，两机全开</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p style="text-align:center;margin-top:12px;font-size:var(--fs-xs);color:var(--text-dim);text-shadow:0 1px 3px rgba(0,0,0,0.5);">★ D6乌蒙草原 & D7万峰林为重点航拍日，Mini 4 Pro + Air 3S 双机全开</p>
    </div>
    <div style="margin-top:24px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;">
      <h3 style="text-align:center;font-size:var(--fs-lg);margin-bottom:16px;color:var(--accent);text-shadow:0 1px 4px rgba(0,0,0,0.6);">🎯 双机选用策略</h3>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;">
        <div style="background:rgba(0,212,170,0.05);border:1px solid var(--border);border-radius:10px;padding:14px;">
          <div style="font-size:var(--fs-base);font-weight:700;color:var(--primary);margin-bottom:8px;">📦 Mini 4 Pro 优先</div>
          <ul style="list-style:none;font-size:var(--fs-sm);color:var(--text-sub);line-height:1.8;">
            <li>• 249g免登记，随拿随飞</li>
            <li>• 城区/景区等限重场景</li>
            <li>• 需要快速起飞的抓拍</li>
            <li>• 竖拍模式（社交媒体）</li>
            <li>• 跟随移动主体（索道/骑行）</li>
          </ul>
        </div>
        <div style="background:rgba(255,107,53,0.05);border:1px solid var(--border);border-radius:10px;padding:14px;">
          <div style="font-size:var(--fs-base);font-weight:700;color:var(--accent);margin-bottom:8px;">📸 Air 3S 优先</div>
          <ul style="list-style:none;font-size:var(--fs-sm);color:var(--text-sub);line-height:1.8;">
            <li>• 1英寸大底，暗光画质优先</li>
            <li>• 需要70mm长焦压缩透视</li>
            <li>• 高海拔大风环境（抗风强）</li>
            <li>• 夜景/日出日落大光比</li>
            <li>• 远距离取景（避免打扰主体）</li>
          </ul>
        </div>
        <div style="background:rgba(240,192,64,0.05);border:1px solid var(--border);border-radius:10px;padding:14px;">
          <div style="font-size:var(--fs-base);font-weight:700;color:var(--gold);margin-bottom:8px;">🤝 双机协同</div>
          <ul style="list-style:none;font-size:var(--fs-sm);color:var(--text-sub);line-height:1.8;">
            <li>• D6乌蒙草原：一机环绕一机特写</li>
            <li>• D7万峰林：一机俯拍一机侧角</li>
            <li>• 任何大场景：广角+长焦同时覆盖</li>
            <li>• 延时+常规拍摄同时进行</li>
            <li>• 互为备份，确保不出废片</li>
          </ul>
        </div>
      </div>
      <p style="text-align:center;margin-top:14px;font-size:var(--fs-xs);color:var(--text-dim);text-shadow:0 1px 3px rgba(0,0,0,0.5);">💡 建议：A机(Mini 4 Pro)负责灵活机动的常规拍摄，B机(Air 3S)负责高画质和长焦特写。开阔大场景双机协同效率最高。</p>
    </div>
  </div>
</section>

