<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
<title>黔山秘境 · 贵州避暑自驾之旅 7天6晚 V20</title>
<style>

/* ========== 全局重置与变量 ========== */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --bg-dark: #0a0e27;
  --bg-dark-2: #0f1535;
  --bg-card: rgba(15, 22, 50, 0.88);
  --bg-card-hover: rgba(22, 32, 65, 0.95);
  --primary: #00d4aa;
  --primary-glow: rgba(0, 212, 170, 0.4);
  --accent: #ff6b35;
  --accent-glow: rgba(255, 107, 53, 0.3);
  --gold: #f0c040;
  --gold-glow: rgba(240, 192, 64, 0.4);
  --pink: #ff69b4;
  --text-main: #e8ecf5;
  --text-sub: #b0bcd8;
  --text-dim: #8090b0;
  --border: rgba(0, 212, 170, 0.15);
  --border-hover: rgba(0, 212, 170, 0.4);
  --radius: 16px;
  --radius-sm: 10px;
  --shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  --transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  --fs-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.85rem);
  --fs-sm: clamp(0.85rem, 0.8rem + 0.3vw, 0.95rem);
  --fs-base: clamp(0.9rem, 0.85rem + 0.3vw, 1.05rem);
  --fs-lg: clamp(1.1rem, 0.95rem + 0.6vw, 1.4rem);
  --fs-xl: clamp(1.4rem, 1.1rem + 1.2vw, 2.2rem);
  --fs-2xl: clamp(1.8rem, 1.3rem + 2vw, 3rem);
  --fs-3xl: clamp(2.2rem, 1.5rem + 3vw, 4rem);
}

html { scroll-behavior: smooth; scroll-padding-top: 70px; -webkit-tap-highlight-color: transparent; }

body {
  font-family: var(--font);
  background: var(--bg-dark);
  color: var(--text-main);
  line-height: 1.7;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  touch-action: pan-y;
}


/* ========== 背景图层 ========== */
.bg-layer {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background-size: cover;
  background-position: center;
  opacity: 0;
  transition: opacity 1.5s ease;
  z-index: 0;
  transform: scale(1.0);
}
.bg-layer.active {
  opacity: 1;
  animation: kenBurns 30s ease-in-out infinite alternate;
}
@keyframes kenBurns {
  from { transform: scale(1.0) translateY(0); }
  to { transform: scale(1.08) translateY(-2%); }
}
.bg-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(10,14,39,0.75) 0%, rgba(10,14,39,0.82) 100%);
  z-index: 1;
  pointer-events: none;
}

/* ========== 阅读进度条 ========== */
.reading-progress {
  position: fixed;
  top: 0; left: 0;
  width: 0%; height: 3px;
  background: linear-gradient(90deg, var(--primary), var(--gold), var(--accent));
  z-index: 10001;
  transition: width 0.1s linear;
  box-shadow: 0 0 8px var(--primary-glow);
}

/* ========== 底部悬浮导航胶囊 ========== */
.floating-nav {
  position: fixed; bottom: 20px; left: 50%;
  transform: translateX(-50%);
  display: flex; gap: 2px;
  background: rgba(10, 14, 39, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border);
  border-radius: 50px; padding: 6px;
  z-index: 9999;
  transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55), opacity 0.4s;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
}
.floating-nav.hidden {
  transform: translateX(-50%) translateY(100px);
  opacity: 0;
}
.fn-item {
  width: 36px; height: 36px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-base); text-decoration: none;
  color: var(--text-dim);
  transition: all 0.35s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  position: relative;
}
.fn-item:hover { color: var(--text-main); transform: scale(1.1); }
.fn-item.active {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff; transform: scale(1.15);
  box-shadow: 0 0 12px var(--primary-glow);
}

/* ========== Hero 区 ========== */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  text-align: center;
  padding: 40px 20px 60px;
  overflow: hidden;
  z-index: 2;
}
.hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(0, 212, 170, 0.1);
  border: 1px solid var(--border);
  border-radius: 50px; padding: 6px 18px;
  font-size: var(--fs-sm); color: var(--primary);
  margin-bottom: 24px;
  animation: fadeInDown 0.8s ease;
}
.hero-badge .dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--primary); animation: pulse 2s infinite;
}
.hero-title {
  font-size: clamp(2.2rem, 6vw, 4rem);
  font-weight: 900; line-height: 1.2;
  margin-bottom: 16px;
}
.hero-title .gradient-text {
  background: linear-gradient(135deg, var(--primary) 0%, var(--gold) 50%, var(--accent) 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
}
.hero-subtitle {
  font-size: clamp(0.95rem, 2.5vw, 1.15rem);
  color: var(--text-sub);
  margin-bottom: 40px; max-width: 600px;
  animation: fadeInUp 0.8s ease 0.2s both;
}
.hero-subtitle .tag {
  display: inline-block;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 6px; padding: 2px 10px;
  margin: 0 4px; font-size: 0.9em;
}

/* ========== 倒计时 ========== */
.countdown-wrapper { animation: fadeInUp 0.8s ease 0.3s both; }
.countdown-label {
  font-size: var(--fs-base); color: var(--text-sub);
  margin-bottom: 16px; letter-spacing: 2px;
}
.countdown { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.countdown-item {
  background: var(--bg-card);
  
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px 24px; min-width: 90px;
  text-align: center; position: relative; overflow: hidden;
}
.countdown-item::before {
  content: ''; position: absolute;
  top: 0; left: 0; width: 100%; height: 2px;
  background: linear-gradient(90deg, var(--primary), var(--gold), var(--accent));
}
.countdown-number {
  font-size: clamp(2rem, 6vw, 3rem); font-weight: 900;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1; font-variant-numeric: tabular-nums;
}
.countdown-unit {
  font-size: var(--fs-xs); color: var(--text-sub);
  margin-top: 6px; letter-spacing: 1px;
}
.hero-info-row {
  display: flex; gap: 20px; margin-top: 36px;
  flex-wrap: wrap; justify-content: center;
  animation: fadeInUp 0.8s ease 0.4s both;
}
.hero-info-item {
  display: flex; align-items: center; gap: 8px;
  font-size: var(--fs-base); color: var(--text-sub);
}
.hero-info-item .icon { font-size: var(--fs-lg); }
.scroll-hint {
  position: absolute; bottom: 80px; left: 50%;
  transform: translateX(-50%);
  color: var(--text-dim); font-size: var(--fs-xs);
  animation: bounce 2s infinite;
  display: flex; flex-direction: column;
  align-items: center; gap: 6px;
}

/* 山脉剪影 */
.mountain-silhouette {
  position: absolute; bottom: 0; left: 0; width: 100%;
  height: 200px; z-index: 0; pointer-events: none;
}
.mountain-silhouette svg { width: 100%; height: 100%; display: block; }

/* ========== 通用 Section ========== */
.section {
  position: relative;
  padding: 80px 20px;
  z-index: 2;
  max-width: 1200px;
  margin: 0 auto;
}
.section-header { text-align: center; margin-bottom: 50px; }
.section-icon { font-size: var(--fs-2xl); margin-bottom: 12px; display: block; color: var(--section-accent, var(--primary)); }
.section-title {
  font-size: clamp(1.6rem, 4vw, 2.2rem);
  font-weight: 800; margin-bottom: 10px;
}
.section-title .accent { color: var(--accent); }
.section-title .primary { color: var(--primary); }
.section-title .gold { color: var(--gold); }
.section-title-underline {
  width: 0; height: 3px; margin: 8px auto 0;
  background: linear-gradient(90deg, transparent, var(--section-accent, var(--gold)), transparent);
  border-radius: 2px;
  transition: width 0.8s ease 0.3s;
}
.section-header.visible .section-title-underline { width: 60%; }
.section-subtitle {
  color: var(--text-sub); font-size: var(--fs-base);
  max-width: 600px; margin: 0 auto;
}

/* ========== 路线总览时间线 ========== */
.route-overview {
  display: flex; flex-direction: column; gap: 0;
  position: relative; max-width: 800px; margin: 0 auto;
}
.route-item {
  display: flex; gap: 20px; position: relative;
  padding-bottom: 30px;
}
.route-item:last-child { padding-bottom: 0; }
.route-line {
  position: absolute; left: 19px; top: 40px; bottom: 0;
  width: 2px;
  background: linear-gradient(180deg, var(--primary), var(--border));
}
.route-item:last-child .route-line { display: none; }
.route-dot {
  width: 40px; height: 40px; border-radius: 50%;
  background: var(--bg-dark-2);
  border: 2px solid var(--primary);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-lg); flex-shrink: 0;
  z-index: 1; position: relative;
  transition: var(--transition);
}
.route-item:hover .route-dot {
  background: var(--primary); transform: scale(1.1);
  box-shadow: 0 0 20px var(--primary-glow);
}
.route-content {
  flex: 1; background: var(--bg-card);
  
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 16px 20px;
  transition: var(--transition);
}
.route-content:hover {
  border-color: var(--border-hover);
  background: var(--bg-card-hover);
  transform: translateX(4px);
}
.route-day { font-size: var(--fs-xs); color: var(--accent); font-weight: 600; margin-bottom: 4px; }
.route-title { font-size: var(--fs-lg); font-weight: 700; margin-bottom: 4px; }
.route-desc { font-size: var(--fs-base); color: var(--text-sub); }
.route-distance {
  display: inline-block; font-size: var(--fs-xs); color: var(--primary);
  background: rgba(0,212,170,0.1); padding: 2px 8px;
  border-radius: 4px; margin-top: 6px;
}

/* ========== 每日行程卡片 ========== */
.itinerary-card {
  background: var(--bg-card);
  
  border: 1px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 20px; overflow: hidden;
  transition: border-color 0.35s, box-shadow 0.35s, transform 0.15s ease-out;
  transform-style: preserve-3d;
  will-change: transform;
}
.itinerary-card:hover {
  border-color: var(--border-hover);
  box-shadow: 0 8px 40px rgba(0,212,170,0.12);
}
.itinerary-header {
  padding: 20px 24px; cursor: pointer;
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px; user-select: none;
}
.itinerary-header-left {
  display: flex; align-items: center; gap: 16px;
  flex: 1; min-width: 0;
}
.day-badge {
  width: 52px; height: 52px; border-radius: 14px;
  background: linear-gradient(135deg, rgba(0,212,170,0.15), rgba(255,107,53,0.1));
  border: 1px solid var(--border);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; flex-shrink: 0;
}
.day-badge .day-num { font-size: var(--fs-lg); font-weight: 900; color: var(--primary); line-height: 1; }
.day-badge .day-label { font-size: var(--fs-xs); color: var(--text-dim); margin-top: 2px; }
.day-info { flex: 1; min-width: 0; }
.day-title {
  font-size: var(--fs-lg); font-weight: 700; margin-bottom: 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.day-meta {
  font-size: var(--fs-sm); color: var(--text-sub);
  display: flex; gap: 12px; flex-wrap: wrap;
}
.day-meta span { display: inline-flex; align-items: center; gap: 4px; }
.toggle-icon { font-size: var(--fs-lg); color: var(--text-dim); transition: transform 0.3s ease; flex-shrink: 0; }
.itinerary-card.open .toggle-icon { transform: rotate(180deg); }
.itinerary-body { max-height: 0; overflow: hidden; transition: max-height 0.5s ease, opacity 0.3s; opacity: 0; }
.itinerary-card.open .itinerary-body { max-height: 3000px; opacity: 1; }
.itinerary-body-inner { padding: 0 24px 24px; border-top: 1px solid var(--border); }

.meal-section, .activity-section, .hotel-section, .drive-section, .drone-section, .fishing-section {
  margin-top: 20px;
}
.section-label {
  font-size: var(--fs-sm); font-weight: 700; color: var(--text-dim);
  text-transform: uppercase; letter-spacing: 1px;
  margin-bottom: 10px; display: flex; align-items: center; gap: 6px;
}
.meal-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
.meal-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius-sm); padding: 14px 16px;
  transition: var(--transition);
}
.meal-card:hover { background: rgba(255,255,255,0.06); border-color: var(--border-hover); }
.meal-type { font-size: var(--fs-xs); color: var(--accent); font-weight: 600; margin-bottom: 4px; }
.meal-name { font-size: var(--fs-base); font-weight: 600; margin-bottom: 4px; }
.meal-detail { font-size: var(--fs-sm); color: var(--text-sub); line-height: 1.5; }
.meal-price { display: inline-block; font-size: var(--fs-xs); color: var(--primary); margin-top: 4px; }

.hotel-card {
  background: rgba(0,212,170,0.05);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 16px 18px;
  display: flex; align-items: flex-start; gap: 12px;
}
.hotel-card .hotel-icon { font-size: var(--fs-xl); flex-shrink: 0; }
.hotel-name { font-size: var(--fs-base); font-weight: 700; margin-bottom: 4px; }
.hotel-detail { font-size: var(--fs-sm); color: var(--text-sub); }
.hotel-price { font-size: var(--fs-sm); color: var(--gold); font-weight: 600; margin-top: 4px; }

.activity-list { list-style: none; }
.activity-item {
  display: flex; gap: 12px; padding: 10px 0;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
.activity-item:last-child { border-bottom: none; }
.activity-time { font-size: var(--fs-xs); color: var(--accent); font-weight: 600; min-width: 50px; flex-shrink: 0; }
.activity-text { font-size: var(--fs-base); color: var(--text-main); }
.activity-text .note {
  display: inline-block; font-size: var(--fs-xs);
  padding: 1px 6px; border-radius: 4px; margin-left: 6px;
}
.note-warn { background: rgba(255,107,53,0.15); color: var(--accent); }
.note-ok { background: rgba(0,212,170,0.15); color: var(--primary); }
.note-info { background: rgba(255,255,255,0.08); color: var(--text-sub); }

.drive-info {
  background: rgba(255,107,53,0.05);
  border: 1px solid rgba(255,107,53,0.15);
  border-radius: var(--radius-sm);
  padding: 12px 16px; font-size: var(--fs-base); color: var(--text-sub);
  display: flex; align-items: center; gap: 8px;
}
.drone-info-box {
  background: rgba(0,212,170,0.05);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 14px 18px;
}
.drone-info-box .drone-title { font-size: var(--fs-base); font-weight: 700; color: var(--primary); margin-bottom: 8px; }
.drone-info-box ul { list-style: none; font-size: var(--fs-sm); color: var(--text-sub); }
.drone-info-box ul li { padding: 3px 0; padding-left: 18px; position: relative; }
.drone-info-box ul li::before { content: '🚁'; position: absolute; left: 0; font-size: var(--fs-xs); }
.fishing-card {
  background: rgba(100, 150, 255, 0.05);
  border: 1px solid rgba(100, 150, 255, 0.15);
  border-radius: var(--radius-sm);
  padding: 12px 16px; font-size: var(--fs-base);
  display: flex; align-items: center; gap: 8px;
}

/* ========== 温度对比图 ========== */
.temp-chart-container {
  background: var(--bg-card); 
  border: 1px solid var(--border); border-radius: var(--radius);
  padding: 30px 24px;
}
.temp-chart {
  display: flex; align-items: flex-end; justify-content: space-around;
  gap: 8px; height: 280px; padding-top: 20px;
  border-bottom: 2px solid var(--border); position: relative;
}
.temp-bar-group {
  display: flex; flex-direction: column; align-items: center;
  gap: 8px; flex: 1; max-width: 100px;
}
.temp-bar-wrapper {
  width: 100%; display: flex; justify-content: center;
  align-items: flex-end; height: 200px; position: relative;
}
.temp-bar {
  width: 60%; max-width: 50px;
  border-radius: 8px 8px 0 0; position: relative;
  transition: height 1s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.5s;
  min-height: 4px; opacity: 0; cursor: pointer;
}
.temp-bar.visible { opacity: 1; }
.temp-bar::after {
  content: attr(data-temp); position: absolute;
  top: -28px; left: 50%; transform: translateX(-50%);
  font-size: var(--fs-base); font-weight: 700; color: var(--text-main);
  white-space: nowrap;
}
.temp-bar-label { font-size: var(--fs-sm); color: var(--text-sub); text-align: center; line-height: 1.3; }
.temp-bar-label .alt { font-size: var(--fs-xs); color: var(--text-dim); display: block; }
.temp-legend { display: flex; gap: 24px; justify-content: center; margin-top: 20px; flex-wrap: wrap; }
.legend-item { display: flex; align-items: center; gap: 8px; font-size: var(--fs-sm); color: var(--text-sub); }
.legend-dot { width: 12px; height: 12px; border-radius: 3px; }

/* ========== 预算计算器 ========== */
.budget-container {
  background: var(--bg-card); 
  border: 1px solid var(--border); border-radius: var(--radius);
  padding: 30px 24px;
}
.budget-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.budget-items { display: flex; flex-direction: column; gap: 16px; }
.budget-item {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius-sm); padding: 16px 18px;
}
.budget-item-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.budget-item-title { font-size: var(--fs-base); font-weight: 600; display: flex; align-items: center; gap: 8px; }
.budget-range { display: flex; align-items: center; gap: 12px; }
.budget-range label { font-size: var(--fs-xs); color: var(--text-sub); min-width: 40px; }
.budget-range input[type="range"] {
  flex: 1; -webkit-appearance: none; appearance: none;
  height: 6px; background: rgba(255,255,255,0.1);
  border-radius: 3px; outline: none;
}
.budget-range input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none; appearance: none;
  width: 18px; height: 18px; border-radius: 50%;
  background: var(--primary); cursor: pointer;
  box-shadow: 0 0 10px var(--primary-glow);
  transition: transform 0.2s;
}
.budget-range input[type="range"]::-webkit-slider-thumb:hover { transform: scale(1.2); }
.budget-range input[type="range"]::-moz-range-thumb {
  width: 18px; height: 18px; border-radius: 50%;
  background: var(--primary); cursor: pointer; border: none;
  box-shadow: 0 0 10px var(--primary-glow);
}
.budget-value {
  font-size: var(--fs-base); color: var(--primary); font-weight: 700;
  min-width: 90px; text-align: right; font-variant-numeric: tabular-nums;
}
.budget-summary {
  background: linear-gradient(135deg, rgba(0,212,170,0.08), rgba(255,107,53,0.05));
  border: 1px solid var(--border-hover);
  border-radius: var(--radius-sm); padding: 24px;
  display: flex; flex-direction: column;
  justify-content: center; align-items: center; text-align: center;
}
.budget-summary-label { font-size: var(--fs-base); color: var(--text-sub); margin-bottom: 8px; }
.budget-total {
  font-size: var(--fs-2xl); font-weight: 900;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1.2; font-variant-numeric: tabular-nums;
}
.budget-total-unit { font-size: var(--fs-base); color: var(--text-sub); }
.budget-per-person { font-size: var(--fs-base); color: var(--text-sub); margin-top: 12px; }
.budget-per-person strong { color: var(--accent); }

/* 预算进度条 */
.budget-progress-wrap { margin-top: 16px; width: 100%; }
.budget-progress-track {
  width: 100%; height: 10px;
  background: rgba(255,255,255,0.06);
  border-radius: 5px; overflow: hidden; position: relative;
}
.budget-progress-fill {
  height: 100%; border-radius: 5px;
  transition: width 0.4s ease, background 0.4s ease;
}
.budget-progress-green-zone {
  position: absolute; top: 0; left: 33.33%;
  width: 33.34%; height: 100%;
  background: rgba(0, 212, 170, 0.15);
  border-left: 2px solid rgba(0, 212, 170, 0.4);
  border-right: 2px solid rgba(0, 212, 170, 0.4);
}
.budget-progress-labels {
  display: flex; justify-content: space-between;
  margin-top: 6px; font-size: var(--fs-xs); color: var(--text-dim);
}
.budget-progress-labels .green { color: var(--primary); font-weight: 600; }

.budget-breakdown { margin-top: 20px; width: 100%; display: flex; flex-direction: column; gap: 8px; }
.breakdown-bar { display: flex; align-items: center; gap: 8px; font-size: var(--fs-sm); }
.breakdown-bar-label { min-width: 70px; color: var(--text-sub); text-align: right; }
.breakdown-bar-track { flex: 1; height: 8px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden; }
.breakdown-bar-fill { height: 100%; border-radius: 4px; transition: width 0.6s ease; }
.breakdown-bar-value { min-width: 60px; color: var(--text-main); font-variant-numeric: tabular-nums; }

/* ========== 无人机航拍点 ========== */
.drone-map-container {
  background: var(--bg-card); 
  border: 1px solid var(--border); border-radius: var(--radius);
  padding: 30px 24px;
}
.drone-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
.drone-point {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius-sm); padding: 18px;
  text-align: center; transition: var(--transition);
  position: relative; overflow: hidden;
}
.drone-point::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px; }
.drone-point.status-yes::before { background: var(--primary); }
.drone-point.status-no::before { background: var(--accent); }
.drone-point.status-warn::before { background: #ffaa00; }
.drone-point:hover { transform: translateY(-4px); background: rgba(255,255,255,0.06); }
.drone-point-icon { font-size: var(--fs-2xl); margin-bottom: 10px; }
.drone-point-name { font-size: var(--fs-base); font-weight: 700; margin-bottom: 6px; }
.drone-point-status { font-size: var(--fs-sm); padding: 3px 12px; border-radius: 50px; display: inline-block; margin-bottom: 8px; }
.status-yes .drone-point-status { background: rgba(0,212,170,0.15); color: var(--primary); }
.status-no .drone-point-status { background: rgba(255,107,53,0.15); color: var(--accent); }
.status-warn .drone-point-status { background: rgba(255,170,0,0.15); color: #ffaa00; }
.drone-point-note { font-size: var(--fs-sm); color: var(--text-sub); line-height: 1.4; }
.drone-specs { margin-top: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }
.drone-spec-card {
  background: rgba(0,212,170,0.05);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm); padding: 14px; text-align: center;
}
.drone-spec-card .spec-label { font-size: var(--fs-xs); color: var(--text-dim); margin-bottom: 4px; }
.drone-spec-card .spec-value { font-size: var(--fs-base); font-weight: 700; color: var(--primary); }

/* ========== 行前清单 ========== */
.checklist-container {
  background: var(--bg-card); 
  border: 1px solid var(--border); border-radius: var(--radius);
  padding: 30px 24px;
}
.checklist-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
.checklist-item {
  display: flex; align-items: center; gap: 10px;
  padding: 12px 16px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius-sm);
  cursor: pointer; transition: var(--transition); user-select: none;
}
.checklist-item:hover { background: rgba(255,255,255,0.06); border-color: var(--border-hover); }
.checklist-item.checked { background: rgba(0,212,170,0.08); border-color: var(--primary); }
.checklist-checkbox {
  width: 22px; height: 22px; border-radius: 6px;
  border: 2px solid var(--text-dim);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; transition: var(--transition);
}
.checklist-item.checked .checklist-checkbox { background: var(--primary); border-color: var(--primary); }
.checklist-checkbox::after {
  content: '✓'; color: var(--bg-dark); font-weight: 900;
  font-size: var(--fs-base); opacity: 0; transition: opacity 0.2s;
}
.checklist-item.checked .checklist-checkbox::after { opacity: 1; }
.checklist-text { font-size: var(--fs-base); transition: var(--transition); }
.checklist-item.checked .checklist-text { text-decoration: line-through; color: var(--text-dim); }
.checklist-progress { margin-bottom: 24px; display: flex; align-items: center; gap: 16px; }
.checklist-progress-bar { flex: 1; height: 10px; background: rgba(255,255,255,0.06); border-radius: 5px; overflow: hidden; }
.checklist-progress-fill {
  height: 100%; background: linear-gradient(90deg, var(--primary), var(--accent));
  border-radius: 5px; width: 0%; transition: width 0.4s ease;
}
.checklist-progress-text { font-size: var(--fs-base); color: var(--text-sub); white-space: nowrap; font-variant-numeric: tabular-nums; }
.checklist-progress-text strong { color: var(--primary); }

/* ========== 亲子活动 & 野钓汇总 ========== */
.summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.summary-card {
  background: var(--bg-card); 
  border: 1px solid var(--border); border-radius: var(--radius); padding: 24px;
}
.summary-card h3 { font-size: var(--fs-lg); margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
.summary-list { list-style: none; }
.summary-list li {
  padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.04);
  font-size: var(--fs-base); display: flex; align-items: flex-start; gap: 8px;
}
.summary-list li:last-child { border-bottom: none; }
.summary-list .item-icon { flex-shrink: 0; }
.summary-list .item-location { color: var(--text-dim); font-size: var(--fs-sm); }
.summary-list .item-tag {
  display: inline-block; font-size: var(--fs-xs);
  padding: 1px 6px; border-radius: 4px;
  background: rgba(0,212,170,0.1); color: var(--primary); margin-left: 4px;
}

/* ========== 自驾注意事项 ========== */
.tips-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
.tip-card {
  background: var(--bg-card); 
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  padding: 20px; transition: var(--transition);
}
.tip-card:hover { border-color: var(--border-hover); transform: translateY(-3px); }
.tip-icon { font-size: var(--fs-xl); margin-bottom: 10px; }
.tip-title { font-size: var(--fs-base); font-weight: 700; margin-bottom: 6px; }
.tip-text { font-size: var(--fs-sm); color: var(--text-sub); }

/* ========== 山脉分隔 ========== */
.mountain-divider { position: relative; width: 100%; height: 60px; overflow: hidden; margin: 0; z-index: 2; }
.mountain-divider svg { position: absolute; bottom: 0; width: 100%; height: 100%; }

/* ========== Footer ========== */
.footer {
  text-align: center; padding: 40px 20px;
  border-top: 1px solid var(--border);
  position: relative; z-index: 2;
}
.footer-text { font-size: var(--fs-base); color: var(--text-dim); margin-bottom: 8px; }
.footer-emoji { font-size: var(--fs-xl); margin-bottom: 12px; }

/* ========== 动画 ========== */
@keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
@keyframes fadeInDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
@keyframes bounce { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(10px); } }

/* 滚动渐入（可重复触发） */
.fade-in {
  opacity: 0; transform: translateY(40px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}
.fade-in.visible { opacity: 1; transform: translateY(0); }

/* 文字逐字弹入 */
.char-animate span {
  display: inline-block; opacity: 0;
  transform: translateY(20px) rotate(-10deg);
  filter: blur(8px);
  transition: opacity 0.5s ease, transform 0.5s ease, filter 0.5s ease;
}
.char-animate.visible span {
  opacity: 1; transform: translateY(0) rotate(0); filter: blur(0);
}

/* 按钮过冲弹性 */
.btn-bounce {
  transition: transform 0.15s ease;
}
.btn-bounce.bouncing {
  animation: btnBounce 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}
@keyframes btnBounce {
  0% { transform: scale(0.93); }
  40% { transform: scale(1.03); }
  100% { transform: scale(1); }
}

/* ========== 响应式 ========== */
@media (max-width: 768px) {
  .countdown-item { min-width: 70px; padding: 12px 16px; }
  .countdown-number { font-size: var(--fs-2xl); }
  .budget-grid { grid-template-columns: 1fr; }
  .summary-grid { grid-template-columns: 1fr; }
  .meal-grid { grid-template-columns: 1fr; }
  .temp-chart { gap: 4px; height: 240px; }
  .temp-bar-label { font-size: var(--fs-xs); }
  .section { padding: 60px 16px; }
  .itinerary-header { padding: 16px; }
  .itinerary-body-inner { padding: 0 16px 20px; }
  .day-badge { width: 44px; height: 44px; }
  .day-badge .day-num { font-size: var(--fs-lg); }
  .hero-info-row { gap: 12px; }
  .floating-nav { padding: 4px; gap: 1px; }
  .fn-item { width: 32px; height: 32px; font-size: var(--fs-base); }
  .scroll-hint { bottom: 100px; }
}
@media (max-width: 480px) {
  .countdown { gap: 8px; }
  .countdown-item { min-width: 60px; padding: 10px 12px; }
  .countdown-number { font-size: var(--fs-xl); }
  .countdown-unit { font-size: var(--fs-xs); }
  .temp-bar-wrapper { height: 160px; }
  .temp-chart { height: 200px; }
  .budget-total { font-size: var(--fs-2xl); }
}

/* 滚动条美化 */
::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: var(--bg-dark); }
::-webkit-scrollbar-thumb { background: rgba(0,212,170,0.3); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: rgba(0,212,170,0.5); }

/* prefers-reduced-motion */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  .bg-layer.active { animation: none; }
}


/* ========== V3: 文字对比度增强 text-shadow ========== */
h1, h2, h3, h4, h5, h6,
.hero-title, .hero-subtitle, .hero-badge,
.countdown-label, .countdown-unit, .countdown-number,
.section-title, .section-subtitle, .section-label,
.route-title, .route-desc, .route-day, .route-distance,
.day-title, .day-meta, .day-badge .day-label,
.meal-name, .meal-detail, .meal-type, .meal-price,
.hotel-name, .hotel-detail, .hotel-price,
.activity-time, .activity-text, .activity-text .note,
.drive-info,
.drone-point-name, .drone-point-status, .drone-point-note,
.drone-info-box .drone-title, .drone-info-box ul li,
.drone-spec-card .spec-label, .drone-spec-card .spec-value,
.budget-item-title, .budget-summary-label, .budget-total-unit,
.budget-per-person, .budget-value, .budget-range label,
.budget-progress-labels span,
.breakdown-bar-label, .breakdown-bar-value,
.checklist-text, .checklist-progress-text,
.temp-bar-label, .temp-bar-label .alt,
.temp-bar::after, .legend-item,
.summary-card h3, .summary-list li, .summary-list .item-location,
.tip-title, .tip-text,
.footer-text, .scroll-hint, .hero-info-item,
.fn-item,
.section-icon,
.temp-climate-desc {
  text-shadow: 0 1px 4px rgba(0,0,0,0.7), 0 0 8px rgba(0,0,0,0.4);
}
/* 渐变文字不添加 text-shadow（避免透明填充导致异常阴影） */
.hero-title .gradient-text,
.budget-total,
.day-badge .day-num {
  text-shadow: none;
}


/* ========== V3 新增交互效果 CSS ========== */

/* b) 卡片3D流入动画 */
.itinerary-card.v3-slide-in {
  opacity: 0;
  transform: translateY(60px) scale(0.92) rotateX(5deg);
  transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  transform-origin: center bottom;
  perspective: 800px;
}
.itinerary-card.v3-slide-in.v3-visible {
  opacity: 1;
  transform: translateY(0) scale(1) rotateX(0);
}

/* c) 时间线生长动画 */
.route-overview.v3-timeline .route-item {
  opacity: 0;
  transform: translateX(-30px);
  transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.route-overview.v3-timeline.v3-grown .route-item {
  opacity: 1;
  transform: translateX(0);
}
.route-overview.v3-timeline.v3-grown .route-item:nth-child(1) { transition-delay: 0s; }
.route-overview.v3-timeline.v3-grown .route-item:nth-child(2) { transition-delay: 0.12s; }
.route-overview.v3-timeline.v3-grown .route-item:nth-child(3) { transition-delay: 0.24s; }
.route-overview.v3-timeline.v3-grown .route-item:nth-child(4) { transition-delay: 0.36s; }
.route-overview.v3-timeline.v3-grown .route-item:nth-child(5) { transition-delay: 0.48s; }
.route-overview.v3-timeline.v3-grown .route-item:nth-child(6) { transition-delay: 0.60s; }
.route-overview.v3-timeline.v3-grown .route-item:nth-child(7) { transition-delay: 0.72s; }
.route-overview.v3-timeline .route-dot {
  transform: scale(0);
  transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}
.route-overview.v3-timeline.v3-grown .route-dot {
  transform: scale(1);
}
.route-overview.v3-timeline.v3-grown .route-item:nth-child(1) .route-dot { transition-delay: 0.1s; }
.route-overview.v3-timeline.v3-grown .route-item:nth-child(2) .route-dot { transition-delay: 0.22s; }
.route-overview.v3-timeline.v3-grown .route-item:nth-child(3) .route-dot { transition-delay: 0.34s; }
.route-overview.v3-timeline.v3-grown .route-item:nth-child(4) .route-dot { transition-delay: 0.46s; }
.route-overview.v3-timeline.v3-grown .route-item:nth-child(5) .route-dot { transition-delay: 0.58s; }
.route-overview.v3-timeline.v3-grown .route-item:nth-child(6) .route-dot { transition-delay: 0.70s; }
.route-overview.v3-timeline.v3-grown .route-item:nth-child(7) .route-dot { transition-delay: 0.82s; }

/* d) 温度卡片3D翻转 */
.temp-bar-group {
  perspective: 1000px;
  cursor: pointer;
}
.temp-flip-inner {
  position: relative;
  width: 100%;
  transform-style: preserve-3d;
  transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
}
.temp-bar-group.v3-flipped .temp-flip-inner {
  transform: rotateY(180deg);
}
.temp-flip-front, .temp-flip-back {
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
.temp-flip-front {
  width: 100%;
}
.temp-flip-back {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  transform: rotateY(180deg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(0,212,170,0.15), rgba(15,22,50,0.95));
  border: 1px solid var(--border-hover);
  border-radius: var(--radius-sm);
  padding: 12px 8px;
  min-height: 120px;
}
.temp-climate-desc {
  font-size: var(--fs-xs);
  color: var(--text-main);
  line-height: 1.6;
  text-align: center;
  white-space: pre-line;
}
.temp-flip-hint {
  font-size: var(--fs-xs);
  color: var(--text-dim);
  margin-top: 4px;
}

/* e) 行前清单勾选庆祝粒子 */
.checklist-star {
  position: fixed;
  pointer-events: none;
  z-index: 10002;
  font-size: var(--fs-base);
  animation: checklistStarFly 0.8s ease-out forwards;
}
@keyframes checklistStarFly {
  0% { opacity: 1; transform: translate(0, 0) scale(1) rotate(0deg); }
  100% { opacity: 0; transform: translate(var(--tx, 0), var(--ty, -60px)) scale(0.3) rotate(360deg); }
}

/* f) 页面加载序列 */
.hero-badge.v3-load-seq {
  opacity: 0;
  animation: v3HeroFadeIn 0.6s ease forwards;
  animation-delay: 0.1s;
}
.hero-title.v3-load-seq {
  opacity: 0;
  animation: v3HeroFadeIn 0.8s ease forwards;
  animation-delay: 0.4s;
}
.hero-subtitle.v3-load-seq {
  opacity: 0;
  animation: v3HeroFadeIn 0.8s ease forwards;
  animation-delay: 1.0s;
}
.countdown-wrapper.v3-load-seq {
  opacity: 0;
  animation: v3HeroFadeIn 0.8s ease forwards;
  animation-delay: 1.5s;
}
.hero-info-row.v3-load-seq {
  opacity: 0;
  animation: v3HeroFadeIn 0.8s ease forwards;
  animation-delay: 2.0s;
}
.scroll-hint.v3-load-seq {
  opacity: 0;
  animation: v3HeroFadeIn 0.6s ease forwards;
  animation-delay: 2.5s;
}
@keyframes v3HeroFadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

/* a) 数字滚动动画 - 轻微缩放效果 */
.budget-value, #budget-total, #budget-per-person {
  transition: transform 0.15s ease;
}
.budget-value.v3-rolling, #budget-total.v3-rolling, #budget-per-person.v3-rolling {
  transform: scale(1.08);
}


/* ========== V4: 波浪过渡 ========== */
.wave-divider { position: relative; width: 100%; height: 40px; z-index: 2; overflow: hidden; }
.wave-divider svg { width: 100%; height: 100%; display: block; }

/* ========== V4: SVG路线地图 ========== */
.route-map-container { max-width: 500px; margin: 30px auto; padding: 20px; background: rgba(15,22,50,0.6); border-radius: 16px; border: 1px solid rgba(0,212,170,0.15); }
.route-map { width: 100%; height: auto; }
.route-map-container .route-path { stroke-dashoffset: 1000; }
.route-map-container.visible .route-path { animation: drawRoute 3s ease forwards; }
.route-map-container .route-node { opacity: 0; }
.route-map-container.visible .route-node { animation: popNode 0.4s ease forwards; }
.route-map-container.visible circle:nth-of-type(1) { animation-delay: 0.5s; }
.route-map-container.visible circle:nth-of-type(2) { animation-delay: 0.8s; }
.route-map-container.visible circle:nth-of-type(3) { animation-delay: 1.1s; }
.route-map-container.visible circle:nth-of-type(4) { animation-delay: 1.4s; }
.route-map-container.visible circle:nth-of-type(5) { animation-delay: 1.7s; }
.route-map-container.visible circle:nth-of-type(6) { animation-delay: 2.0s; }
.route-map-container.visible circle:nth-of-type(7) { animation-delay: 2.3s; }
@keyframes drawRoute { to { stroke-dashoffset: 0; } }
@keyframes popNode { from { transform: scale(0); opacity: 0; } to { transform: scale(1); opacity: 1; } }


/* ========== V4-B2 #7: 板块色彩主题 ========== */
.section-icon { transition: color 0.8s ease; }
.section-title-underline { transition: width 0.8s ease 0.3s, background 0.8s ease; }

/* ========== V4-B2 #8: 灯箱组件 ========== */
.lightbox { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 100000; display: flex; align-items: center; justify-content: center; }
.lightbox-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.92); backdrop-filter: blur(10px); }
.lightbox-content { position: relative; max-width: 98vw; max-height: 92vh; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.lightbox-content img { width: auto; height: auto; max-width: 95vw; max-height: 85vh; min-width: 200px; min-height: 150px; border-radius: 12px; object-fit: contain; box-shadow: 0 20px 60px rgba(0,0,0,0.5); transition: transform 0.1s ease-out; transform-origin: center center; touch-action: none; user-select: none; -webkit-user-select: none; display: block; margin: 0 auto; }
.lightbox-content img[src*="blob:"] { min-width: 300px; min-height: 200px; }
.lightbox-zoom-hint { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); color: rgba(255,255,255,0.6); font-size: 0.75rem; background: rgba(0,0,0,0.5); padding: 4px 12px; border-radius: 12px; pointer-events: none; opacity: 1; transition: opacity 0.5s; }
.lightbox-zoom-level { position: absolute; bottom: 50px; left: 50%; transform: translateX(-50%); color: rgba(255,255,255,0.8); font-size: 0.8rem; background: rgba(0,0,0,0.6); padding: 3px 10px; border-radius: 10px; pointer-events: none; opacity: 0; transition: opacity 0.3s; }
.lightbox-caption { text-align: center; color: var(--text-sub); margin-top: 16px; font-size: 0.9rem; }
.lightbox-close { position: absolute; top: -40px; right: 0; background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer; padding: 8px; transition: opacity 0.3s; }
.lightbox-close:hover { opacity: 0.7; }
.lightbox-prev, .lightbox-next { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.1); border: none; color: #fff; font-size: 2rem; cursor: pointer; padding: 12px 16px; border-radius: 8px; transition: background 0.3s; }
.lightbox-prev { left: -60px; }
.lightbox-next { right: -60px; }
.lightbox-prev:hover, .lightbox-next:hover { background: rgba(255,255,255,0.2); }
@media (max-width: 768px) {
  .lightbox-prev { left: 10px; }
  .lightbox-next { right: 10px; }
}
/* V11.1: 可点击放大图片 */
img[onclick*="openV9Lightbox"] { cursor: zoom-in; transition: transform 0.2s; }
img[onclick*="openV9Lightbox"]:hover { transform: scale(1.02); }
@media (max-width: 768px) {
  img[onclick*="openV9Lightbox"]:hover { transform: none; }
}
.view-full-btn {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(0,212,170,0.15); border: 1px solid rgba(0,212,170,0.3);
  color: var(--primary); border-radius: 20px; padding: 4px 12px;
  font-size: 0.75rem; cursor: pointer; transition: all 0.3s;
  margin-top: 8px;
}
.view-full-btn:hover { background: rgba(0,212,170,0.25); border-color: var(--primary); }

/* ========== V4-B2 #9: 温度横向条形图 ========== */
.temp-bars-upgraded { max-width: 520px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; }
.temp-bar-item { display: flex; align-items: center; gap: 12px; }
.temp-city { width: 72px; text-align: right; font-size: var(--fs-sm); color: var(--text-sub); flex-shrink: 0; }
.temp-city .alt { display: block; font-size: var(--fs-xs); color: var(--text-dim); }
.temp-track { flex: 1; height: 30px; background: rgba(255,255,255,0.05); border-radius: 15px; overflow: hidden; position: relative; }
.temp-fill { height: 100%; width: 0; border-radius: 15px; background: linear-gradient(90deg, #2ecc71, #f0c040, #ff6b35); display: flex; align-items: center; justify-content: flex-end; padding-right: 10px; transition: width 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); }
.temp-value { font-size: 0.75rem; font-weight: 700; color: #fff; text-shadow: 0 1px 2px rgba(0,0,0,0.5); white-space: nowrap; }
.temp-bars-upgraded.visible .temp-fill { width: var(--target-width); }
.temp-bars-hint { text-align: center; color: var(--text-dim); font-size: var(--fs-xs); margin-top: 12px; }

/* ========== #10 骨架屏加载 ========== */
#skeleton {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: var(--bg-dark); z-index: 999999;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 20px; padding: 40px 20px;
  transition: opacity 0.6s ease;
}
#skeleton.fade-out { opacity: 0; pointer-events: none; }
#skeleton.hidden { display: none; }
.skeleton-logo {
  font-size: var(--fs-2xl); font-weight: 900;
  background: linear-gradient(135deg, var(--primary), var(--gold));
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: skeletonPulse 1.5s infinite;
  margin-bottom: 10px;
}
@keyframes skeletonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
.skeleton-block {
  background: linear-gradient(90deg, #1a1a1a 25%, #2a2a2a 50%, #1a1a1a 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 12px;
}
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}
.skeleton-hero { width: 80%; max-width: 500px; height: 60px; margin-bottom: 8px; }
.skeleton-sub { width: 60%; max-width: 360px; height: 30px; margin-bottom: 16px; }
.skeleton-cards { display: flex; gap: 16px; width: 90%; max-width: 700px; }
.skeleton-cards .skeleton-block { flex: 1; height: 100px; }
.skeleton-section { width: 90%; max-width: 700px; height: 40px; margin-top: 12px; }

/* ========== #11 Scroll-snap关键区 ========== */
@media (min-width: 1024px) {
  html { scroll-snap-type: y proximity; }
  #hero { scroll-snap-align: start; }
  .day-card { scroll-snap-align: start; }
}

/* ========== #12 预算滑块+环形图 ========== */
.budget-slider-section {
  margin-top: 20px; padding: 20px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius-sm);
  display: flex; flex-direction: column; align-items: center; gap: 16px;
}
.budget-slider-section label {
  font-size: var(--fs-base); color: var(--text-sub); font-weight: 600;
}
.budget-slider-section label span { color: var(--primary); font-size: var(--fs-lg); }
#budget-slider {
  width: 100%; -webkit-appearance: none; appearance: none;
  height: 8px; background: rgba(255,255,255,0.1);
  border-radius: 4px; outline: none; cursor: pointer;
}
#budget-slider::-webkit-slider-thumb {
  -webkit-appearance: none; appearance: none;
  width: 24px; height: 24px; border-radius: 50%;
  background: var(--primary); cursor: pointer;
  box-shadow: 0 0 12px var(--primary-glow);
  transition: transform 0.2s;
}
#budget-slider::-webkit-slider-thumb:hover { transform: scale(1.2); }
#budget-slider::-moz-range-thumb {
  width: 24px; height: 24px; border-radius: 50%;
  background: var(--primary); cursor: pointer; border: none;
  box-shadow: 0 0 12px var(--primary-glow);
}
.budget-ring-wrapper {
  display: flex; align-items: center; gap: 20px; width: 100%;
  justify-content: center; flex-wrap: wrap;
}
.budget-ring {
  width: 150px; height: 150px; border-radius: 50%;
  position: relative; flex-shrink: 0;
  transition: transform 0.3s;
}
.budget-ring.over-budget {
  animation: shake 0.3s ease;
}
.budget-ring-center {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 90px; height: 90px; border-radius: 50%;
  background: var(--bg-card); display: flex; flex-direction: column;
  align-items: center; justify-content: center; z-index: 1;
}
.budget-ring-center .ring-total { font-size: var(--fs-base); font-weight: 900; color: var(--primary); }
.budget-ring-center .ring-label { font-size: var(--fs-xs); color: var(--text-dim); }
.budget-ring-legend { display: flex; flex-direction: column; gap: 6px; }
.ring-legend-item { display: flex; align-items: center; gap: 6px; font-size: var(--fs-sm); color: var(--text-sub); }
.ring-legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-5px); }
  75% { transform: translateX(5px); }
}

/* ========== #13 倒计时（V6简化版） ========== */
.countdown-grid { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.countdown-cell {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 14px 20px; min-width: 90px;
  text-align: center; position: relative; overflow: hidden;
}
.countdown-cell::before {
  content: ''; position: absolute;
  top: 0; left: 0; width: 100%; height: 2px;
  background: linear-gradient(90deg, var(--primary), var(--gold), var(--accent));
}
.countdown-digit {
  font-size: clamp(2rem, 6vw, 2.8rem); font-weight: 900;
  color: #00d4aa;
  text-shadow: 0 0 10px rgba(0,212,170,0.5);
  line-height: 1; font-variant-numeric: tabular-nums;
  letter-spacing: 2px;
}
.countdown-cell-unit {
  font-size: var(--fs-xs); color: var(--text-sub);
  margin-top: 6px; letter-spacing: 1px;
}
@media (max-width: 768px) {
  .countdown-cell { min-width: 70px; padding: 12px 14px; }
  .countdown-digit { font-size: clamp(1.6rem, 5vw, 2.2rem); }
}
@media (max-width: 480px) {
  .countdown-grid { gap: 8px; }
  .countdown-cell { min-width: 62px; padding: 10px 12px; }
  .countdown-digit { font-size: clamp(1.4rem, 4.5vw, 1.8rem); }
}

/* ========== V10 手机端修复 ========== */
@media (max-width: 768px) {
  /* 强制显示所有 fade-in 内容，不依赖 JS */
  .fade-in, .stagger-in {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
    visibility: visible !important;
  }
  .char-animate span {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }
  .section-header { opacity: 1 !important; }
  .section-header.visible .section-title-underline { width: 60%; }

  /* 背景图：强制显示第一张作为静态背景，其余隐藏 */
  .bg-layer {
    animation: none !important;
    transform: none !important;
    transition: none !important;
  }
  .bg-layer[data-section="hero"] {
    opacity: 0.5 !important;
  }
  .bg-layer:not([data-section="hero"]) {
    opacity: 0 !important;
    display: none !important;
  }

  /* 遮罩层降低透明度，让背景图透出来 */
  .bg-overlay {
    background: linear-gradient(180deg, rgba(10,14,39,0.4) 0%, rgba(10,14,39,0.5) 100%) !important;
  }

  /* 骨架屏在手机端直接隐藏，避免 shimmer 光斑遮挡内容 */
  #skeleton {
    display: none !important;
  }

  /* 导航栏在手机端降低模糊强度 */
  .route-switcher {
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
  }

  /* 减少玻璃拟态模糊强度，避免白色光晕 */
  .glass-card, .budget-container, .checklist-container,
  .temp-chart-container, .drone-map-container, .summary-card {
    backdrop-filter: blur(6px) !important;
    -webkit-backdrop-filter: blur(6px) !important;
  }

  /* 禁止 observer 在手机端隐藏已显示内容 */
  .itinerary-card.v3-slide-in { opacity: 1 !important; transform: none !important; }

  /* 路线时间线强制显示 */
  .route-overview.v3-timeline .route-item {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }
  .route-overview.v3-timeline .route-dot {
    transform: scale(1) !important;
  }
  .route-map-container .route-node {
    opacity: 1 !important;
    animation: none !important;
  }

  /* Hero 区域加载序列强制显示 */
  .hero-badge.v3-load-seq,
  .hero-title.v3-load-seq,
  .hero-subtitle.v3-load-seq,
  .countdown-wrapper.v3-load-seq,
  .hero-info-row.v3-load-seq,
  .scroll-hint.v3-load-seq {
    opacity: 1 !important;
    transform: none !important;
    animation: none !important;
  }

  /* 文字清晰度修复：减弱过重的阴影，避免发虚 */
  body {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }
  h1, h2, h3, h4, h5, h6, p, span, a, li, .day-title, .meal-name, .hotel-name, .activity-text, .section-title, .section-subtitle {
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    text-shadow: 0 1px 2px rgba(0,0,0,0.6) !important;
  }
  /* 倒计时数字 glow 减弱 */
  .countdown-digit {
    text-shadow: 0 0 6px rgba(0,212,170,0.3) !important;
  }
  /* 导航光晕减弱 */
  .fn-item.active {
    box-shadow: 0 0 6px var(--primary-glow) !important;
  }

  /* 图片画廊适配优化 */
  .photo-gallery img { height: 100px; }

  /* 视频 iframe 限制高度 */
  .video-section iframe { max-height: 200px; }

  /* 确保所有内容区域不被遮挡 */

  /* 底部留出 CTA 栏的空间 */
  .footer { padding-bottom: 80px; }
}

@media (max-width: 480px) {
  .photo-gallery img { height: 80px; }
  .video-section iframe { max-height: 180px; }
}

/* ========== V11 手机端折叠重构 ========== */
@media (max-width: 768px) {
  .mobile-accordion { position: relative; }
  .mobile-accordion .accordion-trigger {
    display: flex; align-items: center; gap: 12px;
    min-height: 52px; padding: 14px 18px;
    background: rgba(15, 22, 50, 0.9);
    border: 1px solid var(--border);
    border-radius: 12px; cursor: pointer; user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: border-color .3s, box-shadow .3s, border-radius .3s;
    position: relative; z-index: 2;
  }
  .mobile-accordion .accordion-trigger:active { background: rgba(20, 30, 65, .95); }
  .mobile-accordion:not(.accordion-collapsed) .accordion-trigger {
    border-color: var(--primary);
    box-shadow: 0 0 12px rgba(0,212,170,.15);
    border-bottom-left-radius: 0; border-bottom-right-radius: 0;
  }
  .mobile-accordion .accordion-icon { font-size: 22px; flex-shrink: 0; }
  .mobile-accordion .accordion-title { flex: 1; font-size: 16px; font-weight: 600; color: #e8ecf5; }
  .mobile-accordion .accordion-arrow {
    font-size: 24px; color: var(--primary); line-height: 1; flex-shrink: 0;
    transition: transform .35s ease;
  }
  .mobile-accordion:not(.accordion-collapsed) .accordion-arrow { transform: rotate(90deg); }
  .mobile-accordion .accordion-body {
    display: grid; grid-template-rows: 1fr;
    transition: grid-template-rows .4s ease;
  }
  .mobile-accordion.accordion-collapsed .accordion-body { grid-template-rows: 0fr; }
  .mobile-accordion .accordion-body-inner { overflow: hidden; min-height: 0; }
  .mobile-accordion:not(.accordion-collapsed) .accordion-body-inner {
    border: 1px solid var(--primary); border-top: none;
    border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;
  }
}
@media (min-width: 769px) {
  .mobile-accordion .accordion-trigger { display: none !important; }
  .mobile-accordion .accordion-body { display: block !important; }
  .mobile-accordion .accordion-body-inner { overflow: visible !important; min-height: auto !important; border: none !important; }
}

/* ========== #15 暗/亮主题切换 ========== */
.theme-toggle {
  position: fixed; top: 80px; right: 20px; z-index: 10000;
  width: 44px; height: 44px; border-radius: 50%; border: none;
  background: var(--bg-card); backdrop-filter: blur(10px);
  font-size: 20px; cursor: pointer; transition: all 0.3s;
  border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
}
.theme-toggle:hover { transform: scale(1.1); border-color: var(--border-hover); box-shadow: 0 0 12px var(--primary-glow); }

[data-theme="light"] {
  --bg-primary: #f5f5f5; --text-primary: #1a1a1a; --text-secondary: #444;
  --card-bg: rgba(255,255,255,0.9);
}
[data-theme="light"] body { background: #f5f5f5; color: #1a1a1a; }
[data-theme="light"] .bg-overlay { background: rgba(255,255,255,0.55) !important; }
[data-theme="light"] .glass-card,
[data-theme="light"] .budget-container,
[data-theme="light"] .checklist-container,
[data-theme="light"] .drone-map-container,
[data-theme="light"] .temp-chart-container,
[data-theme="light"] .summary-card,
[data-theme="light"] .tip-card,
[data-theme="light"] .itinerary-card,
[data-theme="light"] .route-content {
  background: rgba(255,255,255,0.85); color: #1a1a1a;
  border-color: rgba(0,0,0,0.1);
}
[data-theme="light"] .floating-nav { background: rgba(255,255,255,0.85); border-color: rgba(0,0,0,0.08); }
[data-theme="light"] .section-subtitle,
[data-theme="light"] .hero-subtitle { color: #555; }
[data-theme="light"] .text-shadow-fix,
[data-theme="light"] .day-meta,
[data-theme="light"] .route-desc,
[data-theme="light"] .meal-detail,
[data-theme="light"] .hotel-detail,
[data-theme="light"] .activity-text,
[data-theme="light"] .budget-item-title,
[data-theme="light"] .budget-summary-label,
[data-theme="light"] .budget-total-unit,
[data-theme="light"] .budget-per-person,
[data-theme="light"] .budget-range label,
[data-theme="light"] .breakdown-bar-label,
[data-theme="light"] .checklist-text,
[data-theme="light"] .tip-text { color: #555 !important; }
[data-theme="light"] .text-dim-fix,
[data-theme="light"] .day-badge .day-label,
[data-theme="light"] .countdown-unit,
[data-theme="light"] .countdown-label { color: #888 !important; }
[data-theme="light"] .budget-item,
[data-theme="light"] .meal-card,
[data-theme="light"] .budget-slider-section {
  background: rgba(0,0,0,0.03); border-color: rgba(0,0,0,0.08);
}
[data-theme="light"] #skeleton { background: #f5f5f5; }
[data-theme="light"] .skeleton-block {
  background: linear-gradient(90deg, #e8e8e8 25%, #f5f5f5 50%, #e8e8e8 75%);
  background-size: 200% 100%;
}
[data-theme="light"] .budget-ring-center { background: rgba(255,255,255,0.9); }
[data-theme="light"] .ring-total { color: #1a1a1a !important; }

/* ========== V7 ========== */

/* 2a: Ripple 水波纹效果 */
.ripple-effect {
  position: relative; overflow: hidden;
}
.ripple-effect .ripple-wave {
  position: absolute; border-radius: 50%;
  background: rgba(255,255,255,0.3);
  transform: scale(0); animation: rippleWave 0.6s ease-out;
  pointer-events: none;
}
@keyframes rippleWave {
  to { transform: scale(4); opacity: 0; }
}

/* 2b: 卡片悬浮3D倾斜效果 */
.tilt-hover {
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  transform-style: preserve-3d;
}

/* 2c: 导航链接悬浮发光效果 */
.fn-item {
  position: relative; overflow: hidden;
}
.fn-item::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  width: 0; height: 2px;
  background: linear-gradient(90deg, var(--primary), var(--gold));
  transition: width 0.3s ease, left 0.3s ease;
}
.fn-item:hover::after {
  width: 80%; left: 10%;
}

/* 2d: 滚动触发渐次出现动画 */
.stagger-in { opacity: 0; transform: translateY(30px); transition: opacity 0.5s ease, transform 0.5s ease; }
.stagger-in.visible { opacity: 1; transform: translateY(0); }
.stagger-in:nth-child(1) { transition-delay: 0s; }
.stagger-in:nth-child(2) { transition-delay: 0.08s; }
.stagger-in:nth-child(3) { transition-delay: 0.16s; }
.stagger-in:nth-child(4) { transition-delay: 0.24s; }
.stagger-in:nth-child(5) { transition-delay: 0.32s; }
.stagger-in:nth-child(6) { transition-delay: 0.40s; }
.stagger-in:nth-child(7) { transition-delay: 0.48s; }
.stagger-in:nth-child(8) { transition-delay: 0.56s; }
.stagger-in:nth-child(9) { transition-delay: 0.64s; }
.stagger-in:nth-child(10) { transition-delay: 0.72s; }
.stagger-in:nth-child(11) { transition-delay: 0.80s; }
.stagger-in:nth-child(12) { transition-delay: 0.88s; }
.stagger-in:nth-child(13) { transition-delay: 0.96s; }

/* 2f: Section副标题滑入动画增强 - section-title已有char-animate，不重复 */
.section-subtitle {
  opacity: 0; transform: translateY(15px); transition: opacity 0.5s ease 0.3s, transform 0.5s ease 0.3s;
}
.section-header.visible .section-subtitle {
  opacity: 1; transform: translateY(0);
}

/* 2g: 背景图切换增强 - 微缩放过渡 */
.bg-layer.active {
  opacity: 1;
  animation: kenBurnsIn 1.5s ease-out forwards, kenBurns 30s ease-in-out 1.5s infinite alternate;
}
@keyframes kenBurnsIn {
  from { transform: scale(1.1); }
  to { transform: scale(1.0); }
}

/* 2h: 行程卡片展开动画增强 */
.itinerary-card.open .itinerary-body-inner > * {
  animation: fadeInUpV7 0.4s ease forwards;
  opacity: 0;
}
.itinerary-card.open .itinerary-body-inner > *:nth-child(1) { animation-delay: 0s; }
.itinerary-card.open .itinerary-body-inner > *:nth-child(2) { animation-delay: 0.08s; }
.itinerary-card.open .itinerary-body-inner > *:nth-child(3) { animation-delay: 0.16s; }
.itinerary-card.open .itinerary-body-inner > *:nth-child(4) { animation-delay: 0.24s; }
.itinerary-card.open .itinerary-body-inner > *:nth-child(5) { animation-delay: 0.32s; }
.itinerary-card.open .itinerary-body-inner > *:nth-child(6) { animation-delay: 0.40s; }
.itinerary-card.open .itinerary-body-inner > *:nth-child(7) { animation-delay: 0.48s; }
@keyframes fadeInUpV7 { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

/* 2i: 鼠标跟随光晕效果 */
.mouse-glow {
  position: fixed; width: 300px; height: 300px; border-radius: 50%;
  background: radial-gradient(circle, rgba(0,212,170,0.08) 0%, transparent 70%);
  pointer-events: none; z-index: 1; transition: transform 0.15s ease-out;
  transform: translate(-50%, -50%);
}

/* ========== V8 小众路线 ========== */

/* 路线切换器 */
.route-switcher {
  display: flex;
  justify-content: center;
  gap: 4px;
  max-width: 480px;
  margin: 0 auto 28px;
  background: rgba(10, 14, 39, 0.7);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border);
  border-radius: 50px;
  padding: 5px;
  position: relative;
  z-index: 10;
}
.route-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 10px 16px;
  border: none;
  background: transparent;
  color: var(--text-dim);
  font-size: var(--fs-sm);
  font-weight: 700;
  font-family: var(--font);
  border-radius: 50px;
  cursor: pointer;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  white-space: nowrap;
  position: relative;
}
.route-tab:hover { color: var(--text-main); }
.route-tab.active {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  box-shadow: 0 4px 16px rgba(0, 212, 170, 0.3);
}
.route-tab .tab-icon { font-size: 1.1em; }

/* 路线内容切换动画 */
.route-content-wrap {
  transition: opacity 0.4s ease;
}
.route-content-wrap.switching {
  opacity: 0;
  pointer-events: none;
}

/* 小众路线 Hero 标签 */
.alt-route-tag {
  background: rgba(46, 204, 113, 0.15) !important;
  border-color: rgba(46, 204, 113, 0.3) !important;
  color: #2ecc71 !important;
}

/* 预算路线指示器 */
.budget-route-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 16px;
  font-size: var(--fs-sm);
  color: var(--text-dim);
}
.budget-route-indicator .bi-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--primary);
  animation: pulse 2s infinite;
}

/* 小众路线预算卡片 */
.alt-budget-summary {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 12px;
  margin-top: 20px;
}
.alt-budget-item {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 16px;
  text-align: center;
  transition: var(--transition);
}
.alt-budget-item:hover {
  border-color: var(--border-hover);
  background: var(--bg-card-hover);
}
.alt-budget-item .ab-icon { font-size: 1.5em; margin-bottom: 6px; }
.alt-budget-item .ab-label { font-size: var(--fs-sm); color: var(--text-dim); margin-bottom: 4px; }
.alt-budget-item .ab-value { font-size: var(--fs-lg); font-weight: 800; color: var(--gold); }
.alt-budget-total {
  grid-column: 1 / -1;
  background: linear-gradient(135deg, rgba(0,212,170,0.12), rgba(255,107,53,0.08));
  border: 1px solid rgba(0,212,170,0.3);
  border-radius: 12px;
  padding: 20px;
  text-align: center;
  margin-top: 8px;
}
.alt-budget-total .abt-label { font-size: var(--fs-sm); color: var(--text-sub); margin-bottom: 6px; }
.alt-budget-total .abt-value { font-size: var(--fs-2xl); font-weight: 900; color: var(--primary); text-shadow: 0 2px 8px rgba(0,212,170,0.3); }
.alt-budget-total .abt-per { font-size: var(--fs-sm); color: var(--text-dim); margin-top: 6px; }

/* 小众路线住宿推荐 */
.alt-hotel-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 14px;
  margin-top: 20px;
}
.alt-hotel-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 16px;
}

/* 小众路线温度条 */
#tempAltContent .temp-bar-item .temp-fill {
  background: linear-gradient(90deg, #2ecc71, #00d4aa) !important;
}


/* ========== V9 图片视频 ========== */

/* 图片画廊 */
.photo-gallery {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin-top: 12px;
}
@media (max-width: 900px) { .photo-gallery { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 600px) { .photo-gallery { grid-template-columns: repeat(2, 1fr); } }
.photo-gallery img {
  width: 100%; height: 120px; object-fit: cover;
  border-radius: 8px; cursor: pointer;
  transition: transform 0.3s, box-shadow 0.3s;
  border: 1px solid var(--border);
}
.photo-gallery img:hover {
  transform: scale(1.05);
  box-shadow: 0 4px 16px rgba(0,212,170,0.25);
}
.gallery-label {
  font-size: var(--fs-sm);
  color: var(--primary);
  font-weight: 700;
  margin-top: 16px;
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* 视频区域 */
.video-section { margin-top: 12px; }
.video-section iframe {
  width: 100%; aspect-ratio: 16/9;
  border: none; border-radius: 8px;
  border: 1px solid var(--border);
}
.video-links {
  display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px;
}
.video-link {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 14px;
  background: rgba(0,212,170,0.1);
  border: 1px solid var(--border);
  border-radius: 20px;
  color: var(--primary); text-decoration: none;
  font-size: var(--fs-xs); font-weight: 600;
  transition: all 0.3s;
}
.video-link:hover {
  background: rgba(0,212,170,0.2);
  border-color: var(--primary);
}

/* 酒店图片 */
.hotel-photos {
  display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap;
}
.hotel-photos img {
  width: 120px; height: 80px; object-fit: cover;
  border-radius: 8px; cursor: pointer;
  border: 1px solid var(--border);
  transition: transform 0.3s;
}
.hotel-photos img:hover { transform: scale(1.05); }

/* 美食图片 */
.food-photos {
  display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap;
}
.food-photos img {
  width: 120px; height: 80px; object-fit: cover;
  border-radius: 8px; cursor: pointer;
  border: 1px solid var(--border);
  transition: transform 0.3s;
}
.food-photos img:hover { transform: scale(1.05); }

/* 主路线景点图片（内联样式简洁版） */
.spot-photos {
  display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap;
}
.spot-photos img {
  width: 140px; height: 95px; object-fit: cover;
  border-radius: 8px; cursor: pointer;
  border: 1px solid var(--border);
  transition: transform 0.3s;
}
.spot-photos img:hover { transform: scale(1.05); }


/* ========== V12: 增强灯箱交互 ========== */
/* 所有图片桌面端zoom-in光标 */
img { cursor: zoom-in; }
svg.route-map { cursor: zoom-in; }
/* 灯箱内图片cursor */
.lightbox-content img { cursor: grab; }
.lightbox-content img.dragging { cursor: grabbing; }
/* 灯箱容器禁止默认touch行为 */
.lightbox-content {
  touch-action: none;
  user-select: none;
  -webkit-user-select: none;
}
.lightbox-content img {
  transition: transform 0.12s ease-out;
  transform-origin: center center;
  will-change: transform;
}
/* 重置按钮 */
.lightbox-reset-btn {
  position: fixed;
  bottom: 30px;
  right: 20px;
  background: rgba(255,255,255,0.15);
  border: 1px solid rgba(255,255,255,0.3);
  color: #fff;
  padding: 8px 18px;
  border-radius: 20px;
  font-size: 0.8rem;
  cursor: pointer;
  z-index: 100003;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.lightbox-reset-btn.visible { opacity: 1; pointer-events: auto; }
.lightbox-reset-btn:hover { background: rgba(255,255,255,0.25); }
/* 增强关闭按钮触控区域 */
.lightbox-close {
  min-width: 48px !important;
  min-height: 48px !important;
}
.lightbox-zoom-level {
  position: absolute; bottom: 50px; left: 50%;
  transform: translateX(-50%);
  color: rgba(255,255,255,0.8);
  font-size: 0.8rem;
  background: rgba(0,0,0,0.6);
  padding: 3px 10px;
  border-radius: 10px;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s;
}
@media (max-width: 768px) {
  .lightbox-reset-btn { bottom: 80px; right: 15px; }
}



/* ========== V12 此行必做 ========== */
.must-do-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-top: 24px;
}
.must-do-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 20px 16px;
  text-align: center;
  transition: var(--transition);
  cursor: default;
}
.must-do-card:hover {
  background: var(--bg-card-hover);
  border-color: var(--border-hover);
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0,212,170,0.12);
}
.must-do-emoji { font-size: 2rem; margin-bottom: 8px; display: block; }
.must-do-title { font-size: var(--fs-sm); font-weight: 600; color: var(--text-main); margin-bottom: 6px; }
.must-do-desc { font-size: var(--fs-xs); color: var(--text-sub); line-height: 1.5; }
@media (max-width: 768px) {
  .must-do-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .must-do-card { padding: 14px 10px; }
  .must-do-emoji { font-size: 1.6rem; }
}

/* ========== V12 必吃推荐标签 ========== */
.food-tag {
  display: inline-block;
  background: rgba(255,107,53,0.18);
  color: var(--accent);
  font-size: 0.7em;
  padding: 1px 6px;
  border-radius: 4px;
  margin-left: 4px;
  vertical-align: middle;
  font-weight: 500;
  letter-spacing: 0.02em;
}


/* ===== 新增样式开始 ===== */

/* 1.1 板块标题淡入上浮 */
@keyframes addFadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
.section-header.add-fade-up {
  opacity: 0;
  transform: translateY(20px);
}
.section-header.add-fade-up.add-visible {
  animation: addFadeUp 0.7s ease-out forwards;
}

/* 1.2 按钮/卡片悬停微放大 */
.add-hover-lift {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.add-hover-lift:hover {
  transform: scale(1.02);
  box-shadow: 0 8px 25px rgba(0,0,0,0.15);
}


/* 1.4 行前清单勾选动画 */
.checklist-item.add-check-anim .checklist-checkbox {
  position: relative;
  overflow: hidden;
}
.checklist-item.add-check-anim.active .checklist-checkbox::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 12px;
  height: 8px;
  border-left: 2px solid #fff;
  border-bottom: 2px solid #fff;
  transform: translate(-50%, -60%) rotate(-45deg) scale(0);
  transform-origin: center;
  animation: addCheckMark 0.35s ease-out forwards;
}
@keyframes addCheckMark {
  0% { transform: translate(-50%, -60%) rotate(-45deg) scale(0); }
  50% { transform: translate(-50%, -60%) rotate(-45deg) scale(1.2); }
  100% { transform: translate(-50%, -60%) rotate(-45deg) scale(1); }
}

/* 2.2 贵州小知识轮播 */
.add-knowledge-bar {
  padding: 14px 20px;
  background: linear-gradient(90deg, rgba(240,192,64,0.08), rgba(0,212,170,0.08));
  border-top: 1px solid rgba(240,192,64,0.15);
  border-bottom: 1px solid rgba(0,212,170,0.15);
  overflow: hidden;
  position: relative;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-knowledge-text {
  font-size: 13px;
  color: var(--text-main, #e8ecf8);
  opacity: 0;
  transition: opacity 0.5s ease;
  text-align: center;
  max-width: 90%;
}
.add-knowledge-text.add-knowledge-show {
  opacity: 1;
}
.add-knowledge-icon {
  margin-right: 8px;
}

/* 2.3 预算计算器切换 */
.add-budget-toggle {
  display: inline-flex;
  align-items: center;
  background: rgba(255,255,255,0.08);
  border-radius: 20px;
  padding: 3px;
  margin-left: 10px;
  vertical-align: middle;
}
.add-budget-toggle-btn {
  padding: 4px 12px;
  border: none;
  background: transparent;
  color: var(--text-sub, #8892b0);
  font-size: 11px;
  font-weight: 600;
  border-radius: 16px;
  cursor: pointer;
  transition: all 0.2s ease;
}
.add-budget-toggle-btn.add-budget-toggle-active {
  background: var(--primary, #00d4aa);
  color: #0a0e27;
}


/* 3.2 SVG地图城市悬停高亮 */
.route-map circle.route-node {
  transition: all 0.25s ease;
  cursor: pointer;
}
.route-map circle.route-node:hover {
  filter: url(#nodeGlow) brightness(1.3);
  r: 11;
}
.add-map-tooltip {
  position: absolute;
  pointer-events: none;
  background: rgba(15,22,50,0.95);
  color: #fff;
  font-size: 12px;
  padding: 6px 12px;
  border-radius: 6px;
  border: 1px solid rgba(0,212,170,0.4);
  z-index: 50;
  opacity: 0;
  transition: opacity 0.2s ease;
  white-space: nowrap;
  transform: translate(-50%, -120%);
}
.add-map-tooltip.add-map-tooltip-show {
  opacity: 1;
}

/* 4.1 旅行日记 */
.add-diary-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 5px 12px;
  margin-top: 8px;
  background: rgba(240,192,64,0.15);
  border: 1px solid rgba(240,192,64,0.3);
  color: #f0c040;
  border-radius: 16px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}
.add-diary-btn:hover {
  background: rgba(240,192,64,0.25);
  transform: translateY(-1px);
}
.add-diary-area {
  margin-top: 8px;
  display: none;
}
.add-diary-area.add-diary-open {
  display: block;
  animation: addFadeUp 0.3s ease-out;
}
.add-diary-textarea {
  width: 100%;
  min-height: 60px;
  padding: 8px 10px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(240,192,64,0.25);
  border-radius: 8px;
  color: var(--text-main, #e8ecf8);
  font-size: 12px;
  font-family: inherit;
  resize: vertical;
  box-sizing: border-box;
}
.add-diary-textarea:focus {
  outline: none;
  border-color: #f0c040;
}
.add-diary-status {
  font-size: 10px;
  color: rgba(240,192,64,0.7);
  margin-top: 4px;
}

/* 4.2 景点打卡 */
.add-checkin-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 10px;
  margin-left: 8px;
  background: rgba(0,212,170,0.1);
  border: 1px solid rgba(0,212,170,0.3);
  color: #00d4aa;
  border-radius: 12px;
  font-size: 10px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  vertical-align: middle;
  position: relative;
  z-index: 1;
}
@media (max-width: 768px) {
  .add-checkin-btn {
    font-size: 11px;
    padding: 4px 12px;
    margin-left: 6px;
    margin-top: 4px;
  }
  .add-checkin-badge {
    width: 16px;
    height: 16px;
    line-height: 16px;
    font-size: 10px;
  }
}
.add-checkin-btn:hover {
  background: rgba(0,212,170,0.2);
}
.add-checkin-btn.add-checkin-done {
  background: rgba(0,212,170,0.25);
  border-color: #00d4aa;
  color: #00d4aa;
}
.add-checkin-badge {
  display: inline-block;
  width: 14px;
  height: 14px;
  background: #00d4aa;
  color: #0a0e27;
  border-radius: 50%;
  font-size: 9px;
  text-align: center;
  line-height: 14px;
  font-weight: 900;
  margin-left: 4px;
  vertical-align: middle;
}


/* 手机端地图hover修复 - 防止触屏粘住 */
@media (max-width: 768px) {
  .route-map circle.route-node:hover {
    filter: url(#nodeGlow);
    r: 9;
  }
}
@media (hover: none) and (pointer: coarse) {
  .route-map circle.route-node:hover {
    filter: url(#nodeGlow);
    r: 9;
  }
  .add-map-tooltip {
    display: none !important;
  }
}


/* 手机端地图直接显示，不依赖动画触发 */
@media (max-width: 768px) {
  .route-map-container .route-path {
    stroke-dashoffset: 0 !important;
    animation: none !important;
  }
  .route-map-container .route-node {
    opacity: 1 !important;
    animation: none !important;
  }
}


/* 手机端折叠展开后内容强制可见 */
@media (max-width: 768px) {
  .mobile-accordion:not(.accordion-collapsed) .fade-in {
    opacity: 1 !important;
    transform: none !important;
  }
  .mobile-accordion:not(.accordion-collapsed) .stagger-in:not(.visible) {
    opacity: 1 !important;
    transform: none !important;
  }
  .mobile-accordion:not(.accordion-collapsed) .v3-slide-in:not(.v3-visible) {
    opacity: 1 !important;
    transform: none !important;
  }
}

/* ===== 新增样式结束 ===== */


/* ===== V16 Portal View System ===== */

/* --- Entry Grid (Layer 1 - Main Interface) --- */
.add-entry-grid {
  position: relative;
  z-index: 2;
  max-width: 800px;
  margin: 0 auto;
  padding: 40px 20px 60px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
.add-entry-card {
  background: rgba(15, 22, 50, 0.75);
  border: 1px solid rgba(0, 212, 170, 0.12);
  border-radius: 16px;
  padding: 24px 16px;
  text-align: center;
  cursor: pointer;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
  position: relative;
  overflow: hidden;
}
.add-entry-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--primary), transparent);
  opacity: 0;
  transition: opacity 0.3s;
}
.add-entry-card:active,
.add-entry-card:hover {
  transform: scale(1.04);
  background: rgba(22, 32, 65, 0.9);
  border-color: rgba(0, 212, 170, 0.35);
}
.add-entry-card:active::after,
.add-entry-card:hover::after {
  opacity: 1;
}
.add-entry-card-emoji {
  font-size: 2.2rem;
  display: block;
  margin-bottom: 8px;
  line-height: 1.2;
}
.add-entry-card-title {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-main);
  letter-spacing: 0.5px;
}
.add-entry-card-sub {
  font-size: 0.75rem;
  color: var(--text-dim);
  margin-top: 4px;
}

/* --- Portal Overlay --- */
.add-portal-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 10000;
  background: var(--bg-dark);
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  will-change: transform;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  display: none;
}
.add-portal-overlay.add-portal-open {
  transform: translateY(0);
}
.add-portal-overlay.add-portal-closing {
  transform: translateY(-20%);
  opacity: 0;
  transition: transform 0.3s ease-in, opacity 0.3s ease-in;
}

.add-portal-content {
  min-height: calc(100vh - 56px);
  padding-bottom: 20px;
}

/* --- Portal Header (Immersive) --- */
.add-portal-header {
  position: relative;
  padding: 44px 20px 16px;
  text-align: center;
  min-height: 80px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  background: linear-gradient(180deg, #1a2332 0%, #0f172a 100%);
}
.add-portal-header-emoji {
  display: none;
}
.add-portal-back {
  position: absolute;
  left: 16px;
  top: 16px;
  background: rgba(0,0,0,0.3);
  border: none;
  color: #fff;
  font-size: 0.85rem;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: 50px;
  cursor: pointer;
  z-index: 2;
  -webkit-tap-highlight-color: transparent;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.add-portal-back:active {
  transform: scale(0.95);
  background: rgba(0,0,0,0.5);
}
.add-portal-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #fff;
  margin: 0;
  position: relative;
  z-index: 1;
}
.add-portal-subtitle {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.7);
  margin-top: 4px;
  position: relative;
  z-index: 1;
}

/* --- Portal Bottom Nav --- */
.add-portal-nav {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 56px;
  background: rgba(10,14,39,0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: none;
  justify-content: space-around;
  align-items: center;
  z-index: 10001;
  border-top: 1px solid rgba(0,212,170,0.1);
}
.add-portal-nav.add-nav-visible {
  display: flex;
}
.add-portal-nav-item {
  font-size: 1.3rem;
  background: none;
  border: none;
  padding: 8px;
  cursor: pointer;
  opacity: 0.5;
  transition: opacity 0.2s, transform 0.2s;
  -webkit-tap-highlight-color: transparent;
}
.add-portal-nav-item.add-nav-active {
  opacity: 1;
  transform: scale(1.2);
}
.add-portal-nav-item:active {
  transform: scale(0.9);
}

/* --- Portal Content Animations --- */
.add-portal-section-enter {
  animation: addPortalFadeIn 0.25s ease forwards;
}
@keyframes addPortalFadeIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

/* --- Portal: hide original section-header when inside portal --- */
.add-in-portal > .section-header,
.add-in-portal > .route-switcher {
  display: none !important;
}

/* --- Portal: force expand accordion --- */
.add-in-portal .accordion-trigger {
  display: none !important;
}
.add-in-portal .accordion-body {
  display: block !important;
}
.add-in-portal .accordion-body-inner {
  overflow: visible !important;
  min-height: auto !important;
  border: none !important;
}
.add-in-portal.accordion-collapsed .accordion-body {
  grid-template-rows: 1fr !important;
}

/* --- Portal: itinerary day card summary mode --- */
.add-in-portal.add-itin-summary .day-card .itinerary-body {
  display: none;
}
.add-in-portal.add-itin-summary .day-card.add-day-expanded .itinerary-body {
  display: block;
}
.add-in-portal.add-itin-summary .day-card .itinerary-header {
  cursor: pointer;
}

/* --- Portal: hide dividers inside portal content --- */
.add-in-portal .mountain-divider,
.add-in-portal .wave-divider {
  display: none !important;
}

/* --- Mobile only: portal active --- */
@media (max-width: 768px) {
  .add-portal-overlay {
    display: block;
  }
  .add-in-portal .section {
    padding-top: 0;
  }
  /* V20: 手机端默认隐藏内容板块，只通过入口卡片+门户视图访问 */
  #add-sections-wrapper {
    display: none;
  }
}

/* --- Desktop: grid hidden, sections always visible, no portal --- */
@media (min-width: 769px) {
  .add-entry-grid {
    display: none;
  }
  .add-portal-overlay {
    display: none !important;
  }
  .add-portal-nav {
    display: none !important;
  }
}


/* --- V17: Level 3+ Header (更精简) --- */
.add-portal-header.add-header-l3 {
  padding: 44px 20px 12px;
  min-height: 56px;
  background: #0f172a;
}
.add-header-l3 .add-portal-subtitle {
  display: none;
}
.add-header-l3 .add-portal-title {
  font-size: 1.1rem;
}

/* --- V17: L2 Itinerary - 所有day-card折叠，header可点击钻入L3 --- */
.add-itin-l2 .day-card .itinerary-body {
  display: none !important;
}
.add-itin-l2 .day-card .itinerary-header {
  cursor: pointer;
  position: relative;
}
.add-itin-l2 .day-card .itinerary-header .toggle-icon {
  display: none;
}
.add-itin-l2 .day-card .itinerary-header::after {
  content: '\203a';
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 1.6rem;
  color: var(--primary);
  opacity: 0.6;
}
.add-itin-l2 .itinerary-card.open .itinerary-body {
  display: none !important;
}

/* --- V17: L3 单天展开样式 --- */
.add-day-expanded .itinerary-body {
  display: block !important;
}

/* --- V17: L3+ 隐藏底部导航 --- */
.add-header-l3 ~ .add-portal-nav,
.add-portal-overlay.add-no-bottom-nav .add-portal-nav {
  display: none !important;
}

/* ===== V17 Portal View System End ===== */


/* ========== Must-Do Detail Modal ========== */
.must-do-modal {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.must-do-modal-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.85);
  backdrop-filter: blur(8px);
}
.must-do-modal-content {
  position: relative;
  z-index: 1;
  width: 92%;
  max-width: 600px;
  max-height: 85vh;
  background: linear-gradient(180deg, #1a2332, #0f172a);
  border: 1px solid rgba(0,212,170,0.15);
  border-radius: 16px;
  overflow-y: auto;
  padding: 24px 20px;
}
.must-do-modal-close {
  position: absolute;
  top: 12px; right: 16px;
  background: none;
  border: none;
  color: #fff;
  font-size: 1.4rem;
  cursor: pointer;
  z-index: 2;
  padding: 4px 8px;
}
.must-do-modal-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}
.must-do-modal-emoji { font-size: 2rem; }
.must-do-modal-title {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text-main);
  margin: 0;
}
.must-do-modal-desc {
  font-size: 0.9rem;
  color: var(--text-sub);
  line-height: 1.7;
  margin-bottom: 16px;
}
.must-do-modal-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}
.must-do-modal-images img {
  width: calc(50% - 4px);
  max-height: 180px;
  object-fit: cover;
  border-radius: 8px;
  border: 1px solid var(--border);
  cursor: pointer;
}
.must-do-modal-video {
  margin-bottom: 16px;
}
.must-do-modal-video iframe {
  width: 100%;
  height: 200px;
  border: none;
  border-radius: 8px;
}
.must-do-modal-video a {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,107,53,0.15);
  border: 1px solid rgba(255,107,53,0.3);
  color: var(--accent);
  border-radius: 8px;
  padding: 6px 14px;
  font-size: 0.85rem;
  text-decoration: none;
}
.must-do-modal-tips {
  background: rgba(0,212,170,0.08);
  border: 1px solid rgba(0,212,170,0.15);
  border-radius: 8px;
  padding: 12px;
  font-size: 0.82rem;
  color: var(--text-sub);
  line-height: 1.6;
}
.must-do-modal-tips::before {
  content: '💡 小贴士';
  display: block;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 6px;
}
@media (max-width: 768px) {
  .must-do-modal-content {
    width: 96%;
    padding: 20px 16px;
    max-height: 90vh;
  }
  .must-do-modal-images img {
    width: 100%;
  }
}

</style>
</head>
<body>

<!-- #10 骨架屏 -->
<div id="skeleton">
  <div class="skeleton-logo">🏔️ 黔山秘境</div>
  <div class="skeleton-block skeleton-hero"></div>
  <div class="skeleton-block skeleton-sub"></div>
  <div class="skeleton-cards">
    <div class="skeleton-block"></div>
    <div class="skeleton-block"></div>
    <div class="skeleton-block"></div>
  </div>
  <div class="skeleton-block skeleton-section"></div>
  <div class="skeleton-block skeleton-section" style="width:70%"></div>
</div>

<!-- #15 主题切换按钮 -->
<button id="theme-toggle" class="theme-toggle" aria-label="切换主题">🌙</button>

<!-- 阅读进度条 -->
<div class="reading-progress" id="reading-progress"></div>

<!-- Canvas 粒子层 -->
<!-- particle-canvas 已移除(V6性能优化) -->

<!-- 背景图层 -->
<div id="bg-layers">
  <div class="bg-layer" data-section="hero" data-speed="0.2" style="background-image: url('https://s.coze.cn/image/R5jpc5u0bjM/');"></div>
  <div class="bg-layer" data-section="route" data-speed="0.35" style="background-image: url('https://s.coze.cn/image/dc3Lqd04vW8/');"></div>
  <div class="bg-layer" data-section="itinerary" data-speed="0.35" style="background-image: url('https://s.coze.cn/image/PkfkuP49UsA/');"></div>
  <div class="bg-layer" data-section="drone" data-speed="0.5" style="background-image: url('https://s.coze.cn/image/EhDWB1jXPOA/');"></div>
  <div class="bg-layer" data-section="summary" data-speed="0.2" style="background-image: url('https://s.coze.cn/image/zRIZsNhCC60/');"></div>
  <div class="bg-layer" data-section="budget" data-speed="0.35" style="background-image: url('https://s.coze.cn/image/IgchC51Jup8/');"></div>
  <div class="bg-layer" data-section="temperature" data-speed="0.35" style="background-image: url('https://s.coze.cn/image/ZMq4z5J4EM4/');"></div>
  <div class="bg-layer" data-section="checklist" data-speed="0.5" style="background-image: url('https://s.coze.cn/image/LQpTitvSvb0/');"></div>
</div>
<div class="bg-overlay"></div>

<!-- ========== 底部悬浮导航 ========== -->
<nav class="floating-nav" id="floatingNav">
  <a href="#hero" class="fn-item active" data-target="hero">🏠</a>
  <a href="#route" class="fn-item" data-target="route">🗺️</a>
  <a href="#itinerary" class="fn-item" data-target="itinerary">📋</a>
  <a href="#temperature" class="fn-item" data-target="temperature">🌡️</a>
  <a href="#budget" class="fn-item" data-target="budget">💰</a>
  <a href="#drone" class="fn-item" data-target="drone">🚁</a>
  <a href="#checklist" class="fn-item" data-target="checklist">✅</a>
  <a href="#summary" class="fn-item" data-target="summary">🎣</a>
  <a href="#tips" class="fn-item" data-target="tips">🚗</a>
</nav>

<!-- ========== Hero 区 ========== -->
<section class="hero" id="hero">
  <div class="hero-badge">
    <span class="dot"></span>
    <span>2026暑期 · 贵州避暑自驾</span>
  </div>
  <h1 class="hero-title">
    <span class="gradient-text">黔山秘境</span><br>
    7天6晚自驾之旅
  </h1>
  <p class="hero-subtitle">
    <span class="tag">👨‍👩‍👧‍👦 4大2小</span>
    <span class="tag">🚗 自驾2000km</span>
    <span class="tag">🚁 DJI Mini 4 Pro</span>
    <span class="tag">🚁 DJI Air 3S</span>
    <span class="tag">⛰️ 湖南洞口出发</span>
    <span class="tag alt-route-tag" id="heroAltTag" style="display:none">🌿 小众避暑路线</span>
    <br><br>
    洞口 → 凤凰 → 贵阳 → 黄果树 → 织金洞 → 毕节 → 六盘水 → 兴义 → 返程
  </p>

  <div class="countdown-wrapper">
    <div class="countdown-label">⏰ 距离出发还有</div>
    <div class="countdown-grid" id="countdown">
      <div class="countdown-cell">
        <div class="countdown-digit" id="cd-days">--</div>
        <div class="countdown-cell-unit">天</div>
      </div>
      <div class="countdown-cell">
        <div class="countdown-digit" id="cd-hours">--</div>
        <div class="countdown-cell-unit">时</div>
      </div>
      <div class="countdown-cell">
        <div class="countdown-digit" id="cd-mins">--</div>
        <div class="countdown-cell-unit">分</div>
      </div>
      <div class="countdown-cell">
        <div class="countdown-digit" id="cd-secs">--</div>
        <div class="countdown-cell-unit">秒</div>
      </div>
    </div>
  </div>

  <div class="hero-info-row">
    <div class="hero-info-item"><span class="icon">📅</span> 8月8日 - 8月14日</div>
    <div class="hero-info-item"><span class="icon">🌡️</span> 均温14-26℃</div>
    <div class="hero-info-item"><span class="icon">💰</span> 预算约6000-8000元</div>
    <div class="hero-info-item"><span class="icon">🏨</span> 6晚·2间房</div>
  </div>

  <div class="scroll-hint">
    <span>向下滚动探索行程</span>
    <span style="font-size: var(--fs-xl);">⌄</span>
  </div>

  <!-- 山脉剪影 -->
  <div class="mountain-silhouette">
    <svg viewBox="0 0 1440 200" preserveAspectRatio="none">
      <path d="M0,200 L0,140 L120,80 L200,120 L320,60 L420,100 L520,50 L640,90 L760,40 L880,80 L1000,50 L1120,100 L1240,60 L1360,110 L1440,80 L1440,200 Z" fill="rgba(0,212,170,0.06)"/>
      <path d="M0,200 L0,160 L100,110 L220,140 L360,90 L480,130 L600,80 L720,120 L840,70 L960,110 L1080,80 L1200,130 L1320,90 L1440,120 L1440,200 Z" fill="rgba(0,212,170,0.1)"/>
      <path d="M0,200 L0,180 L160,140 L300,170 L440,130 L580,160 L720,120 L860,150 L1000,110 L1140,150 L1280,120 L1440,160 L1440,200 Z" fill="rgba(10,14,39,0.8)"/>
    </svg>
  </div>
</section>


<!-- ===== V14 入口卡片网格 (Layer 1) ===== -->
<div class="add-entry-grid" id="add-entry-grid">
  <div class="add-entry-card" data-target="route">
    <span class="add-entry-card-emoji">🗺️</span>
    <div class="add-entry-card-title">路线总览</div>
    <div class="add-entry-card-sub">7天环线 · 2000km</div>
  </div>
  <div class="add-entry-card" data-target="itinerary">
    <span class="add-entry-card-emoji">📅</span>
    <div class="add-entry-card-title">每日行程</div>
    <div class="add-entry-card-sub">7天6晚详情</div>
  </div>
  <div class="add-entry-card" data-target="temperature">
    <span class="add-entry-card-emoji">🌡️</span>
    <div class="add-entry-card-title">气温对比</div>
    <div class="add-entry-card-sub">避暑14-26℃</div>
  </div>
  <div class="add-entry-card" data-target="budget">
    <span class="add-entry-card-emoji">💰</span>
    <div class="add-entry-card-title">预算</div>
    <div class="add-entry-card-sub">6000-8000元</div>
  </div>
  <div class="add-entry-card" data-target="drone">
    <span class="add-entry-card-emoji">🚁</span>
    <div class="add-entry-card-title">航拍</div>
    <div class="add-entry-card-sub">飞行指南</div>
  </div>
  <div class="add-entry-card" data-target="checklist">
    <span class="add-entry-card-emoji">✅</span>
    <div class="add-entry-card-title">行前清单</div>
    <div class="add-entry-card-sub">12项待确认</div>
  </div>
  <div class="add-entry-card" data-target="summary">
    <span class="add-entry-card-emoji">👨‍👩‍👧‍👦</span>
    <div class="add-entry-card-title">亲子野钓</div>
    <div class="add-entry-card-sub">活动汇总</div>
  </div>
  <div class="add-entry-card" data-target="must-do">
    <span class="add-entry-card-emoji">✨</span>
    <div class="add-entry-card-title">此行必做</div>
    <div class="add-entry-card-sub">8个必体验</div>
  </div>
</div>

<!-- V16: 浮动返回按钮已移除，改用门户视图系统 -->


<div id="add-sections-wrapper">
<!-- 山脉分隔 -->
<div class="mountain-divider">
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
    <path d="M0,60 L0,30 L180,10 L360,35 L540,15 L720,40 L900,12 L1080,35 L1260,15 L1440,30 L1440,60 Z" fill="rgba(0,212,170,0.05)"/>
  </svg>
</div>

<!-- ========== 路线总览 ========== -->
<div class="wave-divider">
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
    <path d="M0,30 C360,60 720,0 1080,30 C1260,45 1380,45 1440,30 L1440,60 L0,60 Z" fill="rgba(0,212,170,0.08)"/>
  </svg>
</div>
<section class="section mobile-accordion" id="route">
  <div class="route-switcher" id="routeSwitcher">
    <button class="route-tab active" onclick="switchRoute('main')" id="tab-main">
      <span class="tab-icon">🏔️</span> 经典主路线
    </button>
    <button class="route-tab" onclick="switchRoute('alt')" id="tab-alt">
      <span class="tab-icon">🌿</span> 小众避暑路线
    </button>
  </div>
  <div class="section-header fade-in">
    <span class="section-icon">🗺️</span>
    <h2 class="section-title">路线<span class="primary">总览</span></h2>
    <div class="section-title-underline"></div>
    <p class="section-subtitle">从湖南洞口出发，穿越黔东南到黔西南，7天环线领略贵州山水秘境</p>
  </div>
  <div id="route-main-content">
<div class="route-map-container fade-in" id="routeMapContainer">
    <svg viewBox="0 0 800 600" class="route-map" style="background:rgba(10,14,39,0.3);border-radius:12px;">
      <defs>
        <linearGradient id="routeGradient" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#00d4aa"/>
          <stop offset="50%" stop-color="#f0c040"/>
          <stop offset="100%" stop-color="#ff6b35"/>
        </linearGradient>
        <filter id="nodeGlow"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="url(#routeGradient)"/></marker>
        <marker id="arrowReturn" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto"><polygon points="0 0, 8 3, 0 6" fill="rgba(240,192,64,0.6)"/></marker>
      </defs>

