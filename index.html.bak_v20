      <text x="300" y="40" fill="rgba(46,204,113,0.3)" font-size="9">贵州小众避暑路线 ALT ROUTE</text>

      <!-- 行程连线 -->
      <path class="route-path" d="M310,220 L250,180 L200,250 L160,300 L280,350 L350,320 L400,280"
        fill="none" stroke="url(#altRouteGradient)" stroke-width="3" stroke-linecap="round"
        stroke-dasharray="8,4" marker-end="url(#altArrow)" opacity="0.9"/>
      <!-- 返程虚线 -->
      <path d="M400,280 Q300,200 310,220" fill="none" stroke="rgba(240,192,64,0.4)" stroke-width="2"
        stroke-dasharray="5,5" marker-end="url(#altArrowReturn)"/>
      <text x="320" y="200" fill="rgba(240,192,64,0.5)" font-size="9">返程</text>

      <!-- D1 织金 -->
      <circle class="route-node" cx="312.6" cy="326.7" r="9" fill="#2ecc71" filter="url(#altNodeGlow)"/>
      <circle cx="312.6" cy="326.7" r="14" fill="none" stroke="#2ecc71" stroke-width="1.5" opacity="0.3"/>
      <rect x="325" y="208" width="80" height="18" rx="5" fill="rgba(15,22,50,0.85)" stroke="rgba(46,204,113,0.3)" stroke-width="1"/>
      <text x="332" y="221" fill="#2ecc71" font-size="10" font-weight="700">D1 织金洞</text>

      <!-- D2 九洞天/大方 -->
      <circle class="route-node" cx="250" cy="180" r="8" fill="#00d4aa" filter="url(#altNodeGlow)"/>
      <circle cx="250" cy="180" r="13" fill="none" stroke="#00d4aa" stroke-width="1.5" opacity="0.3"/>
      <rect x="100" y="168" width="100" height="18" rx="5" fill="rgba(15,22,50,0.85)" stroke="rgba(0,212,170,0.3)" stroke-width="1"/>
      <text x="108" y="181" fill="#00d4aa" font-size="10" font-weight="700">D2 九洞天·大方</text>

      <!-- D3 威宁 -->
      <circle class="route-node" cx="200" cy="250" r="8" fill="#4a90d9" filter="url(#altNodeGlow)"/>
      <circle cx="200" cy="250" r="13" fill="none" stroke="#4a90d9" stroke-width="1.5" opacity="0.3"/>
      <rect x="70" y="260" width="80" height="18" rx="5" fill="rgba(15,22,50,0.85)" stroke="rgba(74,144,217,0.3)" stroke-width="1"/>
      <text x="78" y="273" fill="#4a90d9" font-size="10" font-weight="700">D3 威宁</text>

      <!-- D4 六枝 -->
      <circle class="route-node" cx="160" cy="300" r="8" fill="#9b59b6" filter="url(#altNodeGlow)"/>
      <circle cx="160" cy="300" r="13" fill="none" stroke="#9b59b6" stroke-width="1.5" opacity="0.3"/>
      <rect x="50" y="310" width="80" height="18" rx="5" fill="rgba(15,22,50,0.85)" stroke="rgba(155,89,182,0.3)" stroke-width="1"/>
      <text x="58" y="323" fill="#9b59b6" font-size="10" font-weight="700">D4 六枝</text>

      <!-- D5 紫云 -->
      <circle class="route-node" cx="280" cy="350" r="8" fill="#e67e22" filter="url(#altNodeGlow)"/>
      <circle cx="280" cy="350" r="13" fill="none" stroke="#e67e22" stroke-width="1.5" opacity="0.3"/>
      <rect x="295" y="338" width="80" height="18" rx="5" fill="rgba(15,22,50,0.85)" stroke="rgba(230,126,34,0.3)" stroke-width="1"/>
      <text x="302" y="351" fill="#e67e22" font-size="10" font-weight="700">D5 紫云</text>

      <!-- D6 安顺 -->
      <circle class="route-node" cx="350" cy="320" r="8" fill="#f0c040" filter="url(#altNodeGlow)"/>
      <circle cx="350" cy="320" r="13" fill="none" stroke="#f0c040" stroke-width="1.5" opacity="0.3"/>
      <rect x="365" y="308" width="80" height="18" rx="5" fill="rgba(15,22,50,0.85)" stroke="rgba(240,192,64,0.3)" stroke-width="1"/>
      <text x="372" y="321" fill="#f0c040" font-size="10" font-weight="700">D6 安顺</text>

      <!-- D7 返程 -->
      <circle class="route-node" cx="400" cy="280" r="8" fill="#ff6b35" filter="url(#altNodeGlow)"/>
      <circle cx="400" cy="280" r="13" fill="none" stroke="#ff6b35" stroke-width="1.5" opacity="0.3"/>
      <rect x="415" y="268" width="80" height="18" rx="5" fill="rgba(15,22,50,0.85)" stroke="rgba(255,107,53,0.3)" stroke-width="1"/>
      <text x="422" y="281" fill="#ff6b35" font-size="10" font-weight="700">D7 返程</text>

      <!-- 指北针 -->
      <g transform="translate(720,60)">
        <circle cx="0" cy="0" r="24" fill="rgba(15,22,50,0.7)" stroke="rgba(46,204,113,0.3)" stroke-width="1.5"/>
        <polygon points="0,-18 -6,6 0,2 6,6" fill="#ff6b35"/>
        <polygon points="0,18 -6,-6 0,-2 6,-6" fill="rgba(255,255,255,0.3)"/>
