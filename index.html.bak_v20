// V4: SVG路线地图动画触发
(function() {
  var routeMap = document.getElementById('routeMapContainer');
  if (!routeMap) return;
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        routeMap.classList.add('visible');
      }
    });
  }, { threshold: 0.2 });
  observer.observe(routeMap);
})();


// ============================================================
// V4-B2 #7: 板块色彩主题动态变化
// ============================================================
(function() {
  var sectionColors = {
    'hero': { accent: '#00d4aa', glow: 'rgba(0,212,170,0.4)' },
    'route': { accent: '#00d4aa', glow: 'rgba(0,212,170,0.4)' },
    'itinerary': { accent: '#4a90d9', glow: 'rgba(74,144,217,0.4)' },
    'temperature': { accent: '#ff6b35', glow: 'rgba(255,107,53,0.4)' },
    'budget': { accent: '#f0c040', glow: 'rgba(240,192,64,0.4)' },
    'drone': { accent: '#9b59b6', glow: 'rgba(155,89,182,0.4)' },
    'checklist': { accent: '#2ecc71', glow: 'rgba(46,204,113,0.4)' },
    'summary': { accent: '#00d4aa', glow: 'rgba(0,212,170,0.4)' }
  };

  var sectionIds = ['hero', 'route', 'itinerary', 'temperature', 'budget', 'drone', 'checklist', 'summary'];
  var sectionEls = sectionIds.map(function(id) { return document.getElementById(id); }).filter(Boolean);

  var colorObserver = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        var id = entry.target.id;
        var color = sectionColors[id];
        if (color) {
          document.documentElement.style.setProperty('--section-accent', color.accent);
          document.documentElement.style.setProperty('--section-accent-glow', color.glow);
        }
      }
    });
  }, { threshold: 0.3 });

  sectionEls.forEach(function(el) { colorObserver.observe(el); });
})();

