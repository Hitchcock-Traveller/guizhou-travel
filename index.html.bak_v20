<section class="section mobile-accordion" id="budget">
  <div class="section-header fade-in">
    <span class="section-icon">💰</span>
    <h2 class="section-title">预算<span class="accent">计算器</span></h2>
    <div class="section-title-underline"></div>
    <p class="section-subtitle">总预算上限8000元（6人·2间房），拖动滑块调整各项预算，绿色区间为6000-8000元</p>
  </div>

  <div id="budget-main-content">
  <div class="budget-container fade-in">
    <div class="budget-grid">
      <div class="budget-items">
        <div class="budget-item">
          <div class="budget-item-header">
            <div class="budget-item-title">⛽ 油费+过路费</div>
          </div>
          <div class="budget-range">
            <label>低</label>
            <input type="range" id="budget-fuel" min="1200" max="1800" value="1500" step="50">
            <label>高</label>
            <span class="budget-value" id="fuel-val">¥1500</span>
          </div>
        </div>
        <div class="budget-item">
          <div class="budget-item-header">
            <div class="budget-item-title">🏨 住宿（6晚·2间房）</div>
          </div>
          <div class="budget-range">
            <label>低</label>
            <input type="range" id="budget-hotel" min="2800" max="5500" value="3500" step="100">
            <label>高</label>
            <span class="budget-value" id="hotel-val">¥3500</span>
          </div>
        </div>
        <div class="budget-item">
          <div class="budget-item-header">
            <div class="budget-item-title">🎟️ 门票+索道（6人·儿童半价）</div>
          </div>
          <div class="budget-range">
            <label>低</label>
            <input type="range" id="budget-tickets" min="500" max="1200" value="800" step="50">
            <label>高</label>
            <span class="budget-value" id="tickets-val">¥800</span>
          </div>
        </div>
        <div class="budget-item">
          <div class="budget-item-header">
            <div class="budget-item-title">🍴 餐饮（7天·6人）</div>
          </div>
          <div class="budget-range">
            <label>低</label>
            <input type="range" id="budget-food" min="1200" max="2500" value="1700" step="100">
            <label>高</label>
            <span class="budget-value" id="food-val">¥1700</span>
          </div>
        </div>
      </div>

      <div class="budget-summary">
        <div class="budget-summary-label">预计总花费（6人）</div>
        <div class="budget-total" id="budget-total">¥7,500</div>
        <div class="budget-total-unit">总预算上限 8000元</div>
        <div class="budget-per-person">人均约 <strong id="budget-per-person">¥1,250</strong> / 人</div>

        <div class="budget-progress-wrap">
          <div class="budget-progress-track">
            <div class="budget-progress-green-zone"></div>
            <div class="budget-progress-fill" id="budget-progress-fill"></div>
          </div>
          <div class="budget-progress-labels">
            <span>¥4,000</span>
            <span class="green">¥6,000 - ¥8,000 目标区间</span>
            <span>¥10,000</span>
          </div>
        </div>

        <div class="budget-breakdown" id="budget-breakdown"></div>

        <!-- #12 预算滑块+环形图 -->
        <div class="budget-slider-section">
          <label>调整总预算: <span id="budget-slider-total">¥7,500</span></label>
          <input type="range" id="budget-slider" min="3000" max="12000" value="7500" step="100">
          <div class="budget-ring-wrapper">
            <div class="budget-ring" id="budget-ring" style="background: conic-gradient(#4a90d9 0% 20%, #2ecc71 20% 66.7%, #9b59b6 66.7% 77.3%, #f0c040 77.3% 100%);">
              <div class="budget-ring-center">
                <div class="ring-total" id="ring-total">¥7,500</div>
                <div class="ring-label">总预算</div>
              </div>
            </div>
            <div class="budget-ring-legend">
              <div class="ring-legend-item"><div class="ring-legend-dot" style="background:#4a90d9"></div>油费 ¥1,500</div>
              <div class="ring-legend-item"><div class="ring-legend-dot" style="background:#2ecc71"></div>住宿 ¥3,500</div>
              <div class="ring-legend-item"><div class="ring-legend-dot" style="background:#9b59b6"></div>门票 ¥800</div>
              <div class="ring-legend-item"><div class="ring-legend-dot" style="background:#f0c040"></div>餐饮 ¥1,700</div>
            </div>
          </div>
        </div>
      </div>
    </div>
