  ],
  itinerary: [
    { src: 'https://s.coze.cn/image/PkfkuP49UsA/', caption: '万峰林八卦田 - 贵州最佳航拍地之一' }
  ],
  temperature: [
    { src: 'https://s.coze.cn/image/ZMq4z5J4EM4/', caption: '乌蒙草原全景 - 盛夏均温仅14-20度' }
  ],
  budget: [
    { src: 'https://s.coze.cn/image/IgchC51Jup8/', caption: '草原全景 - 性价比最高的避暑胜地' }
  ],
  drone: [
    { src: 'https://s.coze.cn/image/EhDWB1jXPOA/', caption: '乌蒙草原俯瞰 - 无人机航拍绝佳取景地' }
  ],
  checklist: [
    { src: 'https://s.coze.cn/image/LQpTitvSvb0/', caption: '织金洞 - 织金归来不看洞' }
  ]
};

var allLightboxImages = [];
var sectionOrder = ['hero', 'route', 'itinerary', 'temperature', 'budget', 'drone', 'checklist'];
sectionOrder.forEach(function(key) {
  if (lightboxGalleries[key]) {
    lightboxGalleries[key].forEach(function(img) { allLightboxImages.push(img); });
  }
});

function openLightbox(sectionKey, startIndex) {
  lightboxImages = allLightboxImages;
  currentLightboxIndex = (startIndex !== undefined) ? startIndex : 0;
  showLightboxImage();
  document.getElementById('lightbox').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function closeLightbox() {
  document.getElementById('lightbox').style.display = 'none';
  document.body.style.overflow = '';
}

function navigateLightbox(dir) {
  currentLightboxIndex = (currentLightboxIndex + dir + lightboxImages.length) % lightboxImages.length;
  showLightboxImage();
}

function showLightboxImage() {
  var item = lightboxImages[currentLightboxIndex];
  document.getElementById('lightbox-img').src = item.src;
  document.getElementById('lightbox-caption').textContent = item.caption || '';
}

document.addEventListener('keydown', function(e) {
  if (document.getElementById('lightbox').style.display === 'none') return;
  if (e.key === 'Escape') closeLightbox();
  if (e.key === 'ArrowLeft') navigateLightbox(-1);
  if (e.key === 'ArrowRight') navigateLightbox(1);
});

// lightbox-overlay在script之后定义，用事件委托避免null引用
document.addEventListener('click', function(e) {
  if (e.target.classList.contains('lightbox-overlay')) closeLightbox();
});

(function() {
  var btnMap = {
    hero: { selector: '.hero-subtitle', index: 0 },
    route: { selector: '#route .section-subtitle', index: 1 },
    itinerary: { selector: '#itinerary .section-subtitle', index: 2 },
    temperature: { selector: '#temperature .section-subtitle', index: 3 },
    budget: { selector: '#budget .section-subtitle', index: 4 },
    drone: { selector: '#drone .section-subtitle', index: 5 },
    checklist: { selector: '#checklist .section-subtitle', index: 6 }
  };
  Object.keys(btnMap).forEach(function(key) {
    var info = btnMap[key];
    var el = document.querySelector(info.selector);
    if (el) {
      var btn = document.createElement('button');
      btn.className = 'view-full-btn';
      btn.innerHTML = '&#128444;&#65039; 查看大图';
      btn.onclick = function() { openLightbox(key, info.index); };
      el.parentNode.insertBefore(btn, el.nextSibling);
    }
  });
})();

// ============================================================
// V4-B2 #9: 温度横向条形图动画
// ============================================================
(function() {
  var tempBars = document.getElementById('tempBarsUpgraded');
  if (!tempBars) return;
  var tempAnimated = false;
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting && !tempAnimated) {
        tempAnimated = true;
        tempBars.classList.add('visible');
      } else if (!entry.isIntersecting) {
        tempAnimated = false;
        tempBars.classList.remove('visible');
      }
    });
  }, { threshold: 0.2 });
  observer.observe(tempBars);
})();

// ============================================================
// #10 骨架屏加载
// ============================================================
(function() {
  var loadStart = Date.now();
  var skeletonHidden = false;
  function hideSkeleton() {
    if (skeletonHidden) return;
    skeletonHidden = true;
    var sk = document.getElementById('skeleton');
    if (sk) {
      sk.classList.add('fade-out');
      setTimeout(function() { sk.classList.add('hidden'); }, 600);
    }
  }
  // 方案1: load事件触发
  window.addEventListener('load', function() {
    var elapsed = Date.now() - loadStart;
    var delay = Math.min(elapsed, 2000);
    setTimeout(hideSkeleton, delay);
  });
  // 方案2: 3秒兜底，防止背景图加载卡死load事件
  setTimeout(hideSkeleton, 3000);
})();

// ============================================================
// #12 预算滑块+环形图
// ============================================================
(function() {
  var slider = document.getElementById('budget-slider');
  if (!slider) return;

  var defaultRatios = { fuel: 1500/7500, hotel: 3500/7500, tickets: 800/7500, food: 1700/7500 };
  var colors = { fuel: '#4a90d9', hotel: '#2ecc71', tickets: '#9b59b6', food: '#f0c040' };
  var labels = { fuel: '油费', hotel: '住宿', tickets: '门票', food: '餐饮' };

  function updateBudgetSlider() {
    var total = parseInt(slider.value);
    var fuel = Math.round(total * defaultRatios.fuel);
    var hotel = Math.round(total * defaultRatios.hotel);
    var tickets = Math.round(total * defaultRatios.tickets);
    var food = total - fuel - hotel - tickets;

    // Update slider display
    var sliderTotalEl = document.getElementById('budget-slider-total');
    if (sliderTotalEl) sliderTotalEl.textContent = '¥' + total.toLocaleString();

    // Update ring center
    var ringTotalEl = document.getElementById('ring-total');
    if (ringTotalEl) ringTotalEl.textContent = '¥' + total.toLocaleString();

    // Calculate percentages
    var pFuel = (fuel / total * 100);
    var pHotel = (hotel / total * 100);
    var pTickets = (tickets / total * 100);
    var p1End = pFuel;
    var p2End = pFuel + pHotel;
    var p3End = pFuel + pHotel + pTickets;

    // Over-budget
    var ring = document.getElementById('budget-ring');
    if (total > 8000) {
      ring.style.background = 'conic-gradient(#ff4444 0% ' + p1End.toFixed(1) + '%, #cc3333 ' + p1End.toFixed(1) + '% ' + p2End.toFixed(1) + '%, #aa2222 ' + p2End.toFixed(1) + '% ' + p3End.toFixed(1) + '%, #882222 ' + p3End.toFixed(1) + '% 100%)';
      ring.classList.add('over-budget');
      setTimeout(function() { ring.classList.remove('over-budget'); }, 300);
      if (ringTotalEl) ringTotalEl.style.color = '#ff4444';
    } else {
      ring.style.background = 'conic-gradient(' + colors.fuel + ' 0% ' + p1End.toFixed(1) + '%, ' + colors.hotel + ' ' + p1End.toFixed(1) + '% ' + p2End.toFixed(1) + '%, ' + colors.tickets + ' ' + p2End.toFixed(1) + '% ' + p3End.toFixed(1) + '%, ' + colors.food + ' ' + p3End.toFixed(1) + '% 100%)';
      ring.classList.remove('over-budget');
      if (ringTotalEl) ringTotalEl.style.color = '';
    }

    // Update legend
    var legendItems = document.querySelectorAll('.ring-legend-item');
    var amounts = { fuel: fuel, hotel: hotel, tickets: tickets, food: food };
    var keys = ['fuel', 'hotel', 'tickets', 'food'];
    legendItems.forEach(function(item, i) {
      var key = keys[i];
      if (key && amounts[key] !== undefined) {
        var textNode = item.childNodes[item.childNodes.length - 1];
        if (textNode) textNode.textContent = labels[key] + ' ¥' + amounts[key].toLocaleString();
      }
    });

    // Sync individual sliders
    var bf = document.getElementById('budget-fuel');
    var bh = document.getElementById('budget-hotel');
    var bt = document.getElementById('budget-tickets');
    var bfo = document.getElementById('budget-food');
    if (bf) bf.value = Math.min(Math.max(fuel, 1200), 1800);
    if (bh) bh.value = Math.min(Math.max(hotel, 2800), 5500);
    if (bt) bt.value = Math.min(Math.max(tickets, 500), 1200);
    if (bfo) bfo.value = Math.min(Math.max(food, 1200), 2500);

    // Trigger budget update
    if (bf) bf.dispatchEvent(new Event('input'));
  }

  slider.addEventListener('input', updateBudgetSlider);
})();

// ============================================================
// #14 底部CTA + scrollToToday
// ============================================================
function scrollToToday() {
  var today = new Date();
  var startDate = new Date('2026-08-08');
  var dayIndex = Math.floor((today - startDate) / (1000 * 60 * 60 * 24));
  dayIndex = Math.max(0, Math.min(dayIndex, 6));
  var cards = document.querySelectorAll('.day-card');
  if (cards[dayIndex]) {
    cards[dayIndex].scrollIntoView({ behavior: 'smooth', block: 'start' });
  } else if (cards.length > 0) {
    cards[0].scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}


// ============================================================
// #15 暗/亮主题切换
// ============================================================
(function() {
  var toggle = document.getElementById('theme-toggle');
  if (!toggle) return;

  var saved = localStorage.getItem('theme') || 'dark';
  document.documentElement.setAttribute('data-theme', saved);
  toggle.textContent = saved === 'light' ? '☀️' : '🌙';

  toggle.addEventListener('click', function() {
    var current = document.documentElement.getAttribute('data-theme');
    var next = current === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', next);
    toggle.textContent = next === 'light' ? '☀️' : '🌙';
    localStorage.setItem('theme', next);
  });
})();

// ========== V7: 全面动态交互效果 ==========

// 2a: Ripple 点击水波纹效果
(function() {
  document.addEventListener('click', function(e) {
    var target = e.target.closest('.itinerary-header, .checklist-item, .drone-point, .tip-card, .meal-card, .hotel-card, .fn-item, .view-full-btn');
    if (!target) return;
    if (!target.classList.contains('ripple-effect')) target.classList.add('ripple-effect');
    var rect = target.getBoundingClientRect();
    var size = Math.max(rect.width, rect.height);
    var x = e.clientX - rect.left - size / 2;
    var y = e.clientY - rect.top - size / 2;
    var wave = document.createElement('span');
    wave.className = 'ripple-wave';
    wave.style.width = wave.style.height = size + 'px';
    wave.style.left = x + 'px';
    wave.style.top = y + 'px';
    target.appendChild(wave);
    setTimeout(function() { if (wave.parentNode) wave.parentNode.removeChild(wave); }, 600);
  });
})();

// 2b: 卡片悬浮3D倾斜效果
(function() {
  document.querySelectorAll('.itinerary-card, .drone-point, .tip-card, .meal-card, .hotel-card').forEach(function(card) {
    card.classList.add('tilt-hover');
    card.addEventListener('mousemove', function(e) {
      var rect = this.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;
      var centerX = rect.width / 2;
      var centerY = rect.height / 2;
      var rotateX = ((y - centerY) / centerY) * -4;
      var rotateY = ((x - centerX) / centerX) * 4;
      this.style.transform = 'perspective(800px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg) scale(1.02)';
      this.style.boxShadow = '0 8px 30px rgba(0,212,170,0.15)';
    });
    card.addEventListener('mouseleave', function() {
      this.style.transform = '';
      this.style.boxShadow = '';
    });
  });
})();

// 2d: 滚动触发渐次出现动画
(function() {
  var staggerEls = document.querySelectorAll('.checklist-item, .drone-point, .tip-card, .meal-card, .route-item');
  staggerEls.forEach(function(el) { el.classList.add('stagger-in'); });
  var staggerObserver = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        staggerObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  staggerEls.forEach(function(el) { staggerObserver.observe(el); });
})();

// 2e: 数字递增动画
(function() {
  var budgetAnimated = false;
  var budgetSection = document.getElementById('budget');
  if (budgetSection) {
    var budgetObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting && !budgetAnimated) {
          budgetAnimated = true;
          budgetObserver.unobserve(entry.target);
          // Animate budget total
          var totalEl = document.getElementById('budget-total');
          if (totalEl) {
            var targetVal = 7500;
            var startTime = null;
            var duration = 1200;
            function animateBudget(ts) {
              if (!startTime) startTime = ts;
              var progress = Math.min((ts - startTime) / duration, 1);
              var eased = 1 - Math.pow(1 - progress, 3);
              var current = Math.round(eased * targetVal);
              totalEl.textContent = '¥' + current.toLocaleString();
              if (progress < 1) requestAnimationFrame(animateBudget);
            }
            requestAnimationFrame(animateBudget);
          }
          // Animate countdown digits
          ['cd-days','cd-hours','cd-mins','cd-secs'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el && el.textContent !== '--') {
              var target = parseInt(el.textContent, 10);
              if (!isNaN(target) && target > 0) {
                var dur = 800;
                var start = null;
                function animCount(ts) {
                  if (!start) start = ts;
                  var p = Math.min((ts - start) / dur, 1);
                  var e = 1 - Math.pow(1 - p, 3);
                  el.textContent = Math.round(e * target);
                  if (p < 1) requestAnimationFrame(animCount);
                }
                el.textContent = '0';
                requestAnimationFrame(animCount);
              }
            }
          });
        }
      });
    }, { threshold: 0.2 });
    budgetObserver.observe(budgetSection);
  }
})();

// 2i: 鼠标跟随光晕效果（仅桌面端）
(function() {
  if (window.matchMedia('(hover: none)').matches) return;
  var glow = document.createElement('div');
  glow.className = 'mouse-glow';
  document.body.appendChild(glow);
  document.addEventListener('mousemove', function(e) {
    glow.style.left = e.clientX + 'px';
    glow.style.top = e.clientY + 'px';
  });
})();


// ========== V8: 小众路线 ==========
var currentRoute = 'main';

function switchRoute(route) {
  if (route === currentRoute) return;
  currentRoute = route;

  // 更新Tab状态
  var tabMain = document.getElementById('tab-main');
  var tabAlt = document.getElementById('tab-alt');
  if (tabMain) tabMain.classList.toggle('active', route === 'main');
  if (tabAlt) tabAlt.classList.toggle('active', route === 'alt');

  // Hero标签
  var heroAltTag = document.getElementById('heroAltTag');
  if (heroAltTag) heroAltTag.style.display = route === 'alt' ? '' : 'none';

  // 路线总览切换
  var routeMain = document.getElementById('route-main-content');
  var routeAlt = document.getElementById('route-alt-content');
  if (routeMain) routeMain.style.display = route === 'main' ? '' : 'none';
  if (routeAlt) routeAlt.style.display = route === 'alt' ? '' : 'none';

  // 每日行程切换
  var cardsMain = document.getElementById('route-main-cards');
  var cardsAlt = document.getElementById('route-alt-cards');
  if (cardsMain) cardsMain.style.display = route === 'main' ? '' : 'none';
  if (cardsAlt) cardsAlt.style.display = route === 'alt' ? '' : 'none';

  // 温度对比切换
  var tempMain = document.getElementById('tempBarsUpgraded');
  var tempAlt = document.getElementById('tempAltContent');
  if (tempMain) tempMain.style.display = route === 'main' ? '' : 'none';
  if (tempAlt) tempAlt.style.display = route === 'alt' ? '' : 'none';

  // 预算切换
  var budgetMain = document.getElementById('budget-main-content');
  var budgetAlt = document.getElementById('budget-alt-content');
  if (budgetMain) budgetMain.style.display = route === 'main' ? '' : 'none';
  if (budgetAlt) budgetAlt.style.display = route === 'alt' ? '' : 'none';

  // 预算小标题更新
  var budgetSubtitle = document.querySelector('#budget .section-subtitle');
  if (budgetSubtitle) {
    if (route === 'alt') {
      budgetSubtitle.textContent = '小众避暑路线总预算约8200元（6人·2间房），含交通/住宿/餐饮/门票';
    } else {
      budgetSubtitle.textContent = '总预算上限8000元（6人·2间房），拖动滑块调整各项预算，绿色区间为6000-8000元';
    }
  }

  // 切换背景图层
  var bgLayers = document.querySelectorAll('.bg-layer');
  bgLayers.forEach(function(layer) {
    var section = layer.dataset.section;
    var altUrl = layer.getAttribute('data-alt-bg');
    if (route === 'alt' && altUrl) {
      layer.style.backgroundImage = "url('" + altUrl + "')";
    } else {
      // 恢复原始背景
      var origUrl = layer.getAttribute('data-orig-bg');
      if (origUrl) {
        layer.style.backgroundImage = "url('" + origUrl + "')";
      }
    }
  });

  // 默认展开切换后路线的第一天
  var selector = route === 'alt' ? '.alt-day-card' : '.itinerary-card:not(.alt-day-card)';
  var allCards = document.querySelectorAll(selector);
  allCards.forEach(function(card) { card.classList.remove('open'); });
  if (allCards.length > 0) allCards[0].classList.add('open');

  // 触发淡入动画
  var visibleContent = route === 'alt' ? routeAlt : routeMain;
  if (visibleContent) {
    visibleContent.style.opacity = '0';
    requestAnimationFrame(function() {
      visibleContent.style.transition = 'opacity 0.4s ease';
      visibleContent.style.opacity = '1';
    });
  }
}

// 初始化：保存原始背景URL，设置小众路线背景URL
(function() {
  var bgLayers = document.querySelectorAll('.bg-layer');
  var altBgMap = {
    'hero': 'https://s.coze.cn/image/dc3Lqd04vW8/',
    'route': 'https://s.coze.cn/image/PkfkuP49UsA/',
    'itinerary': 'https://s.coze.cn/image/ZMq4z5J4EM4/',
    'temperature': 'https://s.coze.cn/image/LQpTitvSvb0/',
    'budget': 'https://s.coze.cn/image/zRIZsNhCC60/',
    'drone': 'https://s.coze.cn/image/EhDWB1jXPOA/',
    'summary': 'https://s.coze.cn/image/IgchC51Jup8/',
    'checklist': 'https://s.coze.cn/image/LQpTitvSvb0/'
  };
  bgLayers.forEach(function(layer) {
    var section = layer.dataset.section;
    // 保存原始背景URL
    var bgStyle = layer.style.backgroundImage;
    var urlMatch = bgStyle.match(/url\(['"]?([^'")]+)['"]?\)/);
    if (urlMatch) {
      layer.setAttribute('data-orig-bg', urlMatch[1]);
    }
    // 设置小众路线背景URL（复用现有图片，不同section映射）
    if (altBgMap[section]) {
      layer.setAttribute('data-alt-bg', altBgMap[section]);
    }
  });
})();


// ============================================================
// V9: 图片视频 Lightbox
// ============================================================
var v9LightboxImages = [];
var v9CurrentIndex = 0;

function openV9Lightbox(imgEl) {
  // Collect all gallery images in the same parent section
  var container = imgEl.closest('.itinerary-body-inner') || imgEl.closest('.itinerary-body') || imgEl.parentElement.parentElement;
  var allImgs = container.querySelectorAll('.photo-gallery img, .hotel-photos img, .food-photos img, .spot-photos img');
  v9LightboxImages = [];
  var clickedSrc = imgEl.src;
  var clickedIdx = 0;
  allImgs.forEach(function(img, i) {
    v9LightboxImages.push({ src: img.src, caption: '' });
    if (img.src === clickedSrc) clickedIdx = i;
  });
  if (v9LightboxImages.length === 0) {
    v9LightboxImages = [{ src: clickedSrc, caption: '' }];
    clickedIdx = 0;
  }
  v9CurrentIndex = clickedIdx;
  showV9LightboxImage();
  document.getElementById('lightbox').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function showV9LightboxImage() {
  if (v9LightboxImages.length === 0) return;
  var img = document.getElementById('lightbox-img');
  var cap = document.getElementById('lightbox-caption');
  img.src = v9LightboxImages[v9CurrentIndex].src;
  cap.textContent = v9LightboxImages[v9CurrentIndex].caption || '';
}

// Override the existing openLightbox to support V9 galleries
var _origOpenLightbox = window.openLightbox;
window.openLightbox = function(sectionKey, startIndex) {
  if (v9LightboxImages.length > 0) {
    // If V9 lightbox was triggered, reuse existing lightbox display
  }
  if (_origOpenLightbox) _origOpenLightbox(sectionKey, startIndex);
};

// Make V9 lightbox navigation work with existing lightbox buttons
var _origNavigateLightbox = window.navigateLightbox;
window.navigateLightbox = function(dir) {
  if (v9LightboxImages.length > 0) {
    v9CurrentIndex = (v9CurrentIndex + dir + v9LightboxImages.length) % v9LightboxImages.length;
    showV9LightboxImage();
  } else if (_origNavigateLightbox) {
    _origNavigateLightbox(dir);
  }
};

var _origCloseLightbox = window.closeLightbox;
window.closeLightbox = function() {
  v9LightboxImages = [];
  v9CurrentIndex = 0;
  resetLightboxZoom();
  if (_origCloseLightbox) _origCloseLightbox();
};

// ========== V11.1 灯箱缩放 & 拖动手势 (V12增强) ==========
(function() {
  var lbImg = null, lbContent = null, lbOverlay = null;
  var scale = 1, posX = 0, posY = 0;
  var startX = 0, startY = 0, startPosX = 0, startPosY = 0;
  var isDragging = false;
  var initialPinchDist = 0, initialScale = 1;
  var zoomHintTimer = null, zoomLevelTimer = null;

  function getImg() {
    if (!lbImg) lbImg = document.getElementById('lightbox-img');
    return lbImg;
  }

  function applyTransform() {
    var img = getImg();
    if (!img) return;
    img.style.transform = 'translate(' + posX + 'px,' + posY + 'px) scale(' + scale + ')';
    // Show zoom level
    var zl = document.getElementById('lbZoomLevel');
    if (zl) {
      zl.textContent = Math.round(scale * 100) + '%';
      zl.style.opacity = '1';
      clearTimeout(zoomLevelTimer);
      zoomLevelTimer = setTimeout(function() { zl.style.opacity = '0'; }, 1000);
    }
    // Show/hide reset button
    var rb = document.getElementById('lightbox-reset-btn');
    if (rb) {
      if (scale !== 1 || posX !== 0 || posY !== 0) {
        rb.classList.add('visible');
      } else {
        rb.classList.remove('visible');
      }
    }
  }

  function resetLightboxZoom() {
    scale = 1; posX = 0; posY = 0;
    var img = getImg();
    if (img) img.style.transform = '';
    var rb = document.getElementById('lightbox-reset-btn');
    if (rb) rb.classList.remove('visible');
    var hint = document.getElementById('lbZoomHint');
    if (hint) {
      hint.style.opacity = '1';
      clearTimeout(zoomHintTimer);
      zoomHintTimer = setTimeout(function() { hint.style.opacity = '0'; }, 3000);
    }
  }
  window.resetLightboxZoom = resetLightboxZoom;

  // Reset zoom when switching images
  var _origShowV9 = window.showV9LightboxImage;
  if (_origShowV9) {
    window.showV9LightboxImage = function() {
      resetLightboxZoom();
      _origShowV9();
    };
  }
  var _origShowLB = window.showLightboxImage;
  if (_origShowLB) {
    window.showLightboxImage = function() {
      resetLightboxZoom();
      _origShowLB();
    };
  }

  // Reset zoom when closing
  var _origClose = window.closeLightbox;
  window.closeLightbox = function() {
    resetLightboxZoom();
    if (_origClose) _origClose();
  };

  function getTouchDist(t1, t2) {
    var dx = t1.clientX - t2.clientX;
    var dy = t1.clientY - t2.clientY;
    return Math.sqrt(dx * dx + dy * dy);
  }

  // Touch: pinch zoom + drag
  function onTouchStart(e) {
    if (e.touches.length === 2) {
      e.preventDefault();
      initialPinchDist = getTouchDist(e.touches[0], e.touches[1]);
      initialScale = scale;
    } else if (e.touches.length === 1 && scale > 1) {
      e.preventDefault();
      isDragging = true;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      startPosX = posX;
      startPosY = posY;
    }
  }

  function onTouchMove(e) {
    if (e.touches.length === 2) {
      e.preventDefault();
      var dist = getTouchDist(e.touches[0], e.touches[1]);
      var newScale = Math.max(0.5, Math.min(5, initialScale * (dist / initialPinchDist)));
      scale = newScale;
      if (scale <= 1) { posX = 0; posY = 0; }
      applyTransform();
      var hint = document.getElementById('lbZoomHint');
      if (hint) hint.style.opacity = '0';
    } else if (e.touches.length === 1 && isDragging && scale > 1) {
      e.preventDefault();
      posX = startPosX + (e.touches[0].clientX - startX);
      posY = startPosY + (e.touches[0].clientY - startY);
      applyTransform();
    }
  }

  function onTouchEnd(e) {
    isDragging = false;
    if (e.touches.length === 0 && scale <= 1.05) {
      scale = 1; posX = 0; posY = 0;
      applyTransform();
    }
  }

  // Mouse: wheel zoom (supports zoom-out below 100%)
  function onWheel(e) {
    var lb = document.getElementById('lightbox');
    if (!lb || lb.style.display === 'none') return;
    e.preventDefault();
    var delta = e.deltaY > 0 ? -0.15 : 0.15;
    var newScale = Math.max(0.5, Math.min(5, scale + delta));
    if (newScale <= 1.05) { posX = 0; posY = 0; newScale = 1; }
    scale = newScale;
    applyTransform();
    var hint = document.getElementById('lbZoomHint');
    if (hint) hint.style.opacity = '0';
  }

  // Mouse: drag pan
  var mouseDown = false;
  function onMouseDown(e) {
    if (scale <= 1) return;
    if (e.target.closest('.lightbox-close,.lightbox-prev,.lightbox-next,.lightbox-reset-btn')) return;
    mouseDown = true;
    startX = e.clientX;
    startY = e.clientY;
    startPosX = posX;
    startPosY = posY;
    getImg().classList.add('dragging');
    e.preventDefault();
  }
  function onMouseMove(e) {
    if (!mouseDown || scale <= 1) return;
    posX = startPosX + (e.clientX - startX);
    posY = startPosY + (e.clientY - startY);
    applyTransform();
  }
  function onMouseUp() {
    mouseDown = false;
    var img = getImg();
    if (img) img.classList.remove('dragging');
    if (scale <= 1.05) {
      scale = 1; posX = 0; posY = 0;
      applyTransform();
    }
  }

  // Double-click: toggle 2.5x zoom or reset
  function onDblClick(e) {
    var lb = document.getElementById('lightbox');
    if (!lb || lb.style.display === 'none') return;
    if (e.target.closest('.lightbox-close,.lightbox-prev,.lightbox-next,.lightbox-reset-btn')) return;
    if (scale > 1.05) {
      scale = 1; posX = 0; posY = 0;
    } else {
      scale = 2.5;
    }
    applyTransform();
    var hint = document.getElementById('lbZoomHint');
    if (hint) hint.style.opacity = '0';
  }

  // Bind events
  document.addEventListener('DOMContentLoaded', function() {
    var lb = document.getElementById('lightbox');
    if (!lb) return;
    lb.addEventListener('touchstart', onTouchStart, { passive: false });
    lb.addEventListener('touchmove', onTouchMove, { passive: false });
    lb.addEventListener('touchend', onTouchEnd);
    lb.addEventListener('wheel', onWheel, { passive: false });
    lb.addEventListener('mousedown', onMouseDown);
    document.addEventListener('mousemove', onMouseMove);
    document.addEventListener('mouseup', onMouseUp);
    lb.addEventListener('dblclick', onDblClick);

    // Auto-hide zoom hint after 4s
    var hint = document.getElementById('lbZoomHint');
    if (hint) {
      setTimeout(function() { hint.style.opacity = '0'; }, 4000);
    }
  });
})();


// ============================================================
// V11: 手机端手风琴折叠功能
// ============================================================
function initMobileAccordion() {
  var accSections = [
    { id: 'route',       icon: '🗺️',                                       title: '路线总览' },
    { id: 'itinerary',   icon: '📅',                                             title: '每日行程' },
    { id: 'temperature', icon: '🌡️',                                       title: '温度对比' },
    { id: 'budget',      icon: '💰',                                             title: '预算计算器' },
    { id: 'drone',       icon: '🚁',                                             title: '无人机航拍' },
    { id: 'checklist',   icon: '✅',                                                title: '行前清单' },
    { id: 'summary',     icon: '👨‍👩‍👧‍👦', title: '亲子活动&野钓' },
    { id: 'tips',        icon: '⚠️',                                          title: '自驾注意事项' }
  ];
  var isMobile = window.innerWidth <= 768;

  accSections.forEach(function(cfg) {
    var section = document.getElementById(cfg.id);
    if (!section) return;
    var isActive = section.classList.contains('accordion-active');

    if (!isMobile) {
      // Desktop: teardown if was active
      if (isActive) {
        var body = section.querySelector('.accordion-body');
        if (body) {
          var inner = body.querySelector('.accordion-body-inner');
          if (inner) {
            while (inner.firstChild) section.insertBefore(inner.firstChild, body);
          }
          body.remove();
        }
        var trig = section.querySelector('.accordion-trigger');
        if (trig) trig.remove();
        section.classList.remove('accordion-active', 'accordion-collapsed');
      }
      return;
    }

    // Mobile: init if not active
    if (isActive) return;

    var trigger = document.createElement('div');
    trigger.className = 'accordion-trigger';
    trigger.setAttribute('role', 'button');
    trigger.setAttribute('tabindex', '0');
    trigger.setAttribute('aria-expanded', 'false');
    trigger.innerHTML =
      '<span class="accordion-icon">' + cfg.icon + '</span>' +
      '<span class="accordion-title">' + cfg.title + '</span>' +
      '<span class="accordion-arrow">›</span>';

    var body = document.createElement('div');
    body.className = 'accordion-body';
    var inner = document.createElement('div');
    inner.className = 'accordion-body-inner';

    // Move all existing children into inner wrapper
    while (section.firstChild) inner.appendChild(section.firstChild);
    body.appendChild(inner);
    section.appendChild(trigger);
    section.appendChild(body);
    section.classList.add('accordion-active');

    // Restore saved state (default collapsed)
    var saved = {};
    try { saved = JSON.parse(localStorage.getItem('guizhou-accordion-state') || '{}'); } catch(e) {}
    if (saved[cfg.id] !== true) {
      // Default: collapsed unless saved state says expanded
    var _savedState = null;
    try { _savedState = JSON.parse(localStorage.getItem('guizhou-accordion-state') || '{}'); } catch(e) {}
    if (_savedState && _savedState[cfg.id] === true) {
      section.classList.remove('accordion-collapsed');
      trigger.setAttribute('aria-expanded', 'true');
    } else {
      section.classList.add('accordion-collapsed');
    }
    } else {
      trigger.setAttribute('aria-expanded', 'true');
    }

    // Click handler
    trigger.addEventListener('click', function() {
      _toggleAccordion(section, trigger);
    });
    // Keyboard handler (Enter / Space)
    trigger.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
        e.preventDefault();
        _toggleAccordion(section, trigger);
      }
    });
  });
}

function _toggleAccordion(section, trigger) {
  var collapsed = section.classList.toggle('accordion-collapsed');
  trigger.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
  // Persist state
  var st = {};
  try { st = JSON.parse(localStorage.getItem('guizhou-accordion-state') || '{}'); } catch(e) {}
  st[section.id] = !collapsed;
  try { localStorage.setItem('guizhou-accordion-state', JSON.stringify(st)); } catch(e) {}
}

// Auto-expand section when navigating via floating nav
function _expandAccordionById(id) {
  var section = document.getElementById(id);
  if (section && section.classList.contains('accordion-collapsed')) {
    var trigger = section.querySelector('.accordion-trigger');
    if (trigger) _toggleAccordion(section, trigger);
  }
}

document.addEventListener('DOMContentLoaded', function() {
  initMobileAccordion();
  // Hook floating nav clicks to auto-expand target section
  document.querySelectorAll('.fn-item').forEach(function(item) {
    item.addEventListener('click', function() {
      var target = this.dataset.target;
      if (target) _expandAccordionById(target);
    });
  });
});

// Re-init on resize (debounced 200ms)
var _accResizeTimer;
window.addEventListener('resize', function() {
  clearTimeout(_accResizeTimer);
  _accResizeTimer = setTimeout(initMobileAccordion, 200);
});


// ============================================================
// V12: 全局点击图片打开灯箱 + SVG地图支持
// ============================================================
(function() {
  // Global click-to-open for all data-lightbox images
  document.addEventListener('click', function(e) {
    var img = e.target.closest('img[data-lightbox]');
    if (!img) return;
    // Skip if inside lightbox already
    if (img.closest('#lightbox')) return;
    // Skip tiny icons
    if (img.offsetWidth < 50 || img.offsetHeight < 50) return;
    e.preventDefault();
    e.stopPropagation();
    var src = img.src;
    if (!src) return;

    // Find sibling images in same gallery
    var container = img.closest('.photo-gallery,.hotel-photos,.food-photos,.spot-photos,.itinerary-body-inner,.itinerary-body,section');
    var siblings = [];
    var clickedIdx = 0;
    if (container) {
      var allImgs = container.querySelectorAll('img[data-lightbox]');
      allImgs.forEach(function(si) {
        if (si.closest('#lightbox')) return;
        if (si.offsetWidth < 50 || si.offsetHeight < 50) return;
        siblings.push({ src: si.src, caption: si.alt || '' });
        if (si === img) clickedIdx = siblings.length - 1;
      });
    }
    if (siblings.length === 0) {
      siblings = [{ src: src, caption: img.alt || '' }];
      clickedIdx = 0;
    }

    window.v9LightboxImages = siblings;
    window.v9CurrentIndex = clickedIdx;
    if (window.showV9LightboxImage) window.showV9LightboxImage();
    document.getElementById('lightbox').style.display = 'flex';
    document.body.style.overflow = 'hidden';
  });

  // SVG map click-to-zoom
  document.addEventListener('click', function(e) {
    var svg = e.target.closest('svg.route-map');
    if (!svg) return;
    e.preventDefault();
    e.stopPropagation();

    var serializer = new XMLSerializer();
    var svgStr = serializer.serializeToString(svg);
    var svgBlob = new Blob([svgStr], {type: 'image/svg+xml;charset=utf-8'});
    var url = URL.createObjectURL(svgBlob);

    window.v9LightboxImages = [{ src: url, caption: '路线地图' }];
    window.v9CurrentIndex = 0;
    var lbImg = document.getElementById('lightbox-img');
    if (lbImg) {
      lbImg.src = url;
      lbImg.style.width = 'auto';
      lbImg.style.height = 'auto';
      lbImg.style.maxWidth = '95vw';
      lbImg.style.maxHeight = '85vh';
      lbImg.style.minWidth = '300px';
      lbImg.style.minHeight = '200px';
    }
    var cap = document.getElementById('lightbox-caption');
    if (cap) cap.textContent = '路线地图';
    var lb = document.getElementById('lightbox');
    if (lb) lb.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    if (window.resetLightboxZoom) window.resetLightboxZoom();
  });
})();


// ============================================================
// ============================================================


// ===== 新增脚本开始 =====

(function() {
  'use strict';

  // ===== 1.1 板块标题淡入上浮 =====
  function add_initFadeUp() {
    var headers = document.querySelectorAll('.section-header');
    var isMobile = window.innerWidth <= 768;
    for (var i = 0; i < headers.length; i++) {
      // 手机端折叠区域内的header不添加fade-up，避免展开后不可见
      if (isMobile && headers[i].closest('.mobile-accordion')) continue;
      headers[i].classList.add('add-fade-up');
    }
    if (!('IntersectionObserver' in window)) {
      for (var j = 0; j < headers.length; j++) {
        headers[j].classList.add('add-visible');
      }
      return;
    }
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('add-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    for (var k = 0; k < headers.length; k++) {
      observer.observe(headers[k]);
    }
  }

  // ===== 1.2 按钮/卡片悬停微放大 =====
  function add_initHoverLift() {
    var selectors = '.tip-card, .hotel-card, .food-card, .must-do-card, .summary-card, .meal-card';
    var cards = document.querySelectorAll(selectors);
    for (var i = 0; i < cards.length; i++) {
      cards[i].classList.add('add-hover-lift');
    }
  }


  // ===== 1.4 行前清单勾选动画 =====
  function add_initCheckAnim() {
    var items = document.querySelectorAll('.checklist-item');
    for (var i = 0; i < items.length; i++) {
      items[i].classList.add('add-check-anim');
    }
  }

  // ===== 2.2 贵州小知识轮播 =====
  var add_knowledgeList = [
    '贵州被誉为"中国凉都"，夏季平均气温仅23℃',
    '贵州是全国唯一没有平原支撑的省份，素有"八山一水一分田"之说',
    '茅台酒产自贵州遵义仁怀市，是中国国酒',
    '黄果树瀑布是亚洲最大的瀑布，高77.8米，宽101米',
    '贵州话"摆龙门阵"就是聊天、讲故事的意思',
    '织金洞被誉为"中国溶洞之王"，洞内恒温16℃',
    '贵州是世界知名山地旅游目的地，山地占比92.5%',
    '"酸汤鱼"是贵州苗族特色名菜，酸汤由番茄发酵而成',
    '乌蒙大草原是西南地区海拔最高、面积最大的高原草场',
    '贵州荔波喀斯特是世界自然遗产，被称为"地球腰带上的绿宝石"'
  ];
  var add_knowledgeIndex = 0;
  var add_knowledgeTimer = null;
  var add_knowledgePaused = false;

  function add_initKnowledge() {
    var textEl = document.getElementById('addKnowledgeText');
    if (!textEl) return;
    add_knowledgeIndex = 0;
    add_knowledgeTimer = setInterval(add_nextKnowledge, 5000);

    // visibilitychange 暂停
    document.addEventListener('visibilitychange', function() {
      if (document.hidden) {
        add_knowledgePaused = true;
      } else {
        add_knowledgePaused = false;
      }
    });
  }

  function add_nextKnowledge() {
    if (add_knowledgePaused) return;
    var textEl = document.getElementById('addKnowledgeText');
    if (!textEl) return;
    textEl.classList.remove('add-knowledge-show');
    setTimeout(function() {
      add_knowledgeIndex = (add_knowledgeIndex + 1) % add_knowledgeList.length;
      textEl.textContent = add_knowledgeList[add_knowledgeIndex];
      textEl.classList.add('add-knowledge-show');
    }, 500);
  }

  // ===== 2.3 预算计算器人均/总计切换 =====
  var add_budgetMode = 'total'; // total | per
  var add_budgetOriginalTotal = 0;

  function add_initBudgetToggle() {
    var summaryLabel = document.querySelector('.budget-summary-label');
    if (!summaryLabel) return;
    var toggleHtml = '<span class="add-budget-toggle">' +
      '<button class="add-budget-toggle-btn add-budget-toggle-active" onclick="add_switchBudget(\'total\')" id="addBudgetTotalBtn">总计</button>' +
      '<button class="add-budget-toggle-btn" onclick="add_switchBudget(\'per\')" id="addBudgetPerBtn">人均</button>' +
      '</span>';
    summaryLabel.innerHTML = summaryLabel.innerHTML + toggleHtml;
  }

  function add_switchBudget(mode) {
    if (add_budgetMode === mode) return;
    add_budgetMode = mode;
    var totalBtn = document.getElementById('addBudgetTotalBtn');
    var perBtn = document.getElementById('addBudgetPerBtn');
    var totalEl = document.getElementById('budget-total');
    var perEl = document.getElementById('budget-per-person');
    if (totalBtn && perBtn) {
      if (mode === 'total') {
        totalBtn.classList.add('add-budget-toggle-active');
        perBtn.classList.remove('add-budget-toggle-active');
      } else {
        perBtn.classList.add('add-budget-toggle-active');
        totalBtn.classList.remove('add-budget-toggle-active');
      }
    }
    if (totalEl && perEl) {
      if (mode === 'per') {
        totalEl.style.display = 'none';
        perEl.style.fontSize = '28px';
        perEl.style.fontWeight = '900';
      } else {
        totalEl.style.display = '';
        perEl.style.fontSize = '';
        perEl.style.fontWeight = '';
      }
    }
  }

  // ===== 3.1 Hero背景Canvas粒子 (已移除) =====

  // ===== 3.2 SVG地图城市悬停高亮 =====
  function add_initMapHover() {
    // 触屏设备跳过hover效果
    if (window.matchMedia && window.matchMedia('(hover: none) and (pointer: coarse)').matches) return;
    var maps = document.querySelectorAll('.route-map');
    var tooltip = document.getElementById('addMapTooltip');
    if (!tooltip) return;

    for (var m = 0; m < maps.length; m++) {
      var map = maps[m];
      var container = map.closest('.route-map-container') || map.parentElement;
      if (!container.style.position || container.style.position === 'static') {
        container.style.position = 'relative';
      }

      var nodes = map.querySelectorAll('circle.route-node');
      for (var i = 0; i < nodes.length; i++) {
        (function(node) {
          node.addEventListener('mouseenter', function(e) {
            // 找附近text
            var text = '';
            var siblings = node.parentNode.querySelectorAll('text');
            var cx = parseFloat(node.getAttribute('cx'));
            var cy = parseFloat(node.getAttribute('cy'));
            var closest = null;
            var minDist = Infinity;
            for (var j = 0; j < siblings.length; j++) {
              var t = siblings[j];
              var tx = parseFloat(t.getAttribute('x'));
              var ty = parseFloat(t.getAttribute('y'));
              if (isNaN(tx) || isNaN(ty)) continue;
              var d = Math.sqrt((tx - cx) * (tx - cx) + (ty - cy) * (ty - cy));
              if (d < minDist && d < 80) {
                minDist = d;
                closest = t;
              }
            }
            if (closest) text = closest.textContent;

            tooltip.textContent = text || '贵州景点';
            tooltip.classList.add('add-map-tooltip-show');
          });

          node.addEventListener('mousemove', function(e) {
            var rect = container.getBoundingClientRect();
            tooltip.style.left = (e.clientX - rect.left) + 'px';
            tooltip.style.top = (e.clientY - rect.top) + 'px';
          });

          node.addEventListener('mouseleave', function() {
            tooltip.classList.remove('add-map-tooltip-show');
          });
        })(nodes[i]);
      }
    }
  }

  // ===== 4.1 旅行日记 =====
  function add_initDiary() {
    var dayCards = document.querySelectorAll('.day-card');
    for (var i = 0; i < dayCards.length; i++) {
      (function(card, idx) {
        var dayNum = idx + 1;
        var bodyInner = card.querySelector('.itinerary-body-inner');
        if (!bodyInner) return;

        var btn = document.createElement('button');
        btn.className = 'add-diary-btn';
        btn.innerHTML = '✏️ 写两句';
        btn.onclick = function() {
          var area = card.querySelector('.add-diary-area');
          if (area) {
            area.classList.toggle('add-diary-open');
            var ta = area.querySelector('textarea');
            if (ta && area.classList.contains('add-diary-open')) {
              ta.focus();
            }
          }
        };

        var area = document.createElement('div');
        area.className = 'add-diary-area';
        area.innerHTML = '<textarea class="add-diary-textarea" placeholder="记录今天的旅行心情..." oninput="add_saveDiary(' + dayNum + ', this.value)"></textarea>' +
                          '<div class="add-diary-status">💾 自动保存到本地</div>';

        bodyInner.appendChild(btn);
        bodyInner.appendChild(area);

        // 恢复内容
        var saved = null;
        try {
          saved = localStorage.getItem('guizhou_diary_D' + dayNum);
        } catch (e) {}
        if (saved) {
          var ta = area.querySelector('textarea');
          if (ta) ta.value = saved;
        }
      })(dayCards[i], i);
    }
  }

  function add_saveDiary(dayNum, value) {
    try {
      localStorage.setItem('guizhou_diary_D' + dayNum, value);
    } catch (e) {}
  }

  // ===== 4.2 景点打卡 =====
  function add_initCheckin() {
    // 给每个 day-title 景点标题添加打卡按钮
    var dayTitles = document.querySelectorAll('.day-title');
    for (var i = 0; i < dayTitles.length; i++) {
      (function(titleEl, idx) {
        var text = titleEl.textContent.trim().replace(/\s+/g, '_').substring(0, 30);
        var key = 'guizhou_checkin_' + text;
        var btn = document.createElement('button');
        btn.className = 'add-checkin-btn';
        btn.innerHTML = '📍 打卡';
        var done = false;
        try {
          done = localStorage.getItem(key) === '1';
        } catch (e) {}
        if (done) {
          btn.classList.add('add-checkin-done');
          btn.innerHTML = '✓ 已打卡<span class="add-checkin-badge">✓</span>';
        }
        btn.onclick = function(e) {
          e.stopPropagation();
          var isDone = btn.classList.contains('add-checkin-done');
          if (isDone) {
            btn.classList.remove('add-checkin-done');
            btn.innerHTML = '📍 打卡';
            try { localStorage.removeItem(key); } catch (err) {}
          } else {
            btn.classList.add('add-checkin-done');
            btn.innerHTML = '✓ 已打卡<span class="add-checkin-badge">✓</span>';
            try { localStorage.setItem(key, '1'); } catch (err) {}
          }
        };
        titleEl.appendChild(btn);
      })(dayTitles[i], i);
    }
  }

  // ===== 初始化 =====
  function add_initAll() {
    try { add_initFadeUp(); } catch (e) { console.warn('fadeUp init error', e); }
    try { add_initHoverLift(); } catch (e) { console.warn('hoverLift init error', e); }
    try { add_initCheckAnim(); } catch (e) { console.warn('checkAnim init error', e); }
    try { add_initKnowledge(); } catch (e) { console.warn('knowledge init error', e); }
    try { add_initBudgetToggle(); } catch (e) { console.warn('budgetToggle init error', e); }
    try { add_initMapHover(); } catch (e) { console.warn('mapHover init error', e); }
    try { add_initDiary(); } catch (e) { console.warn('diary init error', e); }
    try { add_initCheckin(); } catch (e) { console.warn('checkin init error', e); }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', add_initAll);
  } else {
    add_initAll();
  }

  // 暴露到全局
  window.add_switchBudget = add_switchBudget;
  window.add_saveDiary = add_saveDiary;

})();

// ===== 新增脚本结束 =====

// ===== V17 Portal View System 开始 =====

// V17: 导航栈系统 - 多层钻入
var add_navStack = [];
// 每个元素: {level: number, sectionId: string, extra: object}
// level 1 = 入口网格(不在栈中)
// level 2 = 板块门户页
// level 3 = 板块内详情（如某天行程详情）

var add_isMobileView = false;
var add_sectionParents = {};

var add_portalConfig = {
  route: { emoji: '\ud83d\uddfa\ufe0f', title: '\u8def\u7ebf\u603b\u89c8', sub: '7\u5929\u73af\u7ebf \u00b7 2000km' },
  itinerary: { emoji: '\ud83d\udcc5', title: '\u6bcf\u65e5\u884c\u7a0b', sub: '7\u59296\u665a\u8be6\u60c5' },
  temperature: { emoji: '\ud83c\udf21\ufe0f', title: '\u6c14\u6e29\u5bf9\u6bd4', sub: '\u907f\u669114-26\u2103' },
  budget: { emoji: '\ud83d\udcb0', title: '\u9884\u7b97', sub: '6000-8000\u5143' },
  drone: { emoji: '\ud83d\ude81', title: '\u822a\u62cd\u6307\u5357', sub: '\u98de\u884c\u6307\u5357' },
  checklist: { emoji: '\u2705', title: '\u884c\u524d\u6e05\u5355', sub: '12\u9879\u5f85\u786e\u8ba4' },
  summary: { emoji: '\ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67\u200d\ud83d\udc66', title: '\u4eb2\u5b50\u91ce\u9493', sub: '\u6d3b\u52a8\u6c47\u603b' },
  'must-do': { emoji: '\u2728', title: '\u6b64\u884c\u5fc5\u505a', sub: '8\u4e2a\u5fc5\u4f53\u9a8c' }
};

function add_checkMobile() {
  add_isMobileView = window.innerWidth <= 768;
}

function add_storeParent(id) {
  var el = document.getElementById(id);
  if (el && !add_sectionParents[id]) {
    add_sectionParents[id] = el.parentNode;
  }
}

function add_storeAllParents() {
  var keys = Object.keys(add_portalConfig);
  for (var i = 0; i < keys.length; i++) {
    add_storeParent(keys[i]);
  }
}

function add_buildPortalHeader(sectionId, level) {
  var cfg = add_portalConfig[sectionId];
  if (!cfg) return null;
  var header = document.createElement('div');
  header.className = 'add-portal-header';
  if (level >= 3) {
    header.classList.add('add-header-l3');
  }
  // No inline style for gradient - unified CSS handles it

  var emojiSpan = document.createElement('span');
  emojiSpan.className = 'add-portal-header-emoji';
  emojiSpan.textContent = cfg.emoji;

  var backBtn = document.createElement('button');
  backBtn.className = 'add-portal-back';
  backBtn.textContent = '\u2190 \u8fd4\u56de';
  backBtn.addEventListener('click', function() { add_goBack(); });

  var title = document.createElement('h2');
  title.className = 'add-portal-title';
  title.textContent = cfg.title;

  var subtitle = document.createElement('div');
  subtitle.className = 'add-portal-subtitle';
  subtitle.textContent = cfg.sub;

  header.appendChild(emojiSpan);
  header.appendChild(backBtn);
  header.appendChild(title);
  header.appendChild(subtitle);
  return header;
}

function add_updateNav(sectionId) {
  var navItems = document.querySelectorAll('.add-portal-nav-item');
  for (var i = 0; i < navItems.length; i++) {
    if (navItems[i].getAttribute('data-target') === sectionId) {
      navItems[i].classList.add('add-nav-active');
    } else {
      navItems[i].classList.remove('add-nav-active');
    }
  }
}

function add_hideAllInWrapper() {
  var wrapper = document.getElementById('add-sections-wrapper');
  if (!wrapper) return;
  var allSections = wrapper.querySelectorAll('.section.mobile-accordion');
  var allDividers = wrapper.querySelectorAll('.mountain-divider, .wave-divider');
  var allKnowledge = wrapper.querySelectorAll('.add-knowledge-bar');
  for (var i = 0; i < allSections.length; i++) {
    allSections[i].style.display = 'none';
    allSections[i].classList.remove('add-section-active', 'add-itin-summary', 'add-itin-l2', 'add-in-portal');
  }
  for (var j = 0; j < allDividers.length; j++) {
    allDividers[j].style.display = 'none';
  }
  for (var k = 0; k < allKnowledge.length; k++) {
    allKnowledge[k].style.display = 'none';
  }
}

function add_restoreAllInWrapper() {
  var wrapper = document.getElementById('add-sections-wrapper');
  if (!wrapper) return;
  /* V20: 手机端不恢复 - 内容板块仅通过门户视图访问 */
  if (add_isMobileView) return;
  var allSections = wrapper.querySelectorAll('.section.mobile-accordion');
  var allDividers = wrapper.querySelectorAll('.mountain-divider, .wave-divider');
  var allKnowledge = wrapper.querySelectorAll('.add-knowledge-bar');
  for (var i = 0; i < allSections.length; i++) {
    allSections[i].style.display = '';
    allSections[i].classList.remove('add-section-active', 'add-itin-summary', 'add-itin-l2', 'add-in-portal');
  }
  for (var j = 0; j < allDividers.length; j++) {
    allDividers[j].style.display = '';
  }
  for (var k = 0; k < allKnowledge.length; k++) {
    allKnowledge[k].style.display = '';
  }
}

function add_prepareSection(sectionId) {
  var section = document.getElementById(sectionId);
  if (!section) return null;

  add_storeParent(sectionId);

  section.classList.add('add-section-active', 'add-in-portal');
  section.classList.remove('accordion-collapsed');
  section.style.display = '';

  // For itinerary: add L2 summary mode (all folded, click to drill down)
  if (sectionId === 'itinerary') {
    section.classList.add('add-itin-l2');
    // Remove any previous L3 state
    var dayCards = section.querySelectorAll('.day-card');
    for (var i = 0; i < dayCards.length; i++) {
      dayCards[i].style.display = '';
      dayCards[i].classList.remove('add-day-expanded');
    }
    // Bind header click for drill-down to L3
    var dayHeaders = section.querySelectorAll('.day-card .itinerary-header');
    for (var j = 0; j < dayHeaders.length; j++) {
      (function(header, idx) {
        if (header.dataset.addDrillBind) return;
        header.dataset.addDrillBind = '1';
        header.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          add_drillDownItinerary(idx);
        });
      })(dayHeaders[j], j);
    }
  }

  return section;
}

function add_returnSection(sectionId) {
  var section = document.getElementById(sectionId);
  if (!section) return;
  section.classList.remove('add-section-active', 'add-itin-summary', 'add-itin-l2', 'add-in-portal');

  // Reset itinerary cards
  if (sectionId === 'itinerary') {
    var dayCards = section.querySelectorAll('.day-card');
    for (var i = 0; i < dayCards.length; i++) {
      dayCards[i].style.display = '';
      dayCards[i].classList.remove('add-day-expanded');
    }
  }

  if (add_sectionParents[sectionId]) {
    add_sectionParents[sectionId].appendChild(section);
  }
}

// ============================================================
// V17: Core navigation functions
// ============================================================

function add_openPortal(sectionId) {
  if (!add_isMobileView) return;

  add_storeAllParents();

  var overlay = document.getElementById('add-portal-overlay');
  var portalContent = document.getElementById('add-portal-content');
  var section = document.getElementById(sectionId);
  if (!overlay || !portalContent || !section) return;

  // Reset nav stack
  add_navStack = [{level: 2, sectionId: sectionId}];

  // Hide all sections in wrapper
  add_hideAllInWrapper();

  // Prepare the section
  var prepared = add_prepareSection(sectionId);
  if (!prepared) return;

  // Clear portal content
  portalContent.innerHTML = '';

  // Build and add portal header (level 2)
  var header = add_buildPortalHeader(sectionId, 2);
  if (header) {
    portalContent.appendChild(header);
  }

  // Move section into portal
  portalContent.appendChild(prepared);

  // Add fade-in animation
  prepared.classList.add('add-portal-section-enter');
  setTimeout(function() {
    prepared.classList.remove('add-portal-section-enter');
  }, 300);

  // Show overlay
  overlay.classList.remove('add-portal-closing', 'add-no-bottom-nav');
  overlay.classList.add('add-portal-open');

  // Show bottom nav (L2 shows nav)
  var nav = document.getElementById('add-portal-nav');
  if (nav) nav.classList.add('add-nav-visible');

  add_updateNav(sectionId);

  // Prevent body scroll
  document.body.style.overflow = 'hidden';

  // Scroll overlay to top
  overlay.scrollTop = 0;

  // Re-trigger fade-in animations
  var fadeEls = prepared.querySelectorAll('.fade-in');
  for (var i = 0; i < fadeEls.length; i++) {
    fadeEls[i].classList.add('visible');
  }

  // Animate temp bars if temperature section
  if (sectionId === 'temperature' && typeof animateTempBars === 'function') {
    setTimeout(animateTempBars, 300);
  }

  // Update checklist progress if checklist section
  if (sectionId === 'checklist' && typeof updateChecklistProgress === 'function') {
    setTimeout(updateChecklistProgress, 100);
  }
}

function add_goBack() {
  if (add_navStack.length <= 1) {
    // Stack empty or only grid level -> close portal
    add_closePortal();
  } else {
    // Pop current level
    add_navStack.pop();
    var prev = add_navStack[add_navStack.length - 1];

    if (prev.level === 2) {
      // Go back to section overview (L2)
      add_showLevel2(prev.sectionId);
    } else if (prev.level >= 3) {
      // Go back to deeper level (unlikely in current design but supported)
      add_showLevel3(prev.sectionId, prev.extra);
    }
  }
}

function add_showLevel2(sectionId) {
  var overlay = document.getElementById('add-portal-overlay');
  var portalContent = document.getElementById('add-portal-content');
  if (!overlay || !portalContent) return;

  // Get current section from portal content
  var section = document.getElementById(sectionId);
  if (!section) return;

  // Reset section to L2 state
  section.classList.remove('add-itin-l2');
  var dayCards = section.querySelectorAll('.day-card');
  for (var i = 0; i < dayCards.length; i++) {
    dayCards[i].style.display = '';
    dayCards[i].classList.remove('add-day-expanded');
  }

  // Re-apply L2 state
  if (sectionId === 'itinerary') {
    section.classList.add('add-itin-l2');
  }

  // Rebuild header at L2
  portalContent.innerHTML = '';
  var header = add_buildPortalHeader(sectionId, 2);
  if (header) {
    portalContent.appendChild(header);
  }
  portalContent.appendChild(section);

  // Show bottom nav
  overlay.classList.remove('add-no-bottom-nav');
  var nav = document.getElementById('add-portal-nav');
  if (nav) nav.classList.add('add-nav-visible');

  add_updateNav(sectionId);

  // Scroll to top
  overlay.scrollTop = 0;
}

// V17: Drill down into itinerary day detail (Level 3)
function add_drillDownItinerary(dayIndex) {
  // Push to nav stack
  add_navStack.push({level: 3, sectionId: 'itinerary', extra: {dayIndex: dayIndex}});

  var overlay = document.getElementById('add-portal-overlay');
  var portalContent = document.getElementById('add-portal-content');
  var section = document.getElementById('itinerary');
  if (!section) return;

  var cards = section.querySelectorAll('.day-card');

  // Hide all cards except the target
  for (var i = 0; i < cards.length; i++) {
    cards[i].style.display = (i === dayIndex) ? '' : 'none';
  }

  // Expand the target card
  var targetCard = cards[dayIndex];
  targetCard.classList.add('add-day-expanded');
  if (targetCard.classList.contains('itinerary-card')) {
    targetCard.classList.add('open');
  }

  // Remove L2 class
  section.classList.remove('add-itin-l2');

  // Update header to L3 style
  var header = portalContent.querySelector('.add-portal-header');
  if (header) {
    header.classList.add('add-header-l3');
    // Extract day info from the card header
    var cardHeader = targetCard.querySelector('.itinerary-header');
    if (cardHeader) {
      var titleEl = header.querySelector('.add-portal-title');
      var leftInfo = cardHeader.querySelector('.itinerary-header-left');
      if (titleEl && leftInfo) {
        titleEl.textContent = leftInfo.textContent.trim().replace(/\s+/g, ' ');
      }
      var subEl = header.querySelector('.add-portal-subtitle');
      if (subEl) subEl.style.display = 'none';
    }
  }

  // Hide bottom nav
  if (overlay) overlay.classList.add('add-no-bottom-nav');
  var nav = document.getElementById('add-portal-nav');
  if (nav) nav.classList.remove('add-nav-visible');

  // Scroll to top
  if (overlay) overlay.scrollTop = 0;
}

// V17: Generic Level 3 drill-down (for future use)
function add_showLevel3(sectionId, extra) {
  if (sectionId === 'itinerary' && extra && extra.dayIndex !== undefined) {
    // Re-show the specific day
    var overlay = document.getElementById('add-portal-overlay');
    var portalContent = document.getElementById('add-portal-content');
    var section = document.getElementById('itinerary');
    if (!section) return;

    var cards = section.querySelectorAll('.day-card');
    for (var i = 0; i < cards.length; i++) {
      cards[i].style.display = (i === extra.dayIndex) ? '' : 'none';
    }
    var targetCard = cards[extra.dayIndex];
    targetCard.classList.add('add-day-expanded');
    section.classList.remove('add-itin-l2');

    var header = portalContent.querySelector('.add-portal-header');
    if (header) {
      header.classList.add('add-header-l3');
      var cardHeader = targetCard.querySelector('.itinerary-header');
      if (cardHeader) {
        var titleEl = header.querySelector('.add-portal-title');
        var leftInfo = cardHeader.querySelector('.itinerary-header-left');
        if (titleEl && leftInfo) {
          titleEl.textContent = leftInfo.textContent.trim().replace(/\s+/g, ' ');
        }
        var subEl = header.querySelector('.add-portal-subtitle');
        if (subEl) subEl.style.display = 'none';
      }
    }

    if (overlay) overlay.classList.add('add-no-bottom-nav');
    var nav = document.getElementById('add-portal-nav');
    if (nav) nav.classList.remove('add-nav-visible');
    if (overlay) overlay.scrollTop = 0;
  }
}

function add_closePortal() {
  var overlay = document.getElementById('add-portal-overlay');
  var currentEntry = add_navStack.length > 0 ? add_navStack[0] : null;
  var currentSectionId = currentEntry ? currentEntry.sectionId : null;

  if (!overlay || !currentSectionId) return;

  // Closing animation
  overlay.classList.add('add-portal-closing');

  setTimeout(function() {
    // Return section to original parent
    add_returnSection(currentSectionId);

    // Restore all sections in wrapper
    add_restoreAllInWrapper();

    // Clear portal content
    var portalContent = document.getElementById('add-portal-content');
    if (portalContent) portalContent.innerHTML = '';

    // Hide overlay
    overlay.classList.remove('add-portal-open');
    overlay.classList.remove('add-portal-closing');
    overlay.classList.remove('add-no-bottom-nav');

    // Hide bottom nav
    var nav = document.getElementById('add-portal-nav');
    if (nav) nav.classList.remove('add-nav-visible');

    // Restore body scroll
    document.body.style.overflow = '';

    // Collapse expanded day cards
    var expandedCards = document.querySelectorAll('.day-card.add-day-expanded');
    for (var i = 0; i < expandedCards.length; i++) {
      expandedCards[i].classList.remove('add-day-expanded');
    }

    // Reset nav stack
    add_navStack = [];

    // Scroll to top
    window.scrollTo({ top: 0, behavior: 'instant' });
  }, 300);
}

function add_switchPortalSection(sectionId) {
  var currentEntry = add_navStack.length > 0 ? add_navStack[add_navStack.length - 1] : null;
  var currentSectionId = currentEntry ? currentEntry.sectionId : null;

  if (!currentSectionId || sectionId === currentSectionId) return;

  var portalContent = document.getElementById('add-portal-content');
  if (!portalContent) return;

  // Return current section to original parent
  add_returnSection(currentSectionId);

  // Reset stack to new section at L2
  add_navStack = [{level: 2, sectionId: sectionId}];

  // Prepare new section
  var prepared = add_prepareSection(sectionId);
  if (!prepared) return;

  // Clear portal content
  portalContent.innerHTML = '';

  // Build and add portal header
  var header = add_buildPortalHeader(sectionId, 2);
  if (header) {
    portalContent.appendChild(header);
  }

  // Move section into portal
  portalContent.appendChild(prepared);

  // Add fade-in animation
  prepared.classList.add('add-portal-section-enter');
  setTimeout(function() {
    prepared.classList.remove('add-portal-section-enter');
  }, 300);

  // Update nav
  add_updateNav(sectionId);

  // Show bottom nav (switching always goes to L2)
  var overlay = document.getElementById('add-portal-overlay');
  if (overlay) {
    overlay.classList.remove('add-no-bottom-nav');
  }
  var nav = document.getElementById('add-portal-nav');
  if (nav) nav.classList.add('add-nav-visible');

  // Scroll overlay to top
  if (overlay) overlay.scrollTop = 0;

  // Re-trigger fade-in animations
  var fadeEls = prepared.querySelectorAll('.fade-in');
  for (var i = 0; i < fadeEls.length; i++) {
    fadeEls[i].classList.add('visible');
  }

  // Animate temp bars if temperature section
  if (sectionId === 'temperature' && typeof animateTempBars === 'function') {
    setTimeout(animateTempBars, 300);
  }

  // Update checklist progress if checklist section
  if (sectionId === 'checklist' && typeof updateChecklistProgress === 'function') {
    setTimeout(updateChecklistProgress, 100);
  }
}

function add_initPortal() {
  add_checkMobile();

  // Store all parents upfront
  add_storeAllParents();

  // Bind entry card clicks
  var cards = document.querySelectorAll('.add-entry-card');
  for (var i = 0; i < cards.length; i++) {
    cards[i].addEventListener('click', function() {
      var target = this.getAttribute('data-target');
      if (target) add_openPortal(target);
    });
  }

  // Bind bottom nav clicks
  var navItems = document.querySelectorAll('.add-portal-nav-item');
  for (var j = 0; j < navItems.length; j++) {
    navItems[j].addEventListener('click', function() {
      var target = this.getAttribute('data-target');
      if (target) add_switchPortalSection(target);
    });
  }

  // Handle resize: reset portal on desktop
  var resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() {
      var wasMobile = add_isMobileView;
      add_checkMobile();
      if (!add_isMobileView && add_navStack.length > 0) {
        add_closePortal();
      }
    }, 250);
  });
}

// Init on DOMContentLoaded
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', function() {
    add_initPortal();
  });
} else {
  add_initPortal();
}

// ===== V17 Portal View System 结束 =====

</script>

<!-- V4-B2 #8: 灯箱组件 -->
<div id="lightbox" class="lightbox" style="display:none;">
  <div class="lightbox-overlay"></div>
  <div class="lightbox-content">
    <img id="lightbox-img" src="" alt="" data-lightbox="true">
    <div class="lightbox-caption" id="lightbox-caption"></div>
    <div class="lightbox-zoom-hint" id="lbZoomHint">双指缩放 · 单指拖动 · 滚轮缩放</div>
    <div class="lightbox-zoom-level" id="lbZoomLevel">100%</div>
    <button class="lightbox-close" onclick="closeLightbox()">&#10005;</button>
    <button class="lightbox-reset-btn" id="lightbox-reset-btn" onclick="resetLightboxZoom()">↺ 重置</button>
    <button class="lightbox-prev" onclick="navigateLightbox(-1)">&#8249;</button>
    <button class="lightbox-next" onclick="navigateLightbox(1)">&#8250;</button>
  </div>
</div>


<!-- ===== V13 SVG地图tooltip ===== -->
<div class="add-map-tooltip" id="addMapTooltip"></div>

<!-- V16 门户视图系统 -->
<div id="add-portal-overlay" class="add-portal-overlay">
  <div id="add-portal-content" class="add-portal-content">
    <!-- portal header and section content inserted dynamically -->
  </div>
  <div class="add-portal-nav" id="add-portal-nav">
    <button class="add-portal-nav-item" data-target="route">🗺️</button>
    <button class="add-portal-nav-item" data-target="itinerary">📅</button>
    <button class="add-portal-nav-item" data-target="temperature">🌡️</button>
    <button class="add-portal-nav-item" data-target="budget">💰</button>
    <button class="add-portal-nav-item" data-target="drone">🚁</button>
    <button class="add-portal-nav-item" data-target="checklist">✅</button>
    <button class="add-portal-nav-item" data-target="summary">👨‍👩‍👧‍👦</button>
    <button class="add-portal-nav-item" data-target="must-do">✨</button>
  </div>
</div>

<script>
// ========== Must-Do Detail Data ==========
var add_mustDoData = {
  'wumeng-sunrise': {
    title: '乌蒙草原日出',
    emoji: '\ud83c\udf05',
    desc: '海拔2800米的乌蒙大草原，是贵州最壮阔的高山草甸。清晨5:30起床，站在草原最高处，看金色阳光从云海中喷薄而出，群山如黛，天地辽阔。8月的草原温度仅18度左右，是天然的避暑胜地。建议提前一天住在草原上，方便早起观赏。',
    images: [
      { url: 'https://s.coze.cn/image/EhDWB1jXPOA/', alt: '乌蒙草原航拍' }
    ],
    tips: '日出时间约6:00，建议5:30到位；草原昼夜温差大，带厚外套；注意防风防晒'
  },
  'huangguoshu-drone': {
    title: '黄果树航拍',
    emoji: '\ud83d\ude81',
    desc: '黄果树瀑布是亚洲最大的瀑布，落差77.8米，宽101米。从空中俯瞰，瀑布如银河倒挂，水雾弥漫，气势磅礴。用DJI Mini 4 Pro或Air 3S从侧面或后方拍摄，可以捕捉到彩虹与水雾交织的绝美画面。注意景区有禁飞限制，需在允许区域飞行。',
    images: [
      { url: 'https://s.coze.cn/image/sCUTRrQ9aDY/', alt: '黄果树瀑布' }
    ],
    tips: '景区内部分区域禁飞，起飞前查看DJI Fly地图；最佳拍摄时间为上午9-11点，光线柔和'
  },
  'zhijin-cave': {
    title: '织金洞钟乳石',
    emoji: '\ud83d\udc8e',
    desc: '织金洞是中国最美的溶洞之一，被誉为"地下艺术宫殿"。洞内钟乳石千姿百态，在灯光映照下如梦似幻。霸王盔、银雨树等奇观令人叹为观止。洞内恒温14度，即使盛夏也需穿长袖。全程游览约2小时，台阶较多注意脚下。',
    images: [
      { url: 'https://s.coze.cn/image/QYGMyNZbMM8/', alt: '织金洞钟乳石' },
      { url: 'https://s.coze.cn/image/H8fndhZojCU/', alt: '织金洞' },
      { url: 'https://s.coze.cn/image/rIv3BObs7hY/', alt: '织金洞' },
      { url: 'https://s.coze.cn/image/_cwcKr3J-P8/', alt: '织金洞' }
    ],
    video: { bvid: 'BV1pxa5zyEzN', title: '织金洞航拍' },
    tips: '洞内潮湿，地面湿滑，穿防滑鞋；禁止使用闪光灯拍照；全程约2km步行'
  },
  'baichehe-spring': {
    title: '百车河温泉',
    emoji: '\u2668\ufe0f',
    desc: '百车河温泉位于安顺市，是贵州少有的露天天然温泉。夜晚泡在温泉池中，仰望星空，四周群山环抱，是此行最放松的时刻。温泉水富含偏硅酸等矿物质，对皮肤有益。建议安排在行程后半段，让疲惫的身体充分放松。',
    images: [],
    tips: '自备泳衣；晚上泡温泉观星效果最佳；注意水温不宜过高，每次15-20分钟为宜'
  },
  'wanfenglin-fishing': {
    title: '万峰林野钓',
    emoji: '\ud83c\udfa3',
    desc: '万峰林的纳灰河畔，喀斯特峰林倒映在碧绿的河水中，在此处野钓是人生难得的体验。河边绿树成荫，水清鱼跃，孩子们可以在岸边嬉戏，大人悠闲垂钓。纳灰河盛产鲤鱼、鲫鱼，钓到的鱼可以在附近农家乐加工品尝。',
    images: [
      { url: 'https://s.coze.cn/image/dc3Lqd04vW8/', alt: '万峰林峰林田园' }
    ],
    tips: '自备钓具或现场租；注意防晒和防蚊；选择阴凉处更佳；孩子钓鱼需大人陪同'
  },
  'guiyang-night': {
    title: '贵阳夜市',
    emoji: '\ud83c\udf5c',
    desc: '贵阳是西南美食之都，二七路小吃街、青云路夜市、太平路是三大美食聚集地。肠旺面、丝娃娃、恋爱豆腐果、花溪牛肉粉、洋芋粑...每一样都让人欲罢不能。夜市从傍晚持续到凌晨，是感受贵阳烟火气的最佳方式。',
    images: [
      { url: 'https://s.coze.cn/image/rOo4KFFHhLA/', alt: '贵阳美食' },
      { url: 'https://s.coze.cn/image/we3dv8-acJQ/', alt: '贵阳美食' },
      { url: 'https://s.coze.cn/image/XgFP8u-gE20/', alt: '贵阳美食' }
    ],
    tips: '二七路小吃街种类最全；人均30-50元可吃到撑；注意肠胃，不要一次吃太多'
  },
  'wanfenglin-riding': {
    title: '万峰林骑行',
    emoji: '\ud83d\udcf8',
    desc: '租一辆电动车或自行车，穿行在万峰林的八卦田间，两侧是连绵的喀斯特峰林，脚下是金黄的稻田。这条骑行路线约10公里，沿途经过纳灰村、万福山等景点，是体验万峰林田园风光的最佳方式。骑行途中随时可以停下来拍照。',
    images: [
      { url: 'https://s.coze.cn/image/dc3Lqd04vW8/', alt: '万峰林田园风光' }
    ],
    tips: '电动车租金约30-50元/天；建议上午骑行，光线好且不太热；注意田间小路较窄，慢行'
  },
  'grassland-stars': {
    title: '草原星空',
    emoji: '\ud83c\udf0c',
    desc: '乌蒙大草原海拔2800米，远离城市光污染，是贵州最佳的观星地点之一。夏季银河清晰可见，繁星如钻石般洒满夜空。带上三脚架和相机，可以拍摄到壮丽的星轨照片。如果运气好，还能看到流星划过天际。',
    images: [],
    tips: '最佳观星时间22:00-凌晨2:00；带厚外套和防潮垫；手机可下载星图APP辨认星座；注意保暖防虫'
  }
};

function add_openMustDoModal(dataId) {
  var data = add_mustDoData[dataId];
  if (!data) return;
  document.getElementById('mdm-emoji').textContent = data.emoji;
  document.getElementById('mdm-title').textContent = data.title;
  document.getElementById('mdm-desc').textContent = data.desc;

  var imgContainer = document.getElementById('mdm-images');
  imgContainer.innerHTML = '';
  if (data.images && data.images.length > 0) {
    for (var i = 0; i < data.images.length; i++) {
      var img = document.createElement('img');
      img.src = data.images[i].url;
      img.alt = data.images[i].alt;
      img.loading = 'lazy';
      (function(src, alt) {
        img.onclick = function() { openV9Lightbox({ src: src, alt: alt }); };
      })(data.images[i].url, data.images[i].alt);
      imgContainer.appendChild(img);
    }
  }

  var vidContainer = document.getElementById('mdm-video');
  vidContainer.innerHTML = '';
  if (data.video) {
    var iframe = document.createElement('iframe');
    iframe.src = 'https://player.bilibili.com/player.html?bvid=' + data.video.bvid + '&high_quality=1&danmaku=0';
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('loading', 'lazy');
    iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-popups');
    vidContainer.appendChild(iframe);
    var link = document.createElement('a');
    link.href = 'https://www.bilibili.com/video/' + data.video.bvid + '/';
    link.target = '_blank';
    link.rel = 'noopener';
    link.textContent = '▶ B站观看 - ' + data.video.title;
    vidContainer.appendChild(link);
  }

  var tipsEl = document.getElementById('mdm-tips');
  if (data.tips) {
    tipsEl.textContent = data.tips;
    tipsEl.style.display = '';
  } else {
    tipsEl.style.display = 'none';
  }

  document.getElementById('must-do-modal').style.display = 'flex';
}

function add_closeMustDoModal() {
  var modal = document.getElementById('must-do-modal');
  modal.style.display = 'none';
  var iframe = modal.querySelector('iframe');
  if (iframe) { iframe.src = ''; }
}

(function() {
  var overlay = document.querySelector('.must-do-modal-overlay');
  if (overlay) {
    overlay.addEventListener('click', function() { add_closeMustDoModal(); });
  }
})();

(function() {
  var cards = document.querySelectorAll('.must-do-card');
  for (var i = 0; i < cards.length; i++) {
    cards[i].style.cursor = 'pointer';
    (function(card) {
      card.addEventListener('click', function() {
        var id = card.getAttribute('data-id');
        if (id) add_openMustDoModal(id);
      });
    })(cards[i]);
  }
})();
</script>

</body>
</html>
