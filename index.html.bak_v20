<!-- 骨架屏兜底：独立脚本，确保即使主脚本崩溃也能隐藏骨架屏 -->
<script>
setTimeout(function() {
  var sk = document.getElementById('skeleton');
  if (sk && !sk.classList.contains('fade-out')) {
    sk.style.transition = 'opacity 0.6s ease';
    sk.style.opacity = '0';
    sk.style.pointerEvents = 'none';
    setTimeout(function() { sk.style.display = 'none'; }, 700);
  }
}, 2000); // V10: 3000ms → 2000ms 加速骨架屏消失
</script>

<script>

// ============================================================
// 文字逐字弹入
// ============================================================
(function() {
  var titles = document.querySelectorAll('.section-title');
  titles.forEach(function(title) {
    var text = title.textContent;
    title.innerHTML = '';
    title.classList.add('char-animate');
    text.split('').forEach(function(char) {
      var span = document.createElement('span');
      span.textContent = char;
      title.appendChild(span);
    });
  });
})();

// ============================================================
// 滚动动画（fade-in 可重复触发）
// ============================================================
var tempAnimated = false;

function animateTempBars() {
  if (tempAnimated) return;
  tempAnimated = true;
  var bars = document.querySelectorAll('.temp-bar');
  bars.forEach(function(bar, i) {
    var val = parseInt(bar.dataset.val);
    var height = (val / 28) * 100;
    bar.style.height = '0%';
    setTimeout(function() {
      bar.classList.add('visible');
      bar.style.height = height + '%';
    }, 100 + i * 100);
  });
}

(function() {
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');

        // 温度图特殊处理
        if (entry.target.querySelector && entry.target.querySelector('#tempBarsUpgraded')) {
          var fills = entry.target.querySelectorAll('.temp-fill');
          fills.forEach(function(fill) {
            var w = fill.style.getPropertyValue('--target-width');
            if (w) fill.style.width = w;
          });
        }

        // 文字逐字弹入延迟
        var header = entry.target.classList.contains('section-header') ? entry.target : entry.target.querySelector && entry.target.querySelector('.section-header');
        if (header) {
          var titleSpans = header.querySelectorAll('.section-title span');
          titleSpans.forEach(function(span, i) {
            span.style.transitionDelay = (i * 0.05) + 's';
          });
        }
      } else if (window.innerWidth > 768) { // V10: 手机端不移除 visible
        entry.target.classList.remove('visible');
      }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('.fade-in, .section-header').forEach(function(el) {
    observer.observe(el);
  });
})();

// ============================================================
// 阅读进度条
// ============================================================
(function() {
  var progressBar = document.getElementById('reading-progress');
  if (!progressBar) return;

  function updateProgress() {
    var scrollTop = window.scrollY;
    var docHeight = document.documentElement.scrollHeight - window.innerHeight;
    var progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    progressBar.style.width = progress + '%';
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
})();

// ============================================================
// 滚动视差背景切换
// ============================================================
(function() {
  if (window.innerWidth <= 768) return; // V10: 手机端跳过视差
  var bgLayers = document.querySelectorAll('.bg-layer');
  var sections = document.querySelectorAll('section[id]');
  var sectionBgMap = {
    'hero': 'hero',
    'route': 'route',
    'itinerary': 'itinerary',
    'temperature': 'temperature',
    'budget': 'budget',
    'drone': 'drone',
    'checklist': 'checklist',
    'summary': 'summary',
    'tips': 'summary'
  };

  function updateBg() {
    var current = 'hero';
    var scrollPos = window.scrollY + window.innerHeight * 0.4;

    sections.forEach(function(section) {
      if (scrollPos >= section.offsetTop) {
        var id = section.getAttribute('id');
        if (sectionBgMap[id]) {
          current = sectionBgMap[id];
        }
      }
    });

    bgLayers.forEach(function(layer) {
      if (layer.dataset.section === current) {
        layer.classList.add('active');
      } else {
        layer.classList.remove('active');
      }
    });
  }

  // 初始激活 hero 背景
  var heroBg = document.querySelector('.bg-layer[data-section="hero"]');
  if (heroBg) heroBg.classList.add('active');

  window.addEventListener('scroll', updateBg, { passive: true });
  updateBg();

  // V4: 多层视差深度
  var parallaxTicking = false;
  function updateParallax() {
    var scrollY = window.scrollY;
    document.querySelectorAll('.bg-layer').forEach(function(layer) {
      var speed = parseFloat(layer.dataset.speed || '0.3');
      layer.style.transform = 'translateY(' + (scrollY * speed) + 'px) scale(1.0)';
    });
    parallaxTicking = false;
  }
  window.addEventListener('scroll', function() {
    if (!parallaxTicking) {
      requestAnimationFrame(updateParallax);
      parallaxTicking = true;
    }
  }, { passive: true });
  updateParallax();
})();

// ============================================================
// 底部悬浮导航 + 导航高亮
// ============================================================
(function() {
  var floatingNav = document.getElementById('floatingNav');
  var sections = document.querySelectorAll('section[id]');
  var fnItems = document.querySelectorAll('.fn-item');
  var lastScrollY = 0;
  var ticking = false;

  function updateNav() {
    var scrollY = window.scrollY;

    // 悬浮导航显隐
    if (scrollY > 300 && scrollY < document.documentElement.scrollHeight - window.innerHeight - 100) {
      floatingNav.classList.remove('hidden');
    } else if (scrollY <= 300) {
      floatingNav.classList.add('hidden');
    }

    // 导航高亮
    var current = '';
    sections.forEach(function(section) {
      var sectionTop = section.offsetTop - 20;
      if (scrollY >= sectionTop) {
        current = section.getAttribute('id');
      }
    });
    fnItems.forEach(function(item) {
      item.classList.remove('active');
      if (item.dataset.target === current) {
        item.classList.add('active');
      }
    });

    lastScrollY = scrollY;
    ticking = false;
  }

  window.addEventListener('scroll', function() {
    if (!ticking) {
      requestAnimationFrame(updateNav);
      ticking = true;
    }
  }, { passive: true });

  updateNav();

  // 悬浮导航点击
  fnItems.forEach(function(item) {
    item.addEventListener('click', function(e) {
      e.preventDefault();
      vibrate(10);
      var target = document.getElementById(this.dataset.target);
      if (target) {
        window.scrollTo({ top: target.offsetTop - 20, behavior: 'smooth' });
      }
    });
  });
})();



// ============================================================
// 倒计时
// ============================================================
function updateCountdown() {
  var target = new Date('2026-08-08T08:00:00+08:00').getTime();
  var now = new Date().getTime();
  var diff = target - now;

  var cdDays = document.getElementById('cd-days');
  var cdHours = document.getElementById('cd-hours');
  var cdMins = document.getElementById('cd-mins');
  var cdSecs = document.getElementById('cd-secs');
  if (!cdDays) return;

  if (diff <= 0) {
    cdDays.textContent = '0';
    cdHours.textContent = '00';
    cdMins.textContent = '00';
    cdSecs.textContent = '00';
    var label = document.querySelector('.countdown-label');
    if (label) label.textContent = '🎉 已经出发啦！祝旅途愉快！';
    return;
  }

  var days = Math.floor(diff / (1000 * 60 * 60 * 24));
  var hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
  var mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
  var secs = Math.floor((diff % (1000 * 60)) / 1000);

  cdDays.textContent = days;
  cdHours.textContent = String(hours).padStart(2, '0');
  cdMins.textContent = String(mins).padStart(2, '0');
  cdSecs.textContent = String(secs).padStart(2, '0');
}

updateCountdown();
setInterval(updateCountdown, 1000);

// ============================================================
// 行程卡片展开/收起
// ============================================================
function toggleCard(header) {
  var card = header.parentElement;
  card.classList.toggle('open');
  vibrate(12);
}

// 默认展开第一天
document.addEventListener('DOMContentLoaded', function() {
  var firstCard = document.querySelector('.itinerary-card');
  if (firstCard) firstCard.classList.add('open');
});

// ============================================================
// a) 数字滚动动画（老虎机效果）—— 必须在预算IIFE之前声明
// ============================================================
var budgetAnimFrames = {};
function animateBudgetNumber(el, targetVal) {
  if (!el) return;
  var key = el.id || el.className || 'unknown';
  var currentVal = 0;
  var m = (el.textContent || '').match(/[\d,]+/);
  if (m) currentVal = parseInt(m[0].replace(/,/g, '')) || 0;
  if (currentVal === targetVal) {
    el.textContent = '\u00a5' + targetVal.toLocaleString();
    return;
  }
  if (budgetAnimFrames[key]) cancelAnimationFrame(budgetAnimFrames[key]);
  el.classList.add('v3-rolling');
  var duration = 400;
  var startTime = performance.now();
  function tick(now) {
    var elapsed = now - startTime;
    var progress = Math.min(elapsed / duration, 1);
    var eased = 1 - Math.pow(1 - progress, 3);
    var val = Math.round(currentVal + (targetVal - currentVal) * eased);
    el.textContent = '\u00a5' + val.toLocaleString();
    if (progress < 1) {
      budgetAnimFrames[key] = requestAnimationFrame(tick);
    } else {
      el.textContent = '\u00a5' + targetVal.toLocaleString();
      el.classList.remove('v3-rolling');
      delete budgetAnimFrames[key];
    }
  }
  budgetAnimFrames[key] = requestAnimationFrame(tick);
}

// ============================================================
// 预算计算器
// ============================================================
(function() {
  var budgetInputs = {
    fuel: document.getElementById('budget-fuel'),
    hotel: document.getElementById('budget-hotel'),
    tickets: document.getElementById('budget-tickets'),
    food: document.getElementById('budget-food')
  };

  var budgetVals = {
    fuel: document.getElementById('fuel-val'),
    hotel: document.getElementById('hotel-val'),
    tickets: document.getElementById('tickets-val'),
    food: document.getElementById('food-val')
  };

  var budgetColors = {
    fuel: '#ff6b35',
    hotel: '#00d4aa',
    tickets: '#4ee0c0',
    food: '#ffaa55'
  };

  var budgetLabels = {
    fuel: '⛽ 油费',
    hotel: '🏨 住宿',
    tickets: '🎟️ 门票',
    food: '🍴 餐饮'
  };

  var BUDGET_MIN = 4000;
  var BUDGET_MAX = 10000;
  var GREEN_MIN = 6000;
  var GREEN_MAX = 8000;

  function updateBudget() {
    var fuel = parseInt(budgetInputs.fuel.value);
    var hotel = parseInt(budgetInputs.hotel.value);
    var tickets = parseInt(budgetInputs.tickets.value);
    var food = parseInt(budgetInputs.food.value);
    var total = fuel + hotel + tickets + food;

    animateBudgetNumber(budgetVals.fuel, fuel);
    animateBudgetNumber(budgetVals.hotel, hotel);
    animateBudgetNumber(budgetVals.tickets, tickets);
    animateBudgetNumber(budgetVals.food, food);

    animateBudgetNumber(document.getElementById('budget-total'), total);
    animateBudgetNumber(document.getElementById('budget-per-person'), Math.round(total / 6));

    // 进度条
    var progressPercent = Math.min(100, ((total - BUDGET_MIN) / (BUDGET_MAX - BUDGET_MIN)) * 100);
    var progressFill = document.getElementById('budget-progress-fill');
    progressFill.style.width = Math.max(0, progressPercent) + '%';

    var color;
    if (total >= GREEN_MIN && total <= GREEN_MAX) {
      color = 'linear-gradient(90deg, #00d4aa, #4ee0c0)';
    } else if (total < GREEN_MIN) {
      color = 'linear-gradient(90deg, #4ee0c0, #00d4aa)';
    } else {
      color = 'linear-gradient(90deg, #ff6b35, #ff4444)';
    }
    progressFill.style.background = color;

    // 占比条
    var breakdown = document.getElementById('budget-breakdown');
    breakdown.innerHTML = '';
    var items = [
      { key: 'fuel', val: fuel },
      { key: 'hotel', val: hotel },
      { key: 'tickets', val: tickets },
      { key: 'food', val: food }
    ];

    items.forEach(function(item) {
      var percent = (item.val / total * 100).toFixed(1);
      var div = document.createElement('div');
      div.className = 'breakdown-bar';
      div.innerHTML =
        '<span class="breakdown-bar-label">' + budgetLabels[item.key] + '</span>' +
        '<div class="breakdown-bar-track">' +
        '<div class="breakdown-bar-fill" style="width: ' + percent + '%; background: ' + budgetColors[item.key] + ';"></div>' +
        '</div>' +
        '<span class="breakdown-bar-value">' + percent + '%</span>';
      breakdown.appendChild(div);
    });
  }

  Object.keys(budgetInputs).forEach(function(key) {
    if (budgetInputs[key]) {
      budgetInputs[key].addEventListener('input', updateBudget);
    }
  });

  if (budgetInputs.fuel) updateBudget();
})();

// ============================================================
// 行前清单
// ============================================================
function toggleChecklist(item) {
  item.classList.toggle('checked');
  vibrate(10);
  updateChecklistProgress();
}

function updateChecklistProgress() {
  var items = document.querySelectorAll('.checklist-item');
  var checked = document.querySelectorAll('.checklist-item.checked');
  var total = items.length;
  var done = checked.length;
  var percent = total > 0 ? (done / total * 100) : 0;

  var fill = document.getElementById('checklistFill');
  var doneEl = document.getElementById('checklistDone');
  var totalEl = document.getElementById('checklistTotal');
  if (fill) fill.style.width = percent + '%';
  if (doneEl) doneEl.textContent = done;
  if (totalEl) totalEl.textContent = total;
}

// ============================================================
// 平滑滚动
// ============================================================
document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {
  anchor.addEventListener('click', function(e) {
    var href = this.getAttribute('href');
    if (href === '#') return;
    var target = document.querySelector(href);
    if (target) {
      e.preventDefault();
      vibrate(10);
      window.scrollTo({
        top: target.offsetTop - 20,
        behavior: 'smooth'
      });
    }
  });
});


// ============================================================
// V3 新增交互效果
// ============================================================

// b) 卡片3D流入动画
(function() {
  var cards = document.querySelectorAll('.itinerary-card');
  cards.forEach(function(card) {
    card.classList.add('v3-slide-in');
  });
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('v3-visible');
      }
    });
  }, { threshold: 0.1 });
  cards.forEach(function(card) { observer.observe(card); });
})();

// c) 时间线生长动画
(function() {
  var timeline = document.querySelector('.route-overview');
  if (!timeline) return;
  timeline.classList.add('v3-timeline');
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        timeline.classList.add('v3-grown');
      }
    });
  }, { threshold: 0.15 });
  observer.observe(timeline);
})();

// d) 温度卡片3D翻转
(function() {
  var groups = document.querySelectorAll('.temp-bar-group');
  var climateInfo = {
    '贵阳': '海拔1100m\n均温24℃\n紫外线强需防晒\n省会配套完善',
    '安顺': '海拔1300m\n均温23-26℃\n瀑布水汽大\n备一次性雨衣',
    '六盘水': '海拔1400m\n均温仅19℃\n"中国凉都"\n需备薄外套',
    '乌蒙草原': '海拔2857m\n均温14-20℃\n昼夜温差大\n需防风外套',
    '兴义': '海拔1200m\n均温22-25℃\n万峰林宜人\n适合骑行'
  };
  groups.forEach(function(group) {
    // 识别城市名
    var label = group.querySelector('.temp-bar-label');
    var cityName = '';
    if (label) {
      var labelText = label.textContent || '';
      for (var name in climateInfo) {
        if (labelText.indexOf(name) >= 0) { cityName = name; break; }
      }
    }
    // 创建翻转结构
    var inner = document.createElement('div');
    inner.className = 'temp-flip-inner';
    var front = document.createElement('div');
    front.className = 'temp-flip-front';
    while (group.firstChild) front.appendChild(group.firstChild);
    var back = document.createElement('div');
    back.className = 'temp-flip-back';
    var desc = document.createElement('div');
    desc.className = 'temp-climate-desc';
    desc.textContent = climateInfo[cityName] || '气候宜人';
    back.appendChild(desc);
    var hint = document.createElement('div');
    hint.className = 'temp-flip-hint';
    hint.textContent = '📍 ' + cityName;
    back.appendChild(hint);
    inner.appendChild(front);
    inner.appendChild(back);
    group.appendChild(inner);
    // 点击翻转（移动端友好）
    group.addEventListener('click', function(e) {
      e.stopPropagation();
      this.classList.toggle('v3-flipped');
      vibrate(8);
    });
  });
})();

// e) 行前清单勾选庆祝粒子
(function() {
  var origToggle = window.toggleChecklist;
  window.toggleChecklist = function(item) {
    var wasChecked = item.classList.contains('checked');
    // 调用原始函数
    if (origToggle) origToggle(item);
    // 仅在勾选时（非取消勾选）发射粒子
    if (!wasChecked && item.classList.contains('checked')) {
      var checkbox = item.querySelector('.checklist-checkbox');
      if (checkbox) {
        var rect = checkbox.getBoundingClientRect();
        spawnChecklistStars(rect.left + rect.width / 2, rect.top + rect.height / 2);
      }
    }
  };
  function spawnChecklistStars(x, y) {
    var stars = ['✨', '⭐', '🌟', '💫', '🎉'];
    var count = 6;
    for (var i = 0; i < count; i++) {
      var star = document.createElement('div');
      star.className = 'checklist-star';
      star.textContent = stars[Math.floor(Math.random() * stars.length)];
      star.style.left = x + 'px';
      star.style.top = y + 'px';
      var angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.5;
      var dist = 40 + Math.random() * 30;
      star.style.setProperty('--tx', Math.cos(angle) * dist + 'px');
      star.style.setProperty('--ty', Math.sin(angle) * dist - 20 + 'px');
      document.body.appendChild(star);
      (function(s) {
        setTimeout(function() { if (s.parentNode) s.parentNode.removeChild(s); }, 800);
      })(star);
    }
  }
})();

